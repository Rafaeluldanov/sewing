# ---------------------------------------------------------------------------
# MVP 1.1 — переменные окружения для web/api/db.
#
# Домены проекта:
#   - UI production:  https://prod.teeon.ru
#   - API production: https://api.prod.teeon.ru
#   - stage:          https://stage.teeon.ru
#
# В коде (web/api) не должно быть хардкода `localhost` и `*.teeon.ru` —
# всё читается через `lib/config.ts` (web) и `packages/shared/src/config.ts`.
# ---------------------------------------------------------------------------

# --- PostgreSQL --------------------------------------------------------------
# ОБЯЗАТЕЛЬНО. Основная БД для миграций Prisma (`npm run prisma:migrate`)
# и seed-скрипта (`npm run db:seed`, `prisma/seed.ts`). Если переменная
# не задана, обе команды падают с:
#   Environment variable not found: DATABASE_URL
# Перед запуском убедитесь, что:
#   1. Файл `.env` существует в корне репозитория (`cp .env.example .env`).
#   2. Указанный PostgreSQL поднят и принимает подключения.
DATABASE_URL="postgresql://sewing:sewing@localhost:5432/sewing?schema=public"

# Отдельная БД для интеграционных тестов (см. `tests/`). Если переменная
# не задана, integration-тесты автоматически пропускаются (skip), unit-
# тесты на shared-логику работают без БД.
# TEST_DATABASE_URL="postgresql://sewing:sewing@localhost:5432/sewing_test?schema=public"

# --- API ---------------------------------------------------------------------
API_PORT=3001

# Подпись session-cookie (HMAC-SHA256). На prod ОБЯЗАТЕЛЬНО переопределить
# случайной строкой ≥ 32 байт. См. ADR-0014.
JWT_SECRET="change-me-in-prod"
# Срок жизни сессии. Поддерживаются суффиксы s/m/h/d. По умолчанию 12 часов.
JWT_EXPIRES_IN="12h"

# Дополнительные origin-ы для CORS (через запятую). APP_URL и
# NEXT_PUBLIC_APP_URL уже добавляются автоматически. На prod чаще всего
# не нужно — но удобно для смешанных stage/dev сценариев.
# CORS_ALLOWED_ORIGINS="https://stage.teeon.ru,https://prod.teeon.ru"

# --- Web → API ---------------------------------------------------------------
# Значения по умолчанию ниже — для локальной разработки (dev).
#
# ВНИМАНИЕ: три разных базовых URL, не смешивать!
#
# INTERNAL_API_URL   — server-side базовый URL API (RSC, server actions).
#                      Должен указывать на backend изнутри того же хоста
#                      (loopback или service-имя), чтобы SSR не уходил
#                      через публичный домен и не падал с ENOTFOUND.
#                      ТОЛЬКО для Next.js server-side fetch.
# NEXT_PUBLIC_API_URL — public URL API для браузера. Доступен на клиенте.
# PUBLIC_API_URL     — public URL API, по которому backend строит
#                      абсолютные ссылки для ВНЕШНИХ consumer-ов
#                      (`PrintJob.payloadUrl` для Windows-агента, и т.п.).
#                      Сюда нельзя 127.0.0.1/localhost — иначе агент
#                      получит URL своего собственного Windows-хоста
#                      и упадёт с `fetch failed`. Если не задан —
#                      fallback на APP_URL + /api.
#
# Для stage (см. `docs/deploy-stage.md`) на сервере stage.teeon.ru
# переопределить:
#   INTERNAL_API_URL="http://127.0.0.1:3001/api"
#   NEXT_PUBLIC_API_URL="https://stage.teeon.ru/api"
#   PUBLIC_API_URL="https://stage.teeon.ru/api"
#   APP_URL="https://stage.teeon.ru"
#   NEXT_PUBLIC_APP_URL="https://stage.teeon.ru"
# В проде: NEXT_PUBLIC_API_URL=https://api.prod.teeon.ru/api
INTERNAL_API_URL="http://127.0.0.1:3001/api"
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
# В dev можно не задавать PUBLIC_API_URL — fallback на APP_URL + /api
# подставит http://localhost:3000/api, чего достаточно для ручных
# проверок без Windows-агента. На stage/prod — ОБЯЗАТЕЛЬНО задать
# публичный адрес API.
# PUBLIC_API_URL="https://stage.teeon.ru/api"

# Публичный URL web-приложения. Используется:
#   - API: для CORS-whitelist и `Domain=.teeon.ru` в session-cookie;
#   - API: как fallback для PUBLIC_API_URL (APP_URL + /api);
#   - Web: для абсолютных ссылок (например, в печатной форме паспорта).
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Storage -----------------------------------------------------------------
STORAGE_DIR="./storage"

# --- Print agent -------------------------------------------------------------
# Опционально. Абсолютный путь к собранному `sewing-print-agent.exe`,
# который отдаётся через `GET /api/printers/agent-download/sewing-print-agent.exe`.
# По умолчанию backend ищет файл в `apps/agent/dist/sewing-print-agent.exe`
# относительно __dirname бандла и process.cwd() — этого хватает и в dev,
# и в standard-раскатке. Переменная нужна, только если CI кладёт exe
# в нестандартное место (например, `/opt/sewing/agent/sewing-print-agent.exe`).
# PRINT_AGENT_PATH="/opt/sewing/agent/sewing-print-agent.exe"
