# ---------------------------------------------------------------------------
# MVP 1.1 — переменные окружения для web/api/db.
#
# Домены проекта:
#   - UI production:  https://prod.teeon.ru
#   - API production: https://api.prod.teeon.ru
#   - stage:          https://stage.teeon.ru
#
# В коде (web/api) не должно быть хардкода `localhost` и `*.teeon.ru` —
# всё читается через `lib/config.ts` (web) и `packages/shared/src/config.ts`.
# ---------------------------------------------------------------------------

# --- PostgreSQL --------------------------------------------------------------
# ОБЯЗАТЕЛЬНО. Основная БД для миграций Prisma (`npm run prisma:migrate`)
# и seed-скрипта (`npm run db:seed`, `prisma/seed.ts`). Если переменная
# не задана, обе команды падают с:
#   Environment variable not found: DATABASE_URL
# Перед запуском убедитесь, что:
#   1. Файл `.env` существует в корне репозитория (`cp .env.example .env`).
#   2. Указанный PostgreSQL поднят и принимает подключения.
DATABASE_URL="postgresql://sewing:sewing@localhost:5432/sewing?schema=public"

# Отдельная БД для интеграционных тестов (см. `tests/`). Если переменная
# не задана, integration-тесты автоматически пропускаются (skip), unit-
# тесты на shared-логику работают без БД.
# TEST_DATABASE_URL="postgresql://sewing:sewing@localhost:5432/sewing_test?schema=public"

# --- Мультитенантность (DB-per-tenant) ---------------------------------------
# Все переменные ниже ОПЦИОНАЛЬНЫ: без них система работает как раньше —
# один дефолтный тенант, его БД = DATABASE_URL (режим single-tenant).
#
# CONTROL_PLANE_DATABASE_URL — БД реестра тенантов (отдельная Prisma-схема
# prisma/control-plane/schema.prisma). ЗАДАНА ⇒ включается control-plane:
# тенант резолвится по Host/x-tenant-host через таблицу TenantDomain, модули
# берутся из TenantModule, неизвестный хост → 404. НЕ задана ⇒ single-tenant
# fallback (поведение Фаз 0/1). Сгенерировать клиент: npm run
# prisma:generate:control-plane; накатить схему: npm run control-plane:push.
# CONTROL_PLANE_DATABASE_URL="postgresql://user:pass@localhost:5432/control_plane?schema=public"
# TTL in-memory кэша резолва Host→тенант (мс).
# TENANT_RESOLVE_CACHE_TTL_MS=30000
# id/slug дефолтного тенанта (single-tenant fallback: ключ кэша клиентов).
# DEFAULT_TENANT_ID=default
# DEFAULT_TENANT_SLUG=default
# Максимум одновременно закэшированных PrismaClient (по одному на тенанта),
# LRU-вытеснение сверх лимита. Следите за max_connections Postgres:
# TENANT_CLIENT_CACHE_MAX × TENANT_CONNECTION_LIMIT не должно его превышать.
# TENANT_CLIENT_CACHE_MAX=25
# Лимит коннектов на один PrismaClient тенанта (добавляется в URL как
# ?connection_limit=...). При росте числа тенантов — PgBouncer.
# TENANT_CONNECTION_LIMIT=5

# --- API ---------------------------------------------------------------------
API_PORT=3001

# --- Prisma auto-sync (Docker entrypoint) ------------------------------------
# Управляет шагом, который запускается ВНУТРИ api-контейнера ДО старта Node:
#   npx prisma db push --schema=prisma/schema.prisma --skip-generate
#
# Зачем: после `docker compose up -d --build` Prisma-client из нового образа
# может знать колонки/таблицы, которых ещё нет в существующем postgres-volume,
# и API падает с `The column ... does not exist in the current database`.
# Скрипт `apps/api/scripts/docker-entrypoint.sh` приводит схему БД к виду
# `prisma/schema.prisma`, после чего стартует node.
#
# Значения:
#   PRISMA_AUTO_SYNC=1 / true / on / yes  → выполнять синхронизацию.
#   PRISMA_AUTO_SYNC=0 / false / off      → пропускать (отключить шаг).
#
# Дефолты заданы в compose-файлах:
#   docker-compose.prod.yml → PRISMA_AUTO_SYNC=1 (включено).
#   docker-compose.dev.yml  → PRISMA_AUTO_SYNC=0 (выключено).
# В .env.dev / .env.prod можно переопределить.
#
# Доп. флаги:
#   PRISMA_AUTO_SYNC_RETRIES=15            попыток переподключения, если
#                                          postgres ещё поднимается.
#   PRISMA_AUTO_SYNC_ACCEPT_DATA_LOSS=0    если 1 — добавляется
#                                          `--accept-data-loss` (нужно при
#                                          деструктивных изменениях схемы).
#
# Примечание: на длинной дистанции правильнее перевести prod на
# `prisma migrate deploy` (история миграций под контролем). `db push`
# здесь — прагматичный выбор, потому что миграции в репо ломаются на
# чистой prod-БД (см. историю `docs/`).
# PRISMA_AUTO_SYNC=1
# PRISMA_AUTO_SYNC_RETRIES=15
# PRISMA_AUTO_SYNC_ACCEPT_DATA_LOSS=0

# Подпись session-cookie (HMAC-SHA256). На prod ОБЯЗАТЕЛЬНО переопределить
# случайной строкой ≥ 32 байт. См. ADR-0014.
JWT_SECRET="change-me-in-prod"
# Срок жизни сессии. Поддерживаются суффиксы s/m/h/d. По умолчанию 12 часов.
JWT_EXPIRES_IN="12h"

# --- Web Push (VAPID) --------------------------------------------------------
# Фоновые уведомления о браке швеям (модуль apps/api/src/modules/push).
# Работают даже при свёрнутом приложении. Сгенерировать пару ключей:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Разные ключи для dev и prod. Без них push-модуль стартует в
# disabled-режиме: подписки сохраняются, отправка молча пропускается.
# VAPID_SUBJECT по умолчанию = APP_URL (можно mailto:you@example.com).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""

# Дополнительные origin-ы для CORS (через запятую). APP_URL и
# NEXT_PUBLIC_APP_URL уже добавляются автоматически. На prod чаще всего
# не нужно — но удобно для смешанных stage/dev сценариев.
# CORS_ALLOWED_ORIGINS="https://stage.teeon.ru,https://prod.teeon.ru"

# --- Web → API ---------------------------------------------------------------
# Значения по умолчанию ниже — для локальной разработки (dev).
#
# ВНИМАНИЕ: три разных базовых URL, не смешивать!
#
# INTERNAL_API_URL   — server-side базовый URL API (RSC, server actions).
#                      Должен указывать на backend изнутри того же хоста
#                      (loopback или service-имя), чтобы SSR не уходил
#                      через публичный домен и не падал с ENOTFOUND.
#                      ТОЛЬКО для Next.js server-side fetch.
# NEXT_PUBLIC_API_URL — public URL API для браузера. Доступен на клиенте.
# PUBLIC_API_URL     — public URL API, по которому backend строит
#                      абсолютные ссылки для ВНЕШНИХ consumer-ов
#                      (`PrintJob.payloadUrl` для Windows-агента, и т.п.).
#                      Сюда нельзя 127.0.0.1/localhost — иначе агент
#                      получит URL своего собственного Windows-хоста
#                      и упадёт с `fetch failed`. Если не задан —
#                      fallback на APP_URL + /api.
#
# Для stage (см. `docs/deploy-stage.md`) на сервере stage.teeon.ru
# переопределить:
#   INTERNAL_API_URL="http://127.0.0.1:3001/api"
#   NEXT_PUBLIC_API_URL="https://stage.teeon.ru/api"
#   PUBLIC_API_URL="https://stage.teeon.ru/api"
#   APP_URL="https://stage.teeon.ru"
#   NEXT_PUBLIC_APP_URL="https://stage.teeon.ru"
# В проде: NEXT_PUBLIC_API_URL=https://api.prod.teeon.ru/api
INTERNAL_API_URL="http://127.0.0.1:3001/api"
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
# В dev можно не задавать PUBLIC_API_URL — fallback на APP_URL + /api
# подставит http://localhost:3000/api, чего достаточно для ручных
# проверок без Windows-агента. На stage/prod — ОБЯЗАТЕЛЬНО задать
# публичный адрес API.
# PUBLIC_API_URL="https://stage.teeon.ru/api"

# Публичный URL web-приложения. Используется:
#   - API: для CORS-whitelist и `Domain=.teeon.ru` в session-cookie;
#   - API: как fallback для PUBLIC_API_URL (APP_URL + /api);
#   - Web: для абсолютных ссылок (например, в печатной форме паспорта).
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Storage -----------------------------------------------------------------
STORAGE_DIR="./storage"

# --- Patterns (Лекала, MVP-1, изолированный модуль) --------------------------
# Каталог локального файлового storage для модуля «Лекала» (превью + DXF).
# Если не задан, по умолчанию используется `apps/api/uploads` относительно
# `process.cwd()`. На stage/prod должен указывать на persisted-том (NFS /
# docker volume), иначе релиз снесёт загрузки.
# PATTERNS_UPLOADS_DIR="/var/lib/sewing/uploads"

# --- Admin navigation feature toggles (RUNTIME, читает API) -------------------
# Гейты пунктов в левом sidebar админки (`apps/web/components/admin-sidebar.tsx`)
# и связанных inline-блоков в карточках заказа / потребности / PO.
#
# ВАЖНО (Фаза 1 мультитенантности): флаги переехали из web-билда
# (`NEXT_PUBLIC_FEATURE_*`, инлайнились на этапе сборки) в РАНТАЙМ API.
# Теперь это server-env API без префикса `NEXT_PUBLIC_`: их читает
# `FeatureModulesService` и отдаёт фронту через `GET /api/auth/me` (поле
# `modules`). Один web-билд обслуживает тенантов с разным набором модулей.
# В Фазе 2 источником станет control-plane (таблица `TenantModule`).
#
# Договор `isModuleEnabledValue` (`packages/shared/src/auth.ts`):
#   - не задана / пустая → модуль ВКЛЮЧЁН (default-on);
#   - "1"/"true"/"on"/"yes"/"enabled" → включён;
#   - "0"/"false"/"off"/"no"/"disabled" → выключен.
# Чтобы спрятать готовый модуль из навигации — поставьте `0`. Backend
# (`/api/patterns`, `/api/workshop-needs`, `/api/suppliers`,
# `/api/purchase-orders`, `/api/purchase-receipts`, `/api/treasury`) остаётся
# доступным под `ADMIN`/`SHOP_MANAGER` в любом случае — флаги гейтят только UI.
FEATURE_PATTERNS=1
FEATURE_WORKSHOP_NEEDS=1
FEATURE_SUPPLIERS=1
FEATURE_PURCHASE_ORDERS=1
FEATURE_PURCHASE_RECEIPTS=1
FEATURE_TREASURY=1
# Сознательная граница MVP по «Заказам поставщикам»: PO — это закупочный
# документ без приёмки и без склада (не создаёт MaterialReceipt, FabricRoll,
# ячейки). Приёмка ведётся отдельным документом Purchase Receipt — фиксация
# факта поступления и места хранения через `PurchaseReceiptLine.cellId`,
# а НЕ складская бухгалтерия (CellContent / MaterialStock / FabricRoll
# этим модулем не создаются).

# --- Print agent -------------------------------------------------------------
# Опционально. Абсолютный путь к собранному `sewing-print-agent.exe`,
# который отдаётся через `GET /api/printers/agent-download/sewing-print-agent.exe`.
# По умолчанию backend ищет файл в `apps/agent/dist/sewing-print-agent.exe`
# относительно __dirname бандла и process.cwd() — этого хватает и в dev,
# и в standard-раскатке. Переменная нужна, только если CI кладёт exe
# в нестандартное место (например, `/opt/sewing/agent/sewing-print-agent.exe`).
# PRINT_AGENT_PATH="/opt/sewing/agent/sewing-print-agent.exe"
