// Prisma schema — швейное производство (MVP)
// Источник истины: docs/domain.md, docs/erd.md, docs/events.md
// Любые изменения здесь должны сопровождаться обновлением документации.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================
// ENUMS
// =========================

enum Role {
  SHOP_MANAGER
  CUTTER
  CUTTER_ASSISTANT
  SEAMSTRESS
  QC
  IRONING
  PACKING
  ADMIN
  // Read-only «экран цеха» для большого монитора в зале (shopfloor display).
  // Аккаунт под этой ролью видит только `/shopfloor/display`, не имеет
  // доступа к мутациям и не используется для расчёта зарплаты/смен.
  DISPLAY
}

enum OperationCategory {
  CUTTING
  SEWING
  QC
  IRONING
  PACKING
}

enum PaymentType {
  SALARY
  PIECEWORK
}

/// Тип компенсации сотрудника (post-Шаг 18 / Шаг 19, см. ADR-0021,
/// `docs/domain.md §9a`).
///
/// Управленческая характеристика, отвечающая на вопрос «как платим
/// этому человеку» в рамках временной окладной модели «день со
/// сменой = отработанный день»:
///
/// - `PIECEWORK` — только сдельщина (раскройщик, швея). Окладные
///   начисления `SalaryEntry` не создаются.
/// - `SALARY` — только оклад (ОТК, ВТО, упаковка, помощник
///   раскройщика). За каждый день, в котором у сотрудника была
///   открыта хотя бы одна `ShiftSession`, создаётся одно начисление
///   `SalaryEntry { employeeId, date, amount = salaryPerShift, source =
///   SHIFT_DAY }`.
/// - `MIXED` — оклад за смену + сохраняется сдельщина (например,
///   универсал, который иногда становится за оверлок). Логика та же,
///   что у `SALARY`, плюс отдельные `OperationEntry` по сдельным
///   операциям.
///
/// Поле `Employee.paymentType` оставлено как есть (источник истины
/// для существующего сдельного pipeline и `EarningsService`). Новое
/// поле `Employee.compensationType` — отдельная управленческая ось,
/// которая на MVP читается только модулем `salary` и блоком
/// «Сотрудники». Совмещение даёт менеджеру переходный период:
/// `PIECEWORK + paymentType=PIECEWORK` — старая сдельщина без оклада;
/// `SALARY + paymentType=SALARY` — старая окладная роль, теперь с
/// настоящим дневным начислением.
enum CompensationType {
  PIECEWORK
  SALARY
  MIXED
}

/// Источник окладного начисления `SalaryEntry`. На MVP используется
/// единственный — «в этот день была хотя бы одна смена». Enum
/// введён сразу, чтобы будущие источники (ручное начисление за
/// субботник, отпускные, премия) встали в ту же таблицу без
/// миграции схемы.
enum SalaryEntrySource {
  SHIFT_DAY
  MANUAL
}

enum OrderStatus {
  DRAFT
  IN_PRODUCTION
  DONE
  CANCELLED
}

enum PassportStatus {
  CREATED
  IN_PROGRESS
  PACKED
  CANCELLED
}

enum PassportEventType {
  CREATED
  OPERATION_STARTED
  OPERATION_FINISHED
  MOVED
  DEFECT_RECORDED
  CELL_PLACED
  CELL_REMOVED
  // Шаг 6: швея «получила крой» — паспорт снят с ячейки и закреплён за
  // сотрудником на активной смене. См. docs/flows.md §F3a.
  ISSUED_TO_EMPLOYEE
  // Шаг 6: скан паспорта на операции (session.operationId). Любое
  // сканирование = переход. См. docs/flows.md §F4.
  OPERATION_SCAN
  // Шаг 7 (role-terminal): ОТК явно подтвердил, что проверка по паспорту
  // выполнена. Не меняет `Passport.status` и не двигает паспорт по
  // pipeline — это аудит-маркер «ОТК прошло». См. docs/flows.md §F5.
  QC_PASSED
  // ВТО role-terminal (см. docs/flows.md §F6): сотрудник ВТО подтвердил,
  // что обработка по паспорту завершена. По аналогии с QC_PASSED это
  // аудит-маркер, не движение по pipeline — `Passport.status` не
  // меняется. Используется для derived-стадии `WTO_DONE` на экране
  // цеха и для свернутой строки в `/wto` после завершения.
  WTO_PASSED
  PACKED
  CANCELLED
}

enum EntryStatus {
  PENDING
  PENDING_RELEASE
  APPROVED
  CANCELLED
  REVERSED
}

/// Способ подтверждения сдельного начисления (Шаг 9, см. ADR-0005).
///
/// - `IMMEDIATE` — раскройщик: начисление сразу APPROVED при выпуске
///   паспорта. Не зависит от дальнейшей судьбы партии.
/// - `AFTER_RELEASE` — пошив: начисление PENDING_RELEASE при переходе на
///   следующую операцию, становится APPROVED только после упаковки.
enum ApprovalMode {
  IMMEDIATE
  AFTER_RELEASE
}

/// Источник, по которому было создано сдельное начисление (Шаг 9).
/// Часть составного ключа идемпотентности
/// `(passportId, operationId, employeeId, sourceEventType)`.
///
/// - `PASSPORT_CREATED` — раскройщик, в транзакции `PassportsService.create`.
/// - `OPERATION_TRANSITION` — пошив, в транзакции
///   `PassportsService.scanOnOperation` для предыдущей операции/исполнителя.
enum EarningSource {
  PASSPORT_CREATED
  OPERATION_TRANSITION
}

/// Тарифный режим операции (управленческая модель ставок,
/// см. `docs/domain.md §16a`, `docs/api.md §15a`).
///
/// - `FIXED` — сдельная операция с одной фиксированной ставкой
///   (`Operation.fixedRate`). Большинство пошивных операций.
/// - `BY_SIZE` — сдельная операция, ставка зависит от размера
///   (`OperationRateBySize`). На MVP это только оверлок-операции,
///   но модель открыта для расширения. `Operation.fixedRate`
///   игнорируется.
/// - `SALARY_ONLY` — операция участвует в pipeline (ОТК, ВТО,
///   упаковка), но сдельная ставка не применяется. Для таких
///   операций `EarningsService` не создаёт `OperationEntry`.
///
/// Источник истины — backend через `OperationsService.resolveRate(...)`,
/// см. `apps/api/src/modules/operations`.
enum PricingMode {
  FIXED
  BY_SIZE
  SALARY_ONLY
}

/// Жизненный цикл заявки на закрытие раскроя по размеру (см. ADR-0018,
/// docs/domain.md §15).
///
/// - `REQUESTED` — заявка подана помощником раскройщика, ждёт мастера;
/// - `APPROVED`  — мастер подтвердил; новые паспорта по этому размеру
///   выпускать запрещено (`backend enforcement` в `PassportsService.create`);
/// - `REJECTED`  — мастер отклонил; раскрой по размеру не закрыт,
///   можно подать новую заявку при необходимости.
enum CuttingClosureRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
}

/// Тип принтера, привязанного к рабочему месту (см. `docs/domain.md §17`).
/// Управленческая характеристика — нужна, чтобы менеджер мог быстро
/// различить «вот этот печатает паспорта, а этот — этикетки коробок».
/// На MVP логика выбора принтера от типа не зависит: реальный поиск
/// идёт по `Printer.equipmentId + isActive`. Тип используется только
/// в UI и для будущего расширения.
enum PrinterType {
  PASSPORT
  QR
  LABEL
  DEFAULT
}

/// Жизненный цикл задания на печать (`docs/domain.md §17`).
///
/// - `PENDING`  — backend создал задание, агент его ещё не забрал;
/// - `PRINTED`  — агент успешно отправил `payloadUrl` на принтер;
/// - `FAILED`   — агент попытался напечатать, но получил ошибку
///   (запоминаем `errorMessage` для UI/диагностики).
///
/// Сознательно простая модель: ретраев и SENT/PROCESSING нет, повторная
/// печать = новый job. Это MVP — см. ADR-0022 (если будет добавлен).
enum PrintJobStatus {
  PENDING
  PRINTED
  FAILED
}

/// Тип источника печати — что именно агент должен забрать по
/// `payloadUrl` (печатная HTML-форма паспорта, QR паспорта,
/// этикетка коробки, QR ячейки). На MVP это просто метка для UI и
/// аудит-журнала: backend знает, какой endpoint подставить в
/// `payloadUrl`, агент работает с `payloadUrl` как с непрозрачным URL.
enum PrintJobSource {
  PASSPORT_QR
  PASSPORT_PRINT
  BOX_LABEL
  CELL_QR
  /// Готовая HTML-этикетка ячейки (`/api/cells/:id/print`) под формат
  /// 38×58 мм (горизонтально, QR слева, номер справа). Используется
  /// при массовой печати «Печать всех ячеек» из карточки склада
  /// (см. `docs/api.md §15`, `docs/screens.md §10b`). Отличается от
  /// CELL_QR тем, что это уже свёрстанная этикетка, а не голый PNG QR.
  CELL_LABEL
  TEST
}

// =========================
// DICTIONARIES
// =========================

model Size {
  id        String   @id @default(cuid())
  code      String   @unique
  sortOrder Int
  createdAt DateTime @default(now())

  passports            Passport[]
  orderItems           OrderItem[]
  cellContents         CellContent[]
  pieceRates           PieceRate[]
  operationRatesBySize OperationRateBySize[]
  closureRequests      CuttingClosureRequest[]
}

model Product {
  id        String   @id @default(cuid())
  name      String
  color     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  passports       Passport[]
  orderItems      OrderItem[]
  pieceRates      PieceRate[]
  closureRequests CuttingClosureRequest[]
}

model Operation {
  id          String            @id @default(cuid())
  code        String            @unique
  name        String
  category    OperationCategory
  sortOrder   Int
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  /// Дата последнего управленческого изменения (тариф, переименование,
  /// смена `pricingMode`). Поставлен `@updatedAt`, чтобы UI
  /// `/admin/operations` мог показывать «когда настраивалось последний
  /// раз». Существующие операции, созданные до миграции, получают
  /// `updatedAt = createdAt` через бэкфилл.
  updatedAt   DateTime          @updatedAt
  /// Тарифный режим операции (см. `PricingMode`). Дефолт
  /// `SALARY_ONLY` — самый безопасный режим: операция участвует в
  /// pipeline, но сдельная ставка не применяется. Все существующие
  /// операции получают корректное значение в миграции на основе
  /// текущих `PieceRate` (см. `prisma/migrations/.../migration.sql`).
  pricingMode PricingMode       @default(SALARY_ONLY)
  /// Фиксированная ставка для `pricingMode = FIXED`. Для `BY_SIZE` и
  /// `SALARY_ONLY` хранится `null` (валидируется в `OperationsService`).
  fixedRate   Decimal?          @db.Decimal(12, 2)

  events              PassportEvent[]       @relation("EventOperation")
  movedFromEvents     PassportEvent[]       @relation("EventFromOperation")
  entries             OperationEntry[]
  pieceRates          PieceRate[]
  ratesBySize         OperationRateBySize[]
  currentPassports    Passport[]            @relation("PassportCurrentOperation")
  shiftSessions       ShiftSession[]
  equipmentOperations EquipmentOperation[]
  routeTemplateSteps  RouteTemplateStep[]
  orderRouteSteps     OrderRouteStep[]

  @@index([sortOrder])
  @@index([category])
  @@index([pricingMode])
}

/// Ставка операции по размеру (для `Operation.pricingMode = BY_SIZE`).
///
/// Источник истины для `OperationsService.resolveRate(...)` и для
/// сдельных начислений `EarningsService`. Заполняется из
/// `/admin/operations/[id]` (роли `ADMIN` / `SHOP_MANAGER`,
/// см. `docs/api.md §15a`, `docs/screens.md §10c`).
///
/// Сознательные ограничения MVP:
///   - один тариф на пару `(operationId, sizeId)`, без истории
///     по датам (на MVP это не нужно — ставки меняются редко);
///   - без привязки к продукту / сотруднику / складу — это
///     управленческая ставка цеха целиком (см. `docs/domain.md §16a`).
///
/// Для `pricingMode = FIXED` строки в этой таблице не создаются;
/// `Operation.fixedRate` хранит единственную ставку. Для
/// `pricingMode = SALARY_ONLY` ставок нет вообще.
model OperationRateBySize {
  id          String   @id @default(cuid())
  operationId String
  sizeId      String
  /// Сдельная ставка за единицу для пары (operation, size). Те же
  /// `Decimal(12,2)`, что и в `OperationEntry.ratePerUnit`/`PieceRate`.
  rate        Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  size      Size      @relation(fields: [sizeId], references: [id])

  @@unique([operationId, sizeId], name: "OperationRateBySize_operation_size_uniq")
  @@index([operationId])
  @@index([sizeId])
}

// =========================
// PEOPLE
// =========================

model Employee {
  id               String           @id @default(cuid())
  fullName         String
  login            String           @unique
  pinHash          String
  role             Role
  /// Историческое поле, отвечающее за сдельный pipeline
  /// (`EarningsService`). Не трогается этой задачей: «оплатная ли
  /// операция для этого человека» до сих пор смотрит сюда (см.
  /// `docs/domain.md §9.2`).
  paymentType      PaymentType
  /// Историческое поле «месячный оклад». На MVP не используется
  /// payroll-движком, оставлено как справочное (см. ADR-0021).
  /// Источник истины для оплаты за смену — `salaryPerShift` ниже.
  salaryBase       Decimal?         @db.Decimal(12, 2)
  /// Управленческая ось «как платим» (см. `CompensationType`,
  /// `docs/domain.md §9a`, ADR-0021). Дефолт `PIECEWORK` —
  /// безопасный: ни одной автоматической окладной записи не
  /// создаётся, пока менеджер не переключит сотрудника в `SALARY`
  /// или `MIXED` через `/admin/employees`.
  compensationType CompensationType @default(PIECEWORK)
  /// Ставка за один отработанный день/смену. Читается модулем
  /// `salary` для `compensationType ∈ { SALARY, MIXED }`. Для
  /// `PIECEWORK` хранится `null` и игнорируется. Валидируется в
  /// `EmployeesService.update` (см. `apps/api/src/modules/employees`).
  salaryPerShift   Decimal?         @db.Decimal(12, 2)
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now())

  shiftSessions    ShiftSession[]
  eventsAsActor    PassportEvent[]  @relation("EventEmployee")
  operationEntries OperationEntry[]
  salaryEntries    SalaryEntry[]
  boxesCreated     Box[]            @relation("BoxCreator")

  passportsAsCurrent Passport[]       @relation("PassportCurrentEmployee")
  passportsAsCutter  Passport[]       @relation("PassportCutter")
  passportsAsCreator Passport[]       @relation("PassportCreator")
  passportDefects    PassportDefect[] @relation("DefectCreator")

  closureRequestsCreated  CuttingClosureRequest[] @relation("ClosureRequestRequester")
  closureRequestsReviewed CuttingClosureRequest[] @relation("ClosureRequestReviewer")
  salaryEntriesEdited     SalaryEntry[]           @relation("SalaryEntryEditor")

  @@index([role])
  @@index([compensationType])
}

model Equipment {
  id            String   @id @default(cuid())
  code          String   @unique
  qrCode        String   @unique
  name          String
  /// Ручной отображаемый порядковый номер станка для физической
  /// маркировки и быстрой визуальной идентификации (см. ADR-0017,
  /// `docs/domain.md §5c`). Печатная этикетка `/api/equipment/:id/print`
  /// показывает его максимально крупно — чтобы швея/начальник цеха
  /// мгновенно различали два соседних оверлока. Уникальность не
  /// требуется глобально (№1 может быть и у оверлока, и у распошива);
  /// валидируется в админ-UI по ситуации.
  displayNumber String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  shiftSessions     ShiftSession[]
  allowedOperations EquipmentOperation[]
  printers          Printer[]
}

/// Связь «оборудование ↔ разрешённая операция» (M2M через явную модель).
///
/// Источник истины для seamstress flow на /work: при старте смены UI
/// показывает только те операции, которые включены здесь для конкретного
/// `Equipment`. Управляется из `/admin/equipment` (роли ADMIN /
/// SHOP_MANAGER). До MVP «equipment-config» этот набор вычислялся на
/// фронте по префиксу `Equipment.code` — теперь это явная конфигурация
/// в БД (см. ADR-0017 и docs/domain.md §5c).
model EquipmentOperation {
  id          String   @id @default(cuid())
  equipmentId String
  operationId String
  /// Порядок отображения операции в списке выбора на /work. Меньше —
  /// выше. Если не задан явно, по умолчанию совпадает с Operation.sortOrder.
  sortOrder   Int      @default(0)
  /// Мягкое отключение: запись остаётся (история), но в /work не
  /// показывается и в API считается «нет». Полная очистка набора через
  /// PATCH удаляет строки физически, поэтому isActive нужен только для
  /// промежуточных состояний управления.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@unique([equipmentId, operationId], name: "EquipmentOperation_equipment_operation_uniq")
  @@index([equipmentId, sortOrder])
  @@index([operationId])
}

model ShiftSession {
  id          String    @id @default(cuid())
  employeeId  String
  equipmentId String
  operationId String
  startedAt   DateTime  @default(now())
  endedAt     DateTime?

  employee  Employee  @relation(fields: [employeeId], references: [id])
  equipment Equipment @relation(fields: [equipmentId], references: [id])
  operation Operation @relation(fields: [operationId], references: [id])

  @@index([employeeId, endedAt])
}

// =========================
// ORDERS
// =========================

model Order {
  id        String      @id @default(cuid())
  number    String      @unique
  customer  String?
  orderDate DateTime
  dueDate   DateTime?
  color     String?
  comment   String?
  status    OrderStatus @default(DRAFT)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  /// Soft-route MVP: опциональная ссылка на шаблон маршрута производства
  /// (см. `RouteTemplate` ниже и `docs/domain.md §«Маршруты»`). На MVP
  /// заполняется при создании/редактировании заказа в DRAFT и фиксируется
  /// в snapshot `OrderRouteStep[]` при первом `OrdersService.start()`.
  /// Поле остаётся `null` для всех старых заказов и для тех, кто
  /// не выбрал шаблон — backward-compatible.
  routeTemplateId String?
  routeTemplate   RouteTemplate? @relation(fields: [routeTemplateId], references: [id])

  items           OrderItem[]
  passports       Passport[]
  closureRequests CuttingClosureRequest[]
  routeSteps      OrderRouteStep[]

  @@index([status])
  @@index([orderDate])
  @@index([createdAt])
  @@index([routeTemplateId])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  sizeId    String
  qtyPlan   Int

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  size    Size    @relation(fields: [sizeId], references: [id])

  @@unique([orderId, productId, sizeId])
  @@index([productId, sizeId])
}

// =========================
// PASSPORT (AGGREGATE ROOT)
// =========================

model Passport {
  id     String @id @default(cuid())
  number String @unique
  qrCode String @unique

  orderId    String
  productId  String
  sizeId     String
  color      String
  rollNumber String
  cutDate    DateTime
  qtyPlan    Int
  qtyCut     Int
  qtyDefect  Int            @default(0)
  qtyGood    Int
  status     PassportStatus @default(CREATED)

  currentOperationId    String?
  currentEmployeeId     String?
  /// Текущая ячейка, в которой физически лежит партия (см. ADR-0010).
  /// Один паспорт = одна текущая ячейка (или null, если ещё не размещён).
  currentCellId         String?
  /// Soft-route MVP: индекс текущего шага в `OrderRouteStep[]` заказа
  /// (0-based). Заполняется в `PassportsService.create`, если у заказа
  /// уже есть snapshot маршрута, и обновляется в `scanOnOperation`,
  /// когда отсканированная операция совпадает с одной из ступеней
  /// маршрута. Никаких enforcement: `null` означает «маршрут не
  /// фиксировался / шаг неизвестен», существующий flow это не ломает.
  currentRouteStepIndex Int?

  cutterId  String
  creatorId String

  pdfUrl    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order            Order      @relation(fields: [orderId], references: [id])
  product          Product    @relation(fields: [productId], references: [id])
  size             Size       @relation(fields: [sizeId], references: [id])
  currentOperation Operation? @relation("PassportCurrentOperation", fields: [currentOperationId], references: [id])
  currentEmployee  Employee?  @relation("PassportCurrentEmployee", fields: [currentEmployeeId], references: [id])
  currentCell      Cell?      @relation("PassportCurrentCell", fields: [currentCellId], references: [id])
  cutter           Employee   @relation("PassportCutter", fields: [cutterId], references: [id])
  creator          Employee   @relation("PassportCreator", fields: [creatorId], references: [id])

  events   PassportEvent[]
  entries  OperationEntry[]
  boxItems BoxItem[]
  defects  PassportDefect[]

  @@index([status, currentOperationId])
  @@index([orderId])
  @@index([sizeId, status])
  @@index([createdAt])
  @@index([currentCellId])
}

// =========================
// EVENTS
// =========================

model PassportEvent {
  id              String            @id @default(cuid())
  passportId      String
  type            PassportEventType
  operationId     String?
  fromOperationId String?
  employeeId      String?
  qty             Int?
  defectQty       Int?
  cellId          String?
  boxId           String?
  payload         Json?
  createdAt       DateTime          @default(now())

  passport      Passport   @relation(fields: [passportId], references: [id])
  operation     Operation? @relation("EventOperation", fields: [operationId], references: [id])
  fromOperation Operation? @relation("EventFromOperation", fields: [fromOperationId], references: [id])
  employee      Employee?  @relation("EventEmployee", fields: [employeeId], references: [id])
  cell          Cell?      @relation(fields: [cellId], references: [id])
  box           Box?       @relation(fields: [boxId], references: [id])

  @@index([passportId, createdAt])
  @@index([type, createdAt])
  @@index([operationId, createdAt])
}

// =========================
// PAYROLL
// =========================

model OperationEntry {
  id              String        @id @default(cuid())
  passportId      String
  operationId     String
  employeeId      String
  qty             Int
  ratePerUnit     Decimal       @db.Decimal(12, 2)
  amount          Decimal       @db.Decimal(12, 2)
  status          EntryStatus   @default(PENDING_RELEASE)
  approvalMode    ApprovalMode  @default(AFTER_RELEASE)
  /// Дискриминатор источника, по которому возникло начисление.
  /// Используется как часть ключа идемпотентности (см. ADR-0012).
  sourceEventType EarningSource @default(OPERATION_TRANSITION)
  /// Опциональная ссылка на «триггер» (`PassportEvent.id` для пошивных
  /// переходов; для immediate-раскроя не используется). Не часть
  /// уникального ключа — нужна только для аудита.
  sourceEventId   String?
  createdAt       DateTime      @default(now())
  approvedAt      DateTime?

  passport  Passport  @relation(fields: [passportId], references: [id])
  operation Operation @relation(fields: [operationId], references: [id])
  employee  Employee  @relation(fields: [employeeId], references: [id])

  /// Идемпотентность сдельных начислений (Шаг 9, ADR-0012):
  /// один и тот же сотрудник не получает второе начисление за ту же
  /// операцию по тому же паспорту в рамках одного и того же источника.
  @@unique([passportId, operationId, employeeId, sourceEventType], name: "OperationEntry_idem")
  @@index([employeeId, status, createdAt])
  @@index([status, createdAt])
  @@index([passportId])
}

/// Окладное начисление за конкретный день для конкретного сотрудника
/// (post-Шаг 18 / Шаг 19, см. ADR-0021, `docs/domain.md §9a`,
/// `docs/erd.md §2.13b`, `docs/api.md §10a`).
///
/// Бизнес-инвариант: «один день — одна окладная запись на человека»
/// (для одного `source`). Закрепляется составным `@@unique` на
/// `(employeeId, date, source)`. На MVP `source = SHIFT_DAY` —
/// единственный путь автогенерации (см. `SalaryService.syncDailyForEmployee`):
///
///   - если у сотрудника `compensationType ∈ { SALARY, MIXED }`,
///   - и в этот день существует хотя бы одна `ShiftSession`
///     (даже не закрытая, даже несколько сессий подряд),
///   - то создаётся (или обновляется по `salaryPerShift`) ровно
///     одна запись с `amount = Employee.salaryPerShift`.
///
/// `editedManually = true` означает, что начальник производства
/// руками поправил сумму (переработка / ушёл раньше / полсмены) и
/// автоматическая sync-логика её больше не затирает: см.
/// `SalaryService.syncDailyForEmployee` ниже.
model SalaryEntry {
  id                 String            @id @default(cuid())
  employeeId         String
  /// Дата без времени (Postgres `DATE`). Нормализуется на сервере к
  /// календарной дате: одна запись на сотрудника на день, независимо
  /// от часового пояса смены и количества смен в этот день.
  date               DateTime          @db.Date
  /// Сумма выплаты за этот день. По умолчанию = `Employee.salaryPerShift`
  /// в момент первой sync; ручная правка через `PATCH
  /// /api/salary/:id` заменяет её и поднимает `editedManually = true`.
  amount             Decimal           @db.Decimal(12, 2)
  source             SalaryEntrySource @default(SHIFT_DAY)
  /// Флаг ручной правки. Sync-логика проверяет его перед тем, как
  /// синхронизировать `amount` со ставкой сотрудника: если стоит
  /// `true`, сумма НЕ перезаписывается. Снимается обратно через
  /// `?reset=true` в PATCH (см. `docs/api.md §10a`).
  editedManually     Boolean           @default(false)
  /// Свободный комментарий начальника производства. Не обязателен,
  /// но помогает отличить «переработку» от «ушёл раньше» в ведомости.
  managerComment     String?           @db.Text
  /// Кто последний правил запись руками. `null` для автогенерируемых
  /// нерасправленных записей. Используется для аудит-подсветки в UI
  /// и как логическая «ответственность» в спорных кейсах.
  editedByEmployeeId String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  employee Employee  @relation(fields: [employeeId], references: [id])
  editedBy Employee? @relation("SalaryEntryEditor", fields: [editedByEmployeeId], references: [id])

  @@unique([employeeId, date, source], name: "SalaryEntry_employee_date_source_uniq")
  @@index([employeeId, date])
  @@index([date])
}

model PieceRate {
  id          String    @id @default(cuid())
  operationId String
  productId   String?
  sizeId      String?
  ratePerUnit Decimal   @db.Decimal(12, 2)
  validFrom   DateTime
  validTo     DateTime?

  operation Operation @relation(fields: [operationId], references: [id])
  product   Product?  @relation(fields: [productId], references: [id])
  size      Size?     @relation(fields: [sizeId], references: [id])

  @@index([operationId, productId, sizeId, validFrom])
}

// =========================
// CELLS (WMS light)
// =========================

/// Склад — управленческая группировка ячеек физического хранения.
/// Введён вместе с экраном `/admin/warehouses` (см. `docs/domain.md §16`,
/// `docs/erd.md §2.13a`, `docs/api.md §15`). Сама модель ячеек и flow
/// размещения паспорта (`POST /api/passports/:id/place`) не меняются —
/// `Cell.warehouseId` опционален и допускает «бесхозные» исторические
/// ячейки, которые менеджер может позже привязать к складу.
model Warehouse {
  id            String   @id @default(cuid())
  /// Человекочитаемое название, видимое в UI (`/admin/warehouses` и
  /// карточка склада). Уникально, чтобы менеджер не путал два склада
  /// с одинаковым именем.
  name          String   @unique
  /// Короткий код склада (например, `MAIN`, `WH-01`). Опционален —
  /// для маленького цеха достаточно имени; вводится менеджером.
  code          String?  @unique
  isActive      Boolean  @default(true)
  /// Шаблон печатной формы наклейки ячеек этого склада. На MVP — просто
  /// строка/JSON, без рендера: бизнес-логика рендера наклеек появится
  /// позже. См. `docs/domain.md §16` (раздел «Линии и наклейки»).
  /// Хранится как `text` (а не jsonb), чтобы менеджер мог положить
  /// произвольный человекочитаемый шаблон без жёсткой схемы.
  labelTemplate String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cells Cell[]
  lines WarehouseLine[]

  @@index([isActive])
}

/// Линия склада — управленческая группировка ячеек по физической полке/ряду
/// (например, линия `A` = ячейки `A1..A20`). Линия принадлежит конкретному
/// складу, но её `code` уникален глобально: оператор сканирует/называет
/// линию без указания склада, и система должна найти её однозначно.
///
/// Связь с `Cell` — one-to-many: линия группирует ячейки, созданные через
/// массовый инструмент `POST /api/warehouses/:id/lines` (см. `docs/api.md §15`).
/// Существующие («бесхозные») ячейки могут быть без линии — `Cell.lineId`
/// nullable, чтобы не ломать миграцию и flow размещения паспорта (ADR-0019).
model WarehouseLine {
  id          String   @id @default(cuid())
  warehouseId String
  /// Глобально уникальный код линии (например, `A`, `B-NORTH`). Уникальность
  /// глобальная, потому что в UI/сканировании линия идентифицируется
  /// одним коротким значением — двух одинаковых не должно быть нигде.
  code        String   @unique
  createdAt   DateTime @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  cells     Cell[]

  @@index([warehouseId])
}

model Cell {
  id          String   @id @default(cuid())
  code        String   @unique
  qrCode      String   @unique
  active      Boolean  @default(true)
  /// Склад-владелец ячейки. Nullable: исторические/нераспределённые
  /// ячейки допустимы, чтобы не ломать существующий flow `place`
  /// (см. ADR-0019 и `docs/domain.md §16`). Менеджер может позже
  /// привязать такую ячейку к конкретному складу через
  /// `PATCH /api/cells/:id`.
  warehouseId String?
  /// Линия склада (если ячейка создана через массовый инструмент линий).
  /// Nullable: исторические/одиночные ячейки могут жить без линии,
  /// flow размещения паспорта это не задевает.
  lineId      String?
  /// Порядковый номер ячейки внутри линии (1..N). Имеет смысл только
  /// вместе с `lineId`. Используется для сортировки и для проверки
  /// инварианта «уникальность пары (lineId, lineIndex)».
  lineIndex   Int?
  createdAt   DateTime @default(now())

  warehouse        Warehouse?      @relation(fields: [warehouseId], references: [id])
  line             WarehouseLine?  @relation(fields: [lineId], references: [id], onDelete: SetNull)
  contents         CellContent[]
  events           PassportEvent[]
  currentPassports Passport[]      @relation("PassportCurrentCell")

  @@unique([lineId, lineIndex], name: "Cell_line_index_uniq")
  @@index([warehouseId])
  @@index([lineId])
}

model CellContent {
  id       String @id @default(cuid())
  cellId   String
  sizeId   String
  quantity Int    @default(0)

  cell Cell @relation(fields: [cellId], references: [id])
  size Size @relation(fields: [sizeId], references: [id])

  @@unique([cellId, sizeId])
}

// =========================
// PACKING
// =========================

model Box {
  id          String    @id @default(cuid())
  number      String    @unique
  qrCode      String    @unique
  totalQty    Int       @default(0)
  maxQty      Int       @default(100)
  closedAt    DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  createdBy Employee        @relation("BoxCreator", fields: [createdById], references: [id])
  items     BoxItem[]
  events    PassportEvent[]

  @@index([closedAt])
}

model BoxItem {
  id         String   @id @default(cuid())
  boxId      String
  passportId String   @unique
  qty        Int
  createdAt  DateTime @default(now())

  box      Box      @relation(fields: [boxId], references: [id])
  passport Passport @relation(fields: [passportId], references: [id])

  @@unique([boxId, passportId])
}

// =========================
// QC / DEFECTS (Шаг 7)
// =========================

/// Справочник видов брака (Шаг 7). См. docs/domain.md §10 и
/// docs/erd.md §2.17. Заполняется через `prisma/seed.ts`
/// (`seedDefectTypes`), идемпотентно по `code`.
model DefectType {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int
  createdAt DateTime @default(now())

  defects PassportDefect[]

  @@index([sortOrder])
}

/// Запись брака по конкретному паспорту (Шаг 7). Один паспорт может
/// иметь несколько записей; на каждую — `PassportEvent(DEFECT_RECORDED)`
/// в той же транзакции. См. docs/flows.md §F5 и docs/api.md §8.
model PassportDefect {
  id                  String   @id @default(cuid())
  passportId          String
  defectTypeId        String
  qty                 Int
  comment             String?
  createdByEmployeeId String?
  createdAt           DateTime @default(now())

  passport          Passport   @relation(fields: [passportId], references: [id])
  defectType        DefectType @relation(fields: [defectTypeId], references: [id])
  createdByEmployee Employee?  @relation("DefectCreator", fields: [createdByEmployeeId], references: [id])

  @@index([passportId, createdAt])
  @@index([defectTypeId, createdAt])
}

// =========================
// CUTTING CLOSURE REQUESTS (управленческое закрытие раскроя по размеру)
// =========================

/// Заявка на закрытие раскроя по конкретной размерной строке заказа
/// (`Order × Product × Size`). Помощник раскройщика подаёт её, когда
/// фактический раскрой по размеру меньше плана и дальше кроить не
/// будут. Мастер цеха подтверждает или отклоняет. Подтверждённая
/// заявка (`status = APPROVED`) запрещает выпуск новых паспортов по
/// этой строке (см. `PassportsService.create`, ADR-0018).
///
/// Уникальность одной активной заявки на строку обеспечивает
/// частичный уникальный индекс
/// `cutting_closure_request_active_uniq` на
/// `(orderId, productId, sizeId)` где `status = 'REQUESTED'`. Он
/// создаётся в миграции и идемпотентно — в `PrismaService.onModuleInit`.
/// Точно так же запрещено иметь два `APPROVED` по одной и той же
/// строке (`cutting_closure_request_approved_uniq`).
model CuttingClosureRequest {
  id                    String                      @id @default(cuid())
  orderId               String
  productId             String
  sizeId                String
  status                CuttingClosureRequestStatus @default(REQUESTED)
  reason                String?
  requestedByEmployeeId String
  requestedAt           DateTime                    @default(now())
  reviewedByEmployeeId  String?
  reviewedAt            DateTime?
  reviewerNote          String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  order               Order     @relation(fields: [orderId], references: [id])
  product             Product   @relation(fields: [productId], references: [id])
  size                Size      @relation(fields: [sizeId], references: [id])
  requestedByEmployee Employee  @relation("ClosureRequestRequester", fields: [requestedByEmployeeId], references: [id])
  reviewedByEmployee  Employee? @relation("ClosureRequestReviewer", fields: [reviewedByEmployeeId], references: [id])

  @@index([orderId, productId, sizeId])
  @@index([status, requestedAt])
}

// =========================
// PRINTERS / PRINT JOBS (MVP, см. docs/domain.md §17)
// =========================

/// Принтер, физически стоящий рядом с рабочим местом и обслуживаемый
/// агентом (см. `apps/agent`). Один принтер привязан максимум к одной
/// единице оборудования (`equipmentId`) — это MVP-инвариант: «по
/// рабочему месту мы знаем, на чём печатать». Несколько принтеров на
/// одно `equipmentId` логически разрешены БД-схемой (FK без unique)
/// и могут понадобиться для расширения «один QR-принтер + один
/// принтер этикеток на одно место», но логика выбора в `PrintJobsService`
/// на MVP берёт первый активный — этого достаточно.
///
/// `pairingCode` — короткий одноразовый код, который менеджер
/// генерирует кнопкой «Сгенерировать код» и сообщает оператору.
/// Агент при первом запуске обменивает его через `POST
/// /api/printers/agent/pair` на постоянный `printerId` и `agentToken`.
/// После сpair-а код можно перегенерировать (например, если
/// компьютер агента сменили) — старые токены остаются валидными,
/// но новый агент получит свежие.
///
/// `agentToken` — секрет, которым агент аутентифицируется на
/// `/api/print-jobs/agent` и `/api/printers/agent/heartbeat`. Хранится
/// открытым: на MVP это нормально (внутренняя сеть цеха), позже можно
/// перейти на хеш + bearer (см. ADR-0014).
///
/// `isOnline` и `lastSeenAt` обновляются на каждом heartbeat-е агента
/// (а также при выдаче job-ов). UI `/admin/printers` рисует «онлайн»
/// если `isOnline` и heartbeat был недавно (<60 сек по UTC).
model Printer {
  id                       String      @id @default(cuid())
  name                     String
  type                     PrinterType @default(DEFAULT)
  equipmentId              String?
  isActive                 Boolean     @default(true)
  /// Короткий одноразовый код подключения (UI кнопка «Сгенерировать
  /// код»). NULL после успешного pair-а — pair его очищает, чтобы
  /// случайно не использовать повторно. Может быть выдан повторно
  /// той же кнопкой.
  pairingCode              String?
  /// Постоянный секрет для агента. Заполняется при `pair`-е.
  agentToken               String?
  isOnline                 Boolean     @default(false)
  lastSeenAt               DateTime?
  /// Hostname Windows-машины, на которой запущен агент (см.
  /// `docs/domain.md §17b «Физический Windows-принтер»`). Заполняется
  /// агентом при старте/heartbeat-е через
  /// `POST /api/printers/agent/windows-printers`. Используется в UI
  /// `/admin/printers/:id`, чтобы менеджер видел «какой именно
  /// компьютер сейчас подключён».
  agentHostName            String?
  /// Список системных принтеров Windows (по `Get-Printer.Name`),
  /// присланный агентом. Хранится как `String[]` — простой и
  /// устойчивый формат: новый список целиком перезаписывает старый
  /// при каждом upload-е (без отдельной таблицы и без диффа).
  /// Пустой массив = «агент пока ничего не прислал».
  availableWindowsPrinters String[]    @default([])
  /// Когда агент в последний раз прислал свой список Windows-принтеров.
  /// Отдельно от `lastSeenAt`, чтобы UI мог показать «список устарел»
  /// без подсчёта.
  windowsPrintersUpdatedAt DateTime?
  /// Имя системного принтера Windows, на который должен печатать
  /// агент. Менеджер выбирает его в UI из `availableWindowsPrinters`.
  /// Если `null` — агент не печатает и помечает job как FAILED с
  /// `WINDOWS_PRINTER_NOT_SELECTED`. Выбор валидируется backend-ом:
  /// должен присутствовать в `availableWindowsPrinters` (см.
  /// `WINDOWS_PRINTER_NOT_FOUND_FOR_AGENT`).
  selectedWindowsPrinter   String?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  equipment Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  jobs      PrintJob[]

  @@index([equipmentId, isActive])
  @@index([isOnline])
  @@index([pairingCode])
  @@index([agentToken])
}

/// Задание на печать (`docs/domain.md §17`). Создаётся, когда
/// сотрудник нажимает «Печать» в системе или менеджер запускает
/// «Тестовая печать» в карточке принтера.
///
/// `payloadUrl` — абсолютный URL, по которому агент скачивает
/// готовый HTML/PNG для печати. Backend подставляет существующие
/// печатные endpoint-ы (`/api/passports/:id/print`,
/// `/api/passports/:id/qr`, `/api/packing/boxes/:id/label`,
/// `/api/cells/:id/qr`) — мы НЕ дублируем рендер, а только
/// отправляем агента туда же, куда раньше открывалась вкладка
/// браузера (см. ADR-0010).
model PrintJob {
  id           String         @id @default(cuid())
  printerId    String
  sourceType   PrintJobSource
  /// Идентификатор объекта-источника (`Passport.id`, `Box.id`,
  /// `Cell.id`). Хранится строкой, чтобы не плодить FK на каждый
  /// тип. Для `TEST` может быть пустым.
  sourceId     String?
  payloadUrl   String
  status       PrintJobStatus @default(PENDING)
  errorMessage String?
  createdAt    DateTime       @default(now())
  /// Когда агент забрал job в работу (PATCH PRINTED/FAILED). Для
  /// PENDING — null. Хранится отдельно от `createdAt`, чтобы UI мог
  /// показать «висит давно» без подсчёта.
  completedAt  DateTime?

  printer Printer @relation(fields: [printerId], references: [id], onDelete: Cascade)

  @@index([printerId, status, createdAt])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Production routes (MVP, soft-route)
//
// «Шаблон маршрута производства» = упорядоченный список операций, по
// которому идёт партия. На MVP это «мягкий» механизм:
//   - менеджер заводит шаблоны в `/admin/routes`;
//   - при создании заказа можно опционально привязать `routeTemplateId`;
//   - при `OrdersService.start()` шаблон фиксируется в snapshot
//     `OrderRouteStep[]` (чтобы заказ был «застывшим» — поздняя правка
//     шаблона не меняет уже запущенные заказы);
//   - паспорт хранит `currentRouteStepIndex` как подсказку для UI;
//   - НИКАКОГО enforcement: при scan-е операции, не входящей в маршрут,
//     /work только покажет warning (не блокирует), индекс не меняется.
//
// См. `docs/domain.md §«Маршруты производства»`.
// ---------------------------------------------------------------------------

model RouteTemplate {
  id        String   @id @default(cuid())
  /// Человекочитаемый код шаблона, уникальный (например, "TSHIRT-BASIC").
  /// Используется в API (`GET /api/routes?code=...`) и в UI.
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps  RouteTemplateStep[]
  orders Order[]

  @@index([isActive])
}

model RouteTemplateStep {
  id          String  @id @default(cuid())
  templateId  String
  /// Позиция шага в маршруте (0-based). Уникальна в рамках шаблона —
  /// см. `@@unique([templateId, index])`.
  index       Int
  operationId String
  /// На MVP не используется в enforcement, но фиксируется в данных,
  /// чтобы потом можно было реализовать «можно пропустить шаг».
  isOptional  Boolean @default(false)

  template  RouteTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  operation Operation     @relation(fields: [operationId], references: [id])

  @@unique([templateId, index])
  @@unique([templateId, operationId])
  @@index([operationId])
}

/// Снимок маршрута, привязанный к заказу. Создаётся в
/// `OrdersService.start()`, если у заказа выставлен `routeTemplateId`.
/// После snapshot-а заказ перестаёт зависеть от того, что менеджер
/// сделает с шаблоном дальше (правка / удаление шагов / деактивация).
model OrderRouteStep {
  id          String @id @default(cuid())
  orderId     String
  index       Int
  operationId String

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  operation Operation @relation(fields: [operationId], references: [id])

  @@unique([orderId, index])
  @@index([orderId])
  @@index([operationId])
}
