// Prisma schema — швейное производство (MVP)
// Источник истины: docs/domain.md, docs/erd.md, docs/events.md
// Любые изменения здесь должны сопровождаться обновлением документации.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================
// ENUMS
// =========================

enum Role {
  SHOP_MANAGER
  CUTTER
  CUTTER_ASSISTANT
  SEAMSTRESS
  QC
  IRONING
  PACKING
  ADMIN
  // Read-only «экран цеха» для большого монитора в зале (shopfloor display).
  // Аккаунт под этой ролью видит только `/shopfloor/display`, не имеет
  // доступа к мутациям и не используется для расчёта зарплаты/смен.
  DISPLAY
  /// Мастер цеха (MVP). Мобильный терминал `/master`: видит очередь
  /// открытых вызовов от рабочих, закрывает вызов сканом QR
  /// сотрудника. На MVP не имеет доступа к admin-справочникам,
  /// ценам, маршрутам, техкартам и пользователям. См.
  /// `docs/domain.md §«Мастер цеха»` и `MasterCall` ниже.
  SHOPFLOOR_MASTER
}

enum OperationCategory {
  CUTTING
  SEWING
  QC
  IRONING
  PACKING
}

/// Тип компенсации сотрудника — единственный источник истины «как
/// платим» (post-Шаг 18 / Шаг 19, см. ADR-0021, `docs/domain.md §9a`).
/// Историческое `Employee.paymentType` удалено — `compensationType`
/// одновременно гейтит и сдельный контур (`EarningsService`), и
/// окладной (`SalaryService`):
///
/// - `PIECEWORK` — только сдельщина (раскройщик, швея). Окладные
///   начисления `SalaryEntry` не создаются.
/// - `SALARY` — только оклад (ОТК, ВТО, упаковка, помощник
///   раскройщика). За каждый день, в котором у сотрудника была
///   открыта хотя бы одна `ShiftSession`, создаётся одно начисление
///   `SalaryEntry { employeeId, date, amount = salaryPerShift, source =
///   SHIFT_DAY }`. Сдельные `OperationEntry` для таких сотрудников
///   `EarningsService` молча пропускает.
/// - `MIXED` — оклад за смену + сохраняется сдельщина (например,
///   универсал, который иногда становится за оверлок). Логика та же,
///   что у `SALARY`, плюс отдельные `OperationEntry` по сдельным
///   операциям.
enum CompensationType {
  PIECEWORK
  SALARY
  MIXED
}

/// Источник окладного начисления `SalaryEntry`. На MVP используется
/// единственный — «в этот день была хотя бы одна смена». Enum
/// введён сразу, чтобы будущие источники (ручное начисление за
/// субботник, отпускные, премия) встали в ту же таблицу без
/// миграции схемы.
enum SalaryEntrySource {
  SHIFT_DAY
  MANUAL
}

/// Жизненный цикл вызова мастера цеха (`MasterCall`, MVP).
///
/// - `OPEN`      — рабочий нажал кнопку «Мастер», вызов в очереди
///                 на `/master`. На один сотрудник одновременно может
///                 быть только один `OPEN` вызов (идемпотентность
///                 кнопки на рабочих экранах);
/// - `RESOLVED`  — мастер закрыл вызов (на MVP — сканом QR сотрудника
///                 на `/master`). Запись `resolvedAt` и `resolvedById`;
/// - `CANCELLED` — зарезервировано для будущих сценариев (отмена
///                 рабочим, авто-протухание и т.п.). На MVP не
///                 используется ни одним продакшен-кодом, оставлен
///                 для расширения без миграции схемы.
enum MasterCallStatus {
  OPEN
  RESOLVED
  CANCELLED
}

/// Жизненный цикл заказа.
///
/// - `DRAFT`         — черновик, план ещё редактируется (источник
///   patternItem / techCard / маршрута / размерной матрицы).
/// - `CALCULATION`   — менеджер перевёл заказ в расчёт. В этот
///   момент система автоматически собрала «Потребность цеха» (см.
///   `apps/api/src/modules/workshop-needs/*`) — закупщик правит
///   `purchaseQty` / поставщиков, ничего из плана уже не меняется.
///   Промежуточный статус между DRAFT и IN_PRODUCTION; на
///   shopfloor / passports не влияет (см. ADR-0006).
/// - `IN_PRODUCTION` — запущен в производство, план иммутабелен.
/// - `DONE`          — завершён (ручной перевод).
/// - `CANCELLED`     — отменён.
///
/// Постгрес-enum: добавление CALCULATION выполнено отдельной
/// миграцией `20260514100000_add_order_status_calculation` через
/// `ALTER TYPE … ADD VALUE`. Старые статусы сохраняют свои
/// порядковые позиции — backward-compatibility прежних snapshot-ов.
enum OrderStatus {
  DRAFT
  CALCULATION
  /// Этап «Себестоимость заказа» (см.
  /// `apps/api/src/modules/orders/orders.service.ts::completeCalculation`,
  /// `prisma/schema.prisma::OrderCostEstimate`).
  ///
  /// Расчёт по заказу завершён: закупщик заполнил `purchaseQty` /
  /// `quotedPrice` / `quotedCurrency` по строкам `WorkshopNeed`,
  /// нажал «Завершить расчёт» — backend зафиксировал
  /// `OrderCostEstimate` (history) и `Order.costEstimateTotalRub`
  /// (snapshot для UI). Из этого статуса можно либо запустить
  /// заказ в производство (`OrdersService.start` принимает
  /// `CALCULATION_DONE` как и `CALCULATION` / `DRAFT`), либо
  /// вернуть его на пересчёт (`reopenCalculation`).
  ///
  /// Postgres enum расширяется только через `ALTER TYPE … ADD VALUE`,
  /// поэтому новое значение лежит в конце — порядковая позиция в БД
  /// больше, чем у `IN_PRODUCTION`/`DONE`/`CANCELLED`. Это нормально:
  /// UI-порядок статусов задаётся явно (см.
  /// `@sewing/shared/orders::ORDER_STATUSES`).
  CALCULATION_DONE
  IN_PRODUCTION
  DONE
  CANCELLED
}

enum PassportStatus {
  CREATED
  IN_PROGRESS
  PACKED
  CANCELLED
}

enum PassportEventType {
  CREATED
  OPERATION_STARTED
  OPERATION_FINISHED
  MOVED
  DEFECT_RECORDED
  CELL_PLACED
  CELL_REMOVED
  // Шаг 6: швея «получила крой» — паспорт снят с ячейки и закреплён за
  // сотрудником на активной смене. См. docs/flows.md §F3a.
  ISSUED_TO_EMPLOYEE
  // Шаг 6: скан паспорта на операции (session.operationId). Любое
  // сканирование = переход. См. docs/flows.md §F4.
  OPERATION_SCAN
  // Шаг 7 (role-terminal): ОТК явно подтвердил, что проверка по паспорту
  // выполнена. Не меняет `Passport.status` и не двигает паспорт по
  // pipeline — это аудит-маркер «ОТК прошло». См. docs/flows.md §F5.
  QC_PASSED
  // ВТО role-terminal (см. docs/flows.md §F6): сотрудник ВТО подтвердил,
  // что обработка по паспорту завершена. По аналогии с QC_PASSED это
  // аудит-маркер, не движение по pipeline — `Passport.status` не
  // меняется. Используется для derived-стадии `WTO_DONE` на экране
  // цеха и для свернутой строки в `/wto` после завершения.
  WTO_PASSED
  PACKED
  CANCELLED
}

enum EntryStatus {
  PENDING
  PENDING_RELEASE
  APPROVED
  CANCELLED
  REVERSED
}

/// Способ подтверждения сдельного начисления (Шаг 9, см. ADR-0005).
///
/// - `IMMEDIATE` — раскройщик: начисление сразу APPROVED при выпуске
///   паспорта. Не зависит от дальнейшей судьбы партии.
/// - `AFTER_RELEASE` — пошив: начисление PENDING_RELEASE при переходе на
///   следующую операцию, становится APPROVED только после упаковки.
enum ApprovalMode {
  IMMEDIATE
  AFTER_RELEASE
}

/// Источник, по которому было создано сдельное начисление (Шаг 9).
/// Часть составного ключа идемпотентности
/// `(passportId, operationId, employeeId, sourceEventType)`.
///
/// - `PASSPORT_CREATED` — раскройщик, в транзакции `PassportsService.create`.
/// - `OPERATION_TRANSITION` — пошив, в транзакции
///   `PassportsService.scanOnOperation` для предыдущей операции/исполнителя.
enum EarningSource {
  PASSPORT_CREATED
  OPERATION_TRANSITION
}

/// Тарифный режим операции (управленческая модель ставок,
/// см. `docs/domain.md §16a`, `docs/api.md §15a`).
///
/// - `FIXED` — сдельная операция с одной фиксированной ставкой
///   (`Operation.fixedRate`). Большинство пошивных операций.
/// - `BY_SIZE` — сдельная операция, ставка зависит от размера
///   (`OperationRateBySize`). На MVP это только оверлок-операции,
///   но модель открыта для расширения. `Operation.fixedRate`
///   игнорируется.
/// - `SALARY_ONLY` — операция участвует в pipeline (ОТК, ВТО,
///   упаковка), но сдельная ставка не применяется. Для таких
///   операций `EarningsService` не создаёт `OperationEntry`.
///
/// Источник истины — backend через `OperationsService.resolveRate(...)`,
/// см. `apps/api/src/modules/operations`.
enum PricingMode {
  FIXED
  BY_SIZE
  SALARY_ONLY
}

/// Жизненный цикл заявки на закрытие раскроя по размеру (см. ADR-0018,
/// docs/domain.md §15).
///
/// - `REQUESTED` — заявка подана помощником раскройщика, ждёт мастера;
/// - `APPROVED`  — мастер подтвердил; новые паспорта по этому размеру
///   выпускать запрещено (`backend enforcement` в `PassportsService.create`);
/// - `REJECTED`  — мастер отклонил; раскрой по размеру не закрыт,
///   можно подать новую заявку при необходимости.
enum CuttingClosureRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
}

/// Тип принтера, привязанного к рабочему месту (см. `docs/domain.md §17`).
/// Управленческая характеристика — нужна, чтобы менеджер мог быстро
/// различить «вот этот печатает паспорта, а этот — этикетки коробок».
/// На MVP логика выбора принтера от типа не зависит: реальный поиск
/// идёт по `Printer.equipmentId + isActive`. Тип используется только
/// в UI и для будущего расширения.
enum PrinterType {
  PASSPORT
  QR
  LABEL
  DEFAULT
}

/// Жизненный цикл задания на печать (`docs/domain.md §17`).
///
/// - `PENDING`  — backend создал задание, агент его ещё не забрал;
/// - `PRINTED`  — агент успешно отправил `payloadUrl` на принтер;
/// - `FAILED`   — агент попытался напечатать, но получил ошибку
///   (запоминаем `errorMessage` для UI/диагностики).
///
/// Сознательно простая модель: ретраев и SENT/PROCESSING нет, повторная
/// печать = новый job. Это MVP — см. ADR-0022 (если будет добавлен).
enum PrintJobStatus {
  PENDING
  PRINTED
  FAILED
}

/// Триггер активации внешней потребности (`TechCardOutsourceLine` /
/// `OrderOutsourceRequirement`). Управленческая ось «когда мы понимаем,
/// что подряд можно отдавать» — на MVP вычисляется на чтении в
/// `OrdersService.getOne()`, в БД статус не пишем (см. ADR-0022).
///
/// - `MANUAL` — обычная внешняя потребность; UI просто показывает её
///   в snapshot заказа без сигнала готовности. Backward-compat
///   значение по умолчанию для всех существующих строк.
/// - `CUT_READY` — потребность считается «готовой к заказу», когда у
///   заказа есть паспорта и **все** они физически размещены в ячейки
///   (`Passport.currentCellId != null`). Критерий ALL_PASSPORTS,
///   ANY_PASSPORTS отложен сознательно.
///
/// Никаких других триггеров (route-step, событийные) пока не
/// заводим — общий trigger-engine отложен. См. ADR-0022 §«Cut-ready
/// readiness (MVP-2)».
enum OutsourceTriggerType {
  MANUAL
  CUT_READY
}

/// Ручной операционный статус выполнения внешней потребности заказа
/// (`OrderOutsourceRequirement.executionStatus`, ADR-0022 §«Manual
/// execution status (MVP-3)»).
///
/// Минимальный, линейный жизненный цикл: менеджер вручную фиксирует
/// «реально отдали подрядчику» и «получили обратно». Никакого
/// procurement-модуля, vendor-master, supplier portal, документов или
/// складского прихода — это лёгкий операционный статус, не закупочный
/// документ.
///
/// - `PLANNED`  — дефолтное состояние, потребность зафиксирована в
///   snapshot заказа, но менеджер ещё не отметил, что её отдали
///   подрядчику. Backward-compat для всех существующих строк.
/// - `ORDERED`  — менеджер отметил, что подряд реально заказан/отдан;
///   `OrderOutsourceRequirement.orderedAt` фиксируется временем
///   перехода (если был пуст).
/// - `RECEIVED` — менеджер отметил, что результат получен;
///   `receivedAt` фиксируется временем перехода. Это терминальный
///   статус — откатов в `PLANNED`/`ORDERED` через action нет.
///
/// Состояние «READY_TO_ORDER» в этот enum **не входит** и в БД не
/// хранится: оно по-прежнему derive at-read в `OrdersService.getOne()`
/// как композиция `executionStatus + triggerType + Passport.currentCellId`
/// (см. ADR-0022).
enum OrderOutsourceExecutionStatus {
  PLANNED
  ORDERED
  RECEIVED
}

/// Тип источника печати — что именно агент должен забрать по
/// `payloadUrl` (печатная HTML-форма паспорта, QR паспорта,
/// этикетка коробки, QR ячейки). На MVP это просто метка для UI и
/// аудит-журнала: backend знает, какой endpoint подставить в
/// `payloadUrl`, агент работает с `payloadUrl` как с непрозрачным URL.
enum PrintJobSource {
  PASSPORT_QR
  PASSPORT_PRINT
  BOX_LABEL
  CELL_QR
  /// Готовая HTML-этикетка ячейки (`/api/cells/:id/print`) под формат
  /// 38×58 мм (горизонтально, QR слева, номер справа). Используется
  /// при массовой печати «Печать всех ячеек» из карточки склада
  /// (см. `docs/api.md §15`, `docs/screens.md §10b`). Отличается от
  /// CELL_QR тем, что это уже свёрстанная этикетка, а не голый PNG QR.
  CELL_LABEL
  TEST
}

/// Жизненный цикл выплаты зарплаты сотруднику (PHASE 3 «PayrollPayout»,
/// см. `docs/erd.md §2.9`, `docs/domain.md §10.7`).
///
/// Отдельная сущность от `OperationEntry` / `SalaryEntry`: эти таблицы
/// остаются «начислениями» (исторически сколько заработал), а
/// `PayrollPayout` фиксирует «факт выплаты» — формирование пакета
/// строк начислений в выплату конкретному сотруднику за период.
///
/// - `DRAFT`        — менеджер собирает выплату, может пересчитывать
///                    набор строк (`PayrollPayoutLine`). Активная
///                    блокировка повторного включения строк
///                    проверяется в сервисе.
/// - `ISSUED`       — менеджер «выдал» выплату: snapshot сумм и строк
///                    зафиксирован, сотрудник видит у себя ожидающее
///                    подтверждение. Из этого состояния доступно
///                    только `ACKNOWLEDGED` или `CANCELLED`.
/// - `ACKNOWLEDGED` — сотрудник подтвердил получение. Терминальный
///                    статус, повторно включать те же строки нельзя.
/// - `CANCELLED`    — выплата отменена менеджером. Терминальный
///                    статус; строки `OperationEntry` / `SalaryEntry`
///                    освобождаются и могут попасть в новую выплату.
enum PayrollPayoutStatus {
  DRAFT
  ISSUED
  ACKNOWLEDGED
  CANCELLED
}

/// Тип строки выплаты `PayrollPayoutLine` — из какой подсистемы
/// начислений (`OperationEntry` / `SalaryEntry`) пришла строка.
/// Дублирует выбор «либо `operationEntryId`, либо `salaryEntryId`»
/// явным enum-ом, чтобы UI и аналитика не лезли в FK.
enum PayrollPayoutLineKind {
  PIECEWORK
  SALARY
  /// Бонус (подготовка для будущих ручных строк выплат; UI в STEP 6.4 не делается).
  BONUS
  /// Удержание (подготовка для будущих ручных строк выплат; UI в STEP 6.4 не делается).
  DEDUCTION
  /// Аванс (подготовка для будущих ручных строк выплат; UI в STEP 6.4 не делается).
  ADVANCE
  /// Корректировка из PayrollAccrualDocumentLine.manualAdjustRub (STEP 6.4).
  ADJUSTMENT
}

/// Жизненный цикл документа начисления зарплаты (`PayrollAccrualDocument`,
/// PHASE 3 STEP 6). Менеджер формирует DRAFT, затем проводит → PAID
/// (если сформированы индивидуальные выплаты) или отменяет → CANCELLED.
enum PayrollAccrualDocumentStatus {
  DRAFT
  PAID
  CANCELLED
}

// =========================
// DICTIONARIES
// =========================

model Size {
  id        String   @id @default(cuid())
  code      String   @unique
  sortOrder Int
  createdAt DateTime @default(now())

  passports                      Passport[]
  orderItems                     OrderItem[]
  operationRatesBySize           OperationRateBySize[]
  closureRequests                CuttingClosureRequest[]
  patternSizeFiles               PatternSizeFile[]
  patternMaterialAreas           PatternMaterialArea[]
  /// Этап «Погонные метры по размерам»: обратная связь от значений
  /// `PatternItemSizeParameterValue`, привязанных к этому размеру.
  /// `onDelete: Cascade` — удаление размера каскадно сносит значения.
  patternItemSizeParameterValues PatternItemSizeParameterValue[]
  /// Поразмерные нормы времени операций (см. `OperationTimeNormBySize`).
  /// Заполняются на `/admin/operations/[id]` для операций с
  /// `timeNormMode = BY_SIZE`. Источник истины для будущего
  /// `OperationsService.resolveTimeNormSec(...)`. Payroll (Operation
  /// rates / OperationEntry) этой связи не использует — это отдельный
  /// плановый контур (см. `docs/operation-time-norms-recon.md §10`).
  operationTimeNormsBySize       OperationTimeNormBySize[]
  /// Этап «Очередь выдачи кроя по размерам» (см.
  /// `prisma/schema.prisma::OrderCutIssueRule`,
  /// `docs/domain.md §«Очередь выдачи кроя»`). Обратная связь от строк
  /// очереди — менеджер ссылается на конкретный размер из справочника.
  /// `onDelete: Restrict` со стороны `OrderCutIssueRule.size` защищает
  /// от случайного удаления размера, на который завязана активная
  /// очередь.
  cutIssueRules                  OrderCutIssueRule[]

  /// Foundation готовой продукции (см. `model FinishedGoodsBalance` /
  /// `model FinishedGoodsMovement` ниже). Restrict со стороны баланса/
  /// движения — размер, по которому есть выпущенные изделия, нельзя
  /// удалить без сноса самих балансов.
  finishedGoodsBalances  FinishedGoodsBalance[]
  finishedGoodsMovements FinishedGoodsMovement[]

  /// Foundation полуфабриката (см. `model WorkInProgressBalance` /
  /// `model WorkInProgressMovement` ниже).
  workInProgressBalances  WorkInProgressBalance[]
  workInProgressMovements WorkInProgressMovement[]

  /// Back-relation на строки отгрузки готовой продукции (см.
  /// `model FinishedGoodsShipmentLine`). Restrict — размер, по
  /// которому уже была отгрузка, нельзя удалять.
  finishedGoodsShipmentLines FinishedGoodsShipmentLine[]
}

model Product {
  id        String   @id @default(cuid())
  name      String
  color     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  passports       Passport[]
  orderItems      OrderItem[]
  closureRequests CuttingClosureRequest[]
  /// Этап «Номенклатура = Лекала» (см. `docs/recon-soft-integration.md
  /// §«Номенклатура = Лекала»»). Back-relation для авто-создаваемого
  /// «технического» Product, который OrdersService подставляет в
  /// `OrderItem.productId`, когда заказ заводится только по
  /// `PatternItem`. Связь 1:0..1 (см. `PatternItem.legacyProductId
  /// @unique`). На MVP здесь обычно ровно одна строка на Product —
  /// при удалении лекала связь обнуляется (`onDelete: SetNull` на
  /// стороне `PatternItem`), сам Product остаётся в БД (паспорта
  /// и `OrderItem` всё ещё на него ссылаются).
  patternItems    PatternItem[]           @relation("PatternLegacyProduct")

  /// Foundation готовой продукции (см. `model FinishedGoodsBalance` /
  /// `model FinishedGoodsMovement` ниже). Restrict со стороны баланса/
  /// движения: продукт, по которому есть выпущенные изделия, нельзя
  /// удалить без сноса самих балансов. На MVP это управленческий
  /// справочник, удаление out-of-scope.
  finishedGoodsBalances  FinishedGoodsBalance[]
  finishedGoodsMovements FinishedGoodsMovement[]

  /// Foundation полуфабриката (см. `model WorkInProgressBalance` /
  /// `model WorkInProgressMovement` ниже).
  workInProgressBalances  WorkInProgressBalance[]
  workInProgressMovements WorkInProgressMovement[]

  /// Back-relation на строки отгрузки готовой продукции (см.
  /// `model FinishedGoodsShipmentLine`). Restrict — продукт, по
  /// которому уже была отгрузка, нельзя удалить без сноса
  /// самой отгрузки.
  finishedGoodsShipmentLines FinishedGoodsShipmentLine[]
}

model Operation {
  id                     String            @id @default(cuid())
  code                   String            @unique
  name                   String
  category               OperationCategory
  sortOrder              Int
  active                 Boolean           @default(true)
  createdAt              DateTime          @default(now())
  /// Дата последнего управленческого изменения (тариф, переименование,
  /// смена `pricingMode`). Поставлен `@updatedAt`, чтобы UI
  /// `/admin/operations` мог показывать «когда настраивалось последний
  /// раз». Существующие операции, созданные до миграции, получают
  /// `updatedAt = createdAt` через бэкфилл.
  updatedAt              DateTime          @updatedAt
  /// Тарифный режим операции (см. `PricingMode`). Дефолт
  /// `SALARY_ONLY` — самый безопасный режим: операция участвует в
  /// pipeline, но сдельная ставка не применяется. Все существующие
  /// операции получили корректное значение через миграцию Шага 18
  /// (`20260420100000_operation_pricing_model`), которая бэкфилила
  /// данные из исторической таблицы `PieceRate`. Сама `PieceRate`
  /// удалена в PHASE 2 STEP 1 (см. ADR-0020 §«PHASE 2 — drop legacy»).
  pricingMode            PricingMode       @default(SALARY_ONLY)
  /// Фиксированная ставка для `pricingMode = FIXED`. Для `BY_SIZE` и
  /// `SALARY_ONLY` хранится `null` (валидируется в `OperationsService`).
  fixedRate              Decimal?          @db.Decimal(12, 2)
  /// Режим нормы времени (см. `docs/operation-time-norms-recon.md §10`):
  ///   - `"FIXED"`   — одна норма на операцию (`timeNormSec`);
  ///   - `"BY_SIZE"` — поразмерная матрица (`OperationTimeNormBySize`).
  /// Хранится строкой по тому же паттерну, что `Order.colorRule` и
  /// `OrderApplication.colorRule` — расширяется без миграции.
  ///
  /// Это **отдельная ось** от `pricingMode` (тариф/деньги): операция
  /// может одновременно быть `pricingMode = SALARY_ONLY` (без сдельной
  /// ставки), но иметь плановую норму времени. Payroll
  /// (`OperationsService.resolveRate`, `EarningsService`) этой колонки
  /// НЕ читает — это плановый, не фактический контур.
  timeNormMode           String            @default("FIXED")
  /// Фиксированная норма времени в секундах для `timeNormMode = "FIXED"`.
  /// `null` — норма не задана (UI рисует «—»). Для `timeNormMode =
  /// "BY_SIZE"` всегда `null`; норма берётся из `OperationTimeNormBySize`.
  /// Хранится `Int` — точность одной секунды достаточна (ввод в UI —
  /// «мин:сек»).
  timeNormSec            Int?
  /// Плановая стоимость одной смены для расчёта плановой себестоимости
  /// окладных операций (`pricingMode = SALARY_ONLY`). Используется
  /// **только** в `OrderOperationPlanService` для оценки себестоимости
  /// окладных операций в плане заказа: cost = timeSec ×
  /// (`salaryPlanRubPerShift` / `salaryPlanShiftSeconds`) × qty.
  ///
  /// Это **не фактическая зарплата** — `SalaryEntry`, `OperationEntry`,
  /// `EmployeeCompensation` и payroll-контур (`SalaryService`,
  /// `EarningsService`) этот столбец не читают. Поле сознательно
  /// отделено от `Employee.salaryPerShift`: операция привязана к
  /// «расчётной стоимости часа цеха», а не к конкретному сотруднику.
  ///
  /// `null` — плановая ставка не задана; `OrderOperationPlanService`
  /// в этом случае пишет `cost = 0` и warning «Не задана плановая
  /// окладная ставка», но заказ не блокирует.
  ///
  /// Для `pricingMode = FIXED` / `BY_SIZE` поле тоже допустимо, но
  /// игнорируется — там цена считается по сдельной ставке.
  salaryPlanRubPerShift  Decimal?          @db.Decimal(14, 2)
  /// Длительность смены (в секундах), используемая для расчёта
  /// `costPerSecond = salaryPlanRubPerShift / salaryPlanShiftSeconds`.
  /// Default `28800` = 8 часов; менеджер может задать иную
  /// «расчётную смену» (например, 7-часовую), не трогая фактический
  /// payroll. Только positive int; валидируется в `OperationsService`.
  salaryPlanShiftSeconds Int?              @default(28800)
  /// Признак «операция выпускает готовую продукцию» (см.
  /// `apps/api/src/modules/finished-goods/finished-goods.service.ts::recordPassportOutputInTx`,
  /// `docs/current-state.md §«Готовая продукция»`).
  ///
  /// Если `true`, при успешном прохождении этой операции по паспорту
  /// (см. `PassportsService.scanOnOperation` /
  /// `PassportsService.completeOperationByEmployee`) создаётся
  /// `FinishedGoodsMovement` `type = PRODUCTION_RECEIPT` `direction = IN`
  /// на склад `Order.finishedGoodsWarehouseId` (или «no-warehouse»,
  /// если не задан). Идемпотентно по
  /// `sourceKey = PACKED_PASSPORT:<passportId>` — повторное прохождение
  /// той же операции, повторный complete и последующая упаковка не
  /// задвоят движение.
  ///
  /// Не путать с категорией `PACKING`: категория управляет UI/группировкой,
  /// а признак выпуска — реальной финансово-учётной точкой. Канонический
  /// сценарий — операция «Упаковка» с `producesFinishedGoods = true`
  /// (либо «ОТК финальный» / любая другая последняя операция цеха).
  /// Отдельную операцию «Выпуск» сознательно НЕ заводим — это
  /// признак на уже существующей операции.
  producesFinishedGoods  Boolean           @default(false)

  events              PassportEvent[]           @relation("EventOperation")
  movedFromEvents     PassportEvent[]           @relation("EventFromOperation")
  entries             OperationEntry[]
  ratesBySize         OperationRateBySize[]
  /// Поразмерная матрица плановых норм времени для `timeNormMode =
  /// "BY_SIZE"` (см. `OperationTimeNormBySize`). Только для плана —
  /// payroll эту таблицу не читает.
  timeNormsBySize     OperationTimeNormBySize[]
  currentPassports    Passport[]                @relation("PassportCurrentOperation")
  shiftSessions       ShiftSession[]
  equipmentOperations EquipmentOperation[]
  routeTemplateSteps  RouteTemplateStep[]
  orderRouteSteps     OrderRouteStep[]
  /// Вызовы мастера, для которых известна текущая операция
  /// сотрудника. Заполняется backend'ом из `ShiftSession.operationId`
  /// (если есть открытая смена) на момент создания вызова.
  masterCalls         MasterCall[]

  @@index([sortOrder])
  @@index([category])
  @@index([pricingMode])
}

/// Ставка операции по размеру (для `Operation.pricingMode = BY_SIZE`).
///
/// Источник истины для `OperationsService.resolveRate(...)` и для
/// сдельных начислений `EarningsService`. Заполняется из
/// `/admin/operations/[id]` (роли `ADMIN` / `SHOP_MANAGER`,
/// см. `docs/api.md §15a`, `docs/screens.md §10c`).
///
/// Сознательные ограничения MVP:
///   - один тариф на пару `(operationId, sizeId)`, без истории
///     по датам (на MVP это не нужно — ставки меняются редко);
///   - без привязки к продукту / сотруднику / складу — это
///     управленческая ставка цеха целиком (см. `docs/domain.md §16a`).
///
/// Для `pricingMode = FIXED` строки в этой таблице не создаются;
/// `Operation.fixedRate` хранит единственную ставку. Для
/// `pricingMode = SALARY_ONLY` ставок нет вообще.
model OperationRateBySize {
  id          String   @id @default(cuid())
  operationId String
  sizeId      String
  /// Сдельная ставка за единицу для пары (operation, size). Те же
  /// `Decimal(12,2)`, что и в `OperationEntry.ratePerUnit`.
  rate        Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  size      Size      @relation(fields: [sizeId], references: [id])

  @@unique([operationId, sizeId], name: "OperationRateBySize_operation_size_uniq")
  @@index([operationId])
  @@index([sizeId])
}

/// Поразмерная плановая норма времени операции (для
/// `Operation.timeNormMode = "BY_SIZE"`). Это **отдельная ось** от
/// `OperationRateBySize` — payroll сюда не ходит.
///
/// Источник истины для будущего
/// `OperationsService.resolveTimeNormSec(operationId, sizeId)`.
/// Заполняется на `/admin/operations/[id]` тем же паттерном, что и
/// ставки (роли `ADMIN` / `SHOP_MANAGER`).
///
/// Сознательные ограничения MVP:
///   - одна норма на пару `(operationId, sizeId)`, без истории;
///   - без привязки к продукту / сотруднику — это управленческая
///     норма цеха целиком.
///
/// Для `timeNormMode = "FIXED"` строки не создаются;
/// `Operation.timeNormSec` хранит единственную норму. См.
/// `docs/operation-time-norms-recon.md §10`.
model OperationTimeNormBySize {
  id          String   @id @default(cuid())
  operationId String
  sizeId      String
  /// Норма времени в СЕКУНДАХ (целое). Хранится `Int` — точность
  /// одной секунды достаточна; ввод в UI — «мин:сек».
  seconds     Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  size      Size      @relation(fields: [sizeId], references: [id], onDelete: Cascade)

  @@unique([operationId, sizeId], name: "OperationTimeNormBySize_operation_size_uniq")
  @@index([operationId])
  @@index([sizeId])
}

// =========================
// PEOPLE
// =========================

model Employee {
  id                     String           @id @default(cuid())
  fullName               String
  login                  String           @unique
  pinHash                String
  role                   Role
  /// Единственная ось «как платим» (см. `CompensationType`,
  /// `docs/domain.md §9a`, ADR-0021). Гейтит и сдельный
  /// (`EarningsService`), и окладной (`SalaryService`) контуры:
  /// `PIECEWORK`/`MIXED` — получают сдельные `OperationEntry`,
  /// `SALARY` — нет; `SALARY`/`MIXED` — получают дневной
  /// `SalaryEntry`, `PIECEWORK` — нет. Дефолт `PIECEWORK` —
  /// безопасный: ни одной автоматической окладной записи не
  /// создаётся, пока менеджер не переключит сотрудника в `SALARY`
  /// или `MIXED` через `/admin/employees`.
  compensationType       CompensationType @default(PIECEWORK)
  /// Ставка за один отработанный день/смену. Читается модулем
  /// `salary` для `compensationType ∈ { SALARY, MIXED }`. Для
  /// `PIECEWORK` хранится `null` и игнорируется. Валидируется в
  /// `EmployeesService.update` (см. `apps/api/src/modules/employees`).
  salaryPerShift         Decimal?         @db.Decimal(12, 2)
  /// Процент начисления закройщика для B2B-заказов (см.
  /// `docs/payroll-cutter-compensation-recon.md §«Настраиваемый
  /// процент»`, `packages/shared/src/cutter-compensation.ts`).
  ///
  /// Используется только для сотрудников с ролью `CUTTER` и только
  /// в B2B-схеме (`getCutterCompensationSchemeForDivision(...) →
  /// B2B_SEWING_PERCENT`). Для marketplace-заказов поле
  /// игнорируется (там работает старая фиксированная схема через
  /// `Operation.fixedRate × passport.qtyCut`).
  ///
  /// `Decimal(5, 2)` хранит проценты вида `5.00` = 5%. Значение
  /// валидируется на shared-уровне (`>= 0` и `<= 100`, не более
  /// двух знаков после точки). `null` — у конкретного сотрудника
  /// процент не задан; в этом случае `EarningsService` берёт
  /// fallback из ENV `CUTTER_B2B_SEWING_PERCENT`. Если и его нет —
  /// сдельное B2B-начисление закройщика не создаётся (audit/log
  /// warning, workflow не падает).
  cutterB2bSewingPercent Decimal?         @db.Decimal(5, 2)
  /// PHASE 2 STEP 2: основная привязка сотрудника к подразделению
  /// компании (`CompanyDivision`, см. ниже и `docs/erd.md §«CompanyDivision»`).
  ///
  /// Используется payroll-фильтром `/api/payroll/period?divisionCode=...`
  /// — для сдельных начислений фильтр идёт через `Passport → Order →
  /// CompanyDivision`, а окладные/смены прибиты к самому сотруднику
  /// и берут подразделение из этого поля. Без него управленец не
  /// мог раньше отделить «своих» окладников MARKETPLACE-цеха от
  /// общего цеха при выборе фильтра.
  ///
  /// `null` — сотрудник пока не привязан ни к одному подразделению
  /// (legacy-импорт, кадровик ещё не заполнил). В payroll такие
  /// сотрудники видны только при выборе «все подразделения».
  /// `onDelete: SetNull` — снос подразделения не сносит сотрудника.
  companyDivisionId      String?
  companyDivision        CompanyDivision? @relation(fields: [companyDivisionId], references: [id], onDelete: SetNull)
  active                 Boolean          @default(true)
  createdAt              DateTime         @default(now())

  shiftSessions    ShiftSession[]
  eventsAsActor    PassportEvent[]  @relation("EventEmployee")
  operationEntries OperationEntry[]
  salaryEntries    SalaryEntry[]
  boxesCreated     Box[]            @relation("BoxCreator")

  passportsAsCurrent Passport[]       @relation("PassportCurrentEmployee")
  passportsAsCutter  Passport[]       @relation("PassportCutter")
  passportsAsCreator Passport[]       @relation("PassportCreator")
  passportDefects    PassportDefect[] @relation("DefectCreator")

  closureRequestsCreated  CuttingClosureRequest[] @relation("ClosureRequestRequester")
  closureRequestsReviewed CuttingClosureRequest[] @relation("ClosureRequestReviewer")
  salaryEntriesEdited     SalaryEntry[]           @relation("SalaryEntryEditor")

  /// Этап 6А «Заказы поставщикам» (см. `model PurchaseOrder` ниже,
  /// `apps/api/src/modules/purchase-orders/*`,
  /// `docs/recon-soft-integration.md §«Этап 6А»`). Заказы, которые
  /// этот сотрудник создал кнопкой «Создать заказ поставщику».
  /// `onDelete: SetNull` со стороны `PurchaseOrder.createdById`:
  /// удаление учётки не сносит закупочный документ.
  createdPurchaseOrders PurchaseOrder[] @relation("PurchaseOrderCreator")

  /// Этап 7А «Приёмка поставок» (см. `model PurchaseReceipt` ниже,
  /// `apps/api/src/modules/purchase-receipts/*`,
  /// `docs/recon-soft-integration.md §«Этап 7А»`). Документы
  /// фактической приёмки, которые этот сотрудник зарегистрировал
  /// кнопкой «Принять поступление». `onDelete: SetNull` со
  /// стороны `PurchaseReceipt.receivedById`: деактивация/удаление
  /// учётки не сносит документ приёмки.
  receivedPurchaseReceipts PurchaseReceipt[] @relation("PurchaseReceiptReceiver")

  /// Вызовы мастера, поданные этим сотрудником (любая рабочая роль).
  /// См. `MasterCall` ниже и `docs/domain.md §«Мастер цеха»`.
  masterCalls         MasterCall[] @relation("MasterCallEmployee")
  /// Вызовы, закрытые этим сотрудником (мастер / SHOP_MANAGER / ADMIN).
  masterCallsResolved MasterCall[] @relation("MasterCallResolver")

  /// Конфигурация display-экрана, привязанного к этой DISPLAY-учётке
  /// (см. `DisplayScreenConfig`). 1:1 — на один Employee может быть
  /// заведён максимум один экран; уникальность гарантируется
  /// `DisplayScreenConfig.employeeId @unique`. Для не-DISPLAY ролей
  /// связь отсутствует.
  displayScreen DisplayScreenConfig?

  /// DXF-файлы лекал, загруженные этим сотрудником (`PatternSizeFile.uploadedById`).
  /// `onDelete: SetNull` со стороны `PatternSizeFile`: удаление учётки
  /// не сносит файл лекала.
  patternSizeFilesUploaded PatternSizeFile[] @relation("PatternSizeFileUploader")

  /// Этап «Себестоимость заказа» (см. `model OrderCostEstimate` ниже,
  /// `apps/api/src/modules/orders/orders.service.ts::completeCalculation`).
  /// Расчёты, завершённые этим сотрудником (нажал «Завершить расчёт»).
  /// `onDelete: SetNull` со стороны `OrderCostEstimate.completedById`:
  /// удаление учётки не сносит исторический документ расчёта.
  completedOrderCostEstimates OrderCostEstimate[] @relation("OrderCostEstimateCompleter")
  /// Аналогичная back-relation для «вернувшего на пересчёт»
  /// (`OrderCostEstimate.revokedById`).
  revokedOrderCostEstimates   OrderCostEstimate[] @relation("OrderCostEstimateRevoker")

  /// Этап «Ручная отметка поступления материала» (см.
  /// `model OrderMaterialArrivalOverride` ниже,
  /// `apps/api/src/modules/order-material-arrivals/*`).
  /// Override-ы, созданные / отменённые этим сотрудником.
  /// `onDelete: SetNull` со стороны
  /// `OrderMaterialArrivalOverride.createdById`/`revokedById` —
  /// удаление учётки не сносит исторический override.
  materialArrivalOverridesCreated OrderMaterialArrivalOverride[] @relation("OrderMaterialArrivalOverrideCreatedBy")
  materialArrivalOverridesRevoked OrderMaterialArrivalOverride[] @relation("OrderMaterialArrivalOverrideRevokedBy")

  /// PHASE 3 «PayrollPayout» (см. `model PayrollPayout` ниже,
  /// `docs/erd.md §2.9`, `docs/domain.md §10.7`). Обратные связи
  /// для каждой роли в выплате — получатель, автор черновика,
  /// тот кто выдал, сам сотрудник-подтвердивший и тот кто отменил.
  payrollPayouts             PayrollPayout[] @relation("PayrollPayoutEmployee")
  createdPayrollPayouts      PayrollPayout[] @relation("PayrollPayoutCreatedBy")
  issuedPayrollPayouts       PayrollPayout[] @relation("PayrollPayoutIssuedBy")
  acknowledgedPayrollPayouts PayrollPayout[] @relation("PayrollPayoutAcknowledgedBy")
  cancelledPayrollPayouts    PayrollPayout[] @relation("PayrollPayoutCancelledBy")

  /// PHASE 3 STEP 6 «PayrollAccrualDocument» — обратные связи для
  /// каждой управленческой роли в документе начисления зарплаты.
  payrollAccrualDocumentsCreated   PayrollAccrualDocument[]     @relation("PayrollAccrualDocumentCreatedBy")
  payrollAccrualDocumentsPaid      PayrollAccrualDocument[]     @relation("PayrollAccrualDocumentPaidBy")
  payrollAccrualDocumentsCancelled PayrollAccrualDocument[]     @relation("PayrollAccrualDocumentCancelledBy")
  payrollAccrualDocumentLines      PayrollAccrualDocumentLine[]

  @@index([role])
  @@index([compensationType])
  /// PHASE 2 STEP 2: фильтр payroll/period по подразделению пробивается
  /// через `Employee.companyDivisionId` (для окладной части) и через
  /// `Order.companyDivisionId` (для сдельной). Индекс ускоряет
  /// `findMany({ where: { companyDivisionId } })` в сервисе сотрудников
  /// и payroll-агрегаторе.
  @@index([companyDivisionId])
}

model Equipment {
  id            String   @id @default(cuid())
  code          String   @unique
  qrCode        String   @unique
  name          String
  /// Ручной отображаемый порядковый номер станка для физической
  /// маркировки и быстрой визуальной идентификации (см. ADR-0017,
  /// `docs/domain.md §5c`). Печатная этикетка `/api/equipment/:id/print`
  /// показывает его максимально крупно — чтобы швея/начальник цеха
  /// мгновенно различали два соседних оверлока. Уникальность не
  /// требуется глобально (№1 может быть и у оверлока, и у распошива);
  /// валидируется в админ-UI по ситуации.
  displayNumber String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  shiftSessions     ShiftSession[]
  allowedOperations EquipmentOperation[]
  printers          Printer[]
  /// Вызовы мастера, привязанные к этому оборудованию (когда вызов
  /// создан в рамках активной смены — backend копирует `equipmentId`
  /// смены в `MasterCall`). На дисплее `/shopfloor/display` плитка
  /// такого станка получает класс `display-equipment-tile--master-call`
  /// и мягкий violet/blue pulse, см. `docs/screens.md §9a`.
  masterCalls       MasterCall[]
}

/// Связь «оборудование ↔ разрешённая операция» (M2M через явную модель).
///
/// Источник истины для seamstress flow на /work: при старте смены UI
/// показывает только те операции, которые включены здесь для конкретного
/// `Equipment`. Управляется из `/admin/equipment` (роли ADMIN /
/// SHOP_MANAGER). До MVP «equipment-config» этот набор вычислялся на
/// фронте по префиксу `Equipment.code` — теперь это явная конфигурация
/// в БД (см. ADR-0017 и docs/domain.md §5c).
model EquipmentOperation {
  id          String   @id @default(cuid())
  equipmentId String
  operationId String
  /// Порядок отображения операции в списке выбора на /work. Меньше —
  /// выше. Если не задан явно, по умолчанию совпадает с Operation.sortOrder.
  sortOrder   Int      @default(0)
  /// Мягкое отключение: запись остаётся (история), но в /work не
  /// показывается и в API считается «нет». Полная очистка набора через
  /// PATCH удаляет строки физически, поэтому isActive нужен только для
  /// промежуточных состояний управления.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@unique([equipmentId, operationId], name: "EquipmentOperation_equipment_operation_uniq")
  @@index([equipmentId, sortOrder])
  @@index([operationId])
}

model ShiftSession {
  id          String    @id @default(cuid())
  employeeId  String
  equipmentId String
  operationId String
  startedAt   DateTime  @default(now())
  endedAt     DateTime?

  employee  Employee  @relation(fields: [employeeId], references: [id])
  equipment Equipment @relation(fields: [equipmentId], references: [id])
  operation Operation @relation(fields: [operationId], references: [id])

  @@index([employeeId, endedAt])
}

// =========================
// ORDERS
// =========================

model Order {
  id        String      @id @default(cuid())
  number    String      @unique
  /// Историческое поле «свободный текст клиента» — оставлено как есть
  /// для backward compatibility со старым flow создания заказа
  /// (`/orders/new`, легаси-API). На новом UI его место занимает
  /// связь `clientId` ниже.
  customer  String?
  /// Управленческая привязка заказа к карточке клиента из справочника
  /// `Client` (см. `model Client` ниже). Nullable: исторические заказы
  /// остаются без явной связи, новые могут заводиться без выбора
  /// клиента (free-text `customer` всё ещё работает). При удалении
  /// клиента связь обнуляется — сами заказы не удаляются и доступны
  /// в журналах.
  clientId  String?
  client    Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  orderDate DateTime
  /// Срок сдачи заказа (управленческое поле — UI «Срок сдачи»). Nullable
  /// — backward-compat для исторических заказов и для случаев, когда
  /// менеджер не хочет фиксировать срок.
  dueDate   DateTime?
  color     String?
  comment   String?
  status    OrderStatus @default(DRAFT)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  /// Подразделение заказа — FK на master-справочник `CompanyDivision`
  /// (см. `docs/domain.md §«Подразделения заказа»`,
  /// `docs/erd.md §«Order»`). Используется как фильтр большого экрана
  /// `/shopfloor/display?divisionCode=…` и в `EarningsService` для
  /// выбора схемы начисления закройщика.
  ///
  /// Nullable + `onDelete: SetNull`: деактивация/удаление карточки
  /// `CompanyDivision` не сносит заказ — live-связь обнуляется, в
  /// карточке заказа UI показывает «Не указано».
  ///
  /// Меняется только в `DRAFT`, после `IN_PRODUCTION` блокируется
  /// общим ORDER_LOCKED guard `OrdersService.update`.
  companyDivisionId String?
  companyDivision   CompanyDivision? @relation(fields: [companyDivisionId], references: [id], onDelete: SetNull)

  /// Soft-route MVP: опциональная ссылка на шаблон маршрута производства
  /// (см. `RouteTemplate` ниже и `docs/domain.md §«Маршруты»`). На MVP
  /// заполняется при создании/редактировании заказа в DRAFT и фиксируется
  /// в snapshot `OrderRouteStep[]` при первом `OrdersService.start()`.
  /// Поле остаётся `null` для всех старых заказов и для тех, кто
  /// не выбрал шаблон — backward-compatible.
  routeTemplateId String?
  routeTemplate   RouteTemplate? @relation(fields: [routeTemplateId], references: [id])

  /// Tech-card MVP (см. `TechCardTemplate` ниже и `docs/domain.md
  /// §«Техкарты»`, ADR-0022). Опциональная ссылка на шаблон техкарты,
  /// который фиксируется snapshot-ами `OrderMaterialRequirement[]` и
  /// `OrderOutsourceRequirement[]` при `OrdersService.start()`.
  /// Параллельная ось маршруту: техкарта и маршрут независимы.
  techCardId String?
  techCard   TechCardTemplate? @relation(fields: [techCardId], references: [id])

  /// Soft-pattern MVP (этап 2 «Лекала», см. `docs/recon-soft-integration.md
  /// §«План внедрения»`, `model PatternItem` ниже).
  ///
  /// Опциональная ссылка на карточку лекала (конструкцию изделия). На
  /// этом этапе:
  ///   - поле nullable — все исторические заказы остаются валидными,
  ///     лекало не обязательно для запуска заказа в производство;
  ///   - меняется только в `DRAFT` (общий ORDER_LOCKED guard
  ///     в `OrdersService.update`);
  ///   - валидация existence/`status = ACTIVE` — `assertPatternUsable`
  ///     в `OrdersService` (по той же схеме, что `routeTemplateId` /
  ///     `techCardId`);
  ///   - `onDelete: SetNull` — удаление карточки лекала не сносит
  ///     заказ; live-связь обнуляется, но `patternNameSnapshot` /
  ///     `patternArticleSnapshot` / `patternPreviewSnapshotUrl` уже
  ///     зафиксированные при `start()` остаются как «исторический
  ///     слепок».
  patternItemId String?
  patternItem   PatternItem? @relation(fields: [patternItemId], references: [id], onDelete: SetNull)

  /// Snapshot-имя лекала, зафиксированное в момент `OrdersService.start()`.
  /// Заполняется только если на момент запуска у заказа был выбран
  /// `patternItemId`. Защищает уже запущенные заказы от поздних правок
  /// карточки лекала: в карточке заказа в работе UI показывает
  /// snapshot, а не live-значение.
  patternNameSnapshot       String?
  /// Snapshot-артикул лекала (см. комментарий к `patternNameSnapshot`).
  patternArticleSnapshot    String?
  /// Snapshot URL превью лекала (`PatternItem.previewImageUrl` на
  /// момент запуска заказа). Для уже запущенных заказов UI отдаёт
  /// именно этот URL — даже если в карточке лекала позже сменили
  /// превью или его удалили, заказ продолжает показывать «как было».
  patternPreviewSnapshotUrl String?

  items                 OrderItem[]
  passports             Passport[]
  closureRequests       CuttingClosureRequest[]
  routeSteps            OrderRouteStep[]
  materialRequirements  OrderMaterialRequirement[]
  outsourceRequirements OrderOutsourceRequirement[]
  /// Этап 4А «Потребность цеха» (см. `model WorkshopNeed` ниже,
  /// `apps/api/src/modules/workshop-needs/*`,
  /// `docs/recon-soft-integration.md §«Этап 4А»`). Чистая
  /// потребность заказа в материалах: один заказ → много строк
  /// `WorkshopNeed`. Cascade — потому что без заказа потребность
  /// смысла не имеет (запасов/закупок мы здесь не моделируем).
  workshopNeeds         WorkshopNeed[]
  /// Этап 6А «Заказы поставщикам» (см. `model PurchaseOrder` ниже,
  /// `apps/api/src/modules/purchase-orders/*`). Заказы поставщикам,
  /// связанные с этим заказом покупателя (на MVP — все строки PO
  /// относятся к одному customerOrder). `onDelete: SetNull` со
  /// стороны `PurchaseOrder.customerOrderId`: удаление заказа
  /// покупателя не сносит закупочный документ — он остаётся в
  /// журнале, просто без обратной ссылки.
  purchaseOrders        PurchaseOrder[]

  /// Этап 7А «Приёмка поставок» (см. `model PurchaseReceipt` ниже,
  /// `apps/api/src/modules/purchase-receipts/*`,
  /// `docs/recon-soft-integration.md §«Этап 7А»`). Документы
  /// фактической приёмки, которые относятся к этому заказу
  /// покупателя (через PO с этим `customerOrderId`). На MVP это
  /// сводный список «что и куда положили под этот заказ».
  /// `onDelete: SetNull` со стороны
  /// `PurchaseReceipt.customerOrderId`: удаление заказа покупателя
  /// не сносит акт приёмки.
  purchaseReceipts PurchaseReceipt[]

  /// Этап «Нанесение на заказе покупателя» (см. `model OrderApplication`
  /// ниже, `apps/api/src/modules/order-applications/*`).
  ///
  /// Заказные нанесения (шелкография / DTF / вышивка / термотрансфер /
  /// сублимация / OTHER) живут на самом заказе покупателя, а не в
  /// маршруте/техкарте — параметры конкретного заказа не должны
  /// зависеть от техкарты, по которой его запустили. Используется
  /// для: (а) проверки готовности к крою (см.
  /// `CutReadinessService`), (б) расчёта потребности цеха
  /// (`WorkshopNeedsService.calculateForOrder`).
  /// Cascade — без заказа смысла у нанесения нет.
  applications OrderApplication[]

  /// Этап «Себестоимость заказа» (см. `model OrderCostEstimate` ниже,
  /// `apps/api/src/modules/orders/*::completeCalculation`).
  ///
  /// История завершённых расчётов себестоимости (одна — `COMPLETED`,
  /// прочие — `REVOKED`). Снос заказа сносит и историю — расчёты
  /// без заказа смысла не имеют.
  costEstimates OrderCostEstimate[]

  /// Этап «Ручная отметка поступления материала» (см.
  /// `model OrderMaterialArrivalOverride` ниже,
  /// `apps/api/src/modules/order-material-arrivals/*`,
  /// `apps/api/src/modules/cut-readiness/cut-readiness.service.ts`).
  ///
  /// Список ручных отметок «материал поступил», созданных кнопкой
  /// «Материал поступил» в карточке заказа. Cascade — без заказа
  /// override смысла не имеет (это атрибут готовности к крою
  /// конкретного заказа, а не складская сущность).
  materialArrivalOverrides OrderMaterialArrivalOverride[]

  /// Snapshot последнего завершённого расчёта (`COMPLETED`), скопированный
  /// в Order для быстрой отрисовки бейджей «Себестоимость» в UI и
  /// списках, без `JOIN` на `OrderCostEstimate`.
  ///
  /// Жизненный цикл:
  ///   - `CALCULATION_DONE` (`completeCalculation`) — заполняем все три
  ///     поля по только что созданному `OrderCostEstimate`;
  ///   - `reopenCalculation` — поля сбрасываются в `null` (история
  ///     остаётся в `OrderCostEstimate`-таблице со статусом `REVOKED`);
  ///   - все остальные переходы (`start`, `complete`, `cancel`,
  ///     обычный PATCH `update`) полей не трогают.
  ///
  /// FK на конкретный `OrderCostEstimate` сознательно не ставим — это
  /// плоский snapshot, не «активная» ссылка. Это упрощает migration и
  /// исключает циклические Prisma-relations (Order ↔ OrderCostEstimate).
  costEstimateTotalRub    Decimal?  @db.Decimal(14, 2)
  costEstimateCompletedAt DateTime?
  costEstimateVersion     Int?

  /// Этап «Цена продажи за единицу» (см.
  /// `apps/api/src/modules/orders/orders.service.ts::create`/`update`,
  /// `packages/shared/src/orders.ts`,
  /// `prisma/migrations/20260521100000_add_order_customer_unit_price`).
  ///
  /// Управленческое поле: цена, по которой производство продаёт
  /// одно изделие заказчику. Используется на детали и в списке
  /// заказов, чтобы видеть выручку и маржу: `revenue =
  /// customerUnitPrice × Σ qtyPlan`. Сама себестоимость хранится
  /// в `costEstimateTotalRub` (см. этап «Себестоимость заказа»).
  ///
  /// Дизайн MVP:
  ///   - оба поля nullable: исторические заказы остаются валидными;
  ///   - валюта ограничена `RUB`/`USD` на уровне Zod (см.
  ///     `MoneyCurrencySchema`). В БД остаётся свободным TEXT,
  ///     чтобы расширить список без миграции;
  ///   - exchange-rate API намеренно не подключаем: для USD-цен
  ///     UI показывает выручку в долларах и не считает маржу в
  ///     рублях без явного курса (тот же подход, что у
  ///     `OrderCostEstimateLine.lineTotalRub` для USD-строк
  ///     `WorkshopNeed`).
  ///
  /// Меняется через PATCH `/api/orders/:id` (см.
  /// `OrdersService.update`); попадает в `OrderListItemDto` и
  /// `OrderDetailDto` как nullable-строка.
  customerUnitPrice Decimal? @db.Decimal(14, 2)
  customerCurrency  String?

  /// Этап 2 «План операций на заказе» (см.
  /// `docs/operation-time-norms-recon.md §10/§11`,
  /// `apps/api/src/modules/orders/order-operation-plan.service.ts`).
  ///
  /// Snapshot плановой стоимости операций по заказу (₽). Заполняется в
  /// `OrderOperationPlanService.recalculateAndWrite`, который вызывается
  /// из `OrdersService.create`, `OrdersService.update` (только в DRAFT и
  /// только при изменении `routeTemplateId` / `items` / `patternItemId`),
  /// и `OrdersService.startCalculation` (финальный snapshot перед
  /// расчётом себестоимости). После `start()` план **не пересчитывается**
  /// — он остаётся «как заказ ушёл в работу».
  ///
  /// `null` означает «план не считался»: либо заказ ещё ни разу не
  /// проходил через перерасчёт (исторический заказ до этой миграции),
  /// либо у заказа нет `routeTemplateId` / нет items с `qtyPlan > 0`,
  /// либо все операции — `SALARY_ONLY` без ставок. В этом случае
  /// `operationPlanWarnings` объясняет причину человекочитаемо.
  ///
  /// Сознательно отдельно от `costEstimateTotalRub`: «себестоимость
  /// заказа» (`OrderCostEstimate`) — это финансовый документ с
  /// материалами/фурнитурой/нанесениями + (на этапе 3) LABOR-строкой.
  /// «План операций» — это плановая оценка стоимости и времени
  /// **до** запуска заказа, без поставщиков и без USD-курса.
  operationCostPlanRub      Decimal?  @db.Decimal(14, 2)
  /// Этап 2 «План операций»: суммарное плановое время выполнения
  /// заказа в **секундах** (целое). Считается тем же helper-ом, что и
  /// `operationCostPlanRub` (см. `OrderOperationPlanService.calculateForOrder`).
  /// `null` — план не считался / нет норм времени по выбранным
  /// операциям. Хранится `Int` — точность одной секунды достаточна,
  /// в UI форматируется как «2 ч 16 мин» (см.
  /// `apps/web/lib/operations-time-norm.ts::formatDurationSec`).
  operationTimePlanSec      Int?
  /// Этап 2 «План операций»: когда snapshot был посчитан в последний
  /// раз. Заполняется при каждом вызове `recalculateAndWrite` —
  /// даже если план получился `null` (нет маршрута / нет норм). UI
  /// показывает «Рассчитано: …» в карточке заказа.
  operationPlanCalculatedAt DateTime?
  /// Этап 2 «План операций»: JSON-массив человекочитаемых warnings
  /// («Нет ставки операции "Распошив" для размера XL», «Маршрут не
  /// выбран — план операций не рассчитан» и т.п.). `null` — warnings
  /// нет (план посчитан без замечаний) или snapshot ещё не считался.
  /// UI карточки заказа отрисовывает компактный блок «План операций
  /// неполный» — первые 3 warnings + «ещё N».
  ///
  /// Хранится `Json?` (а не отдельной таблицей), потому что:
  ///   - warnings — derived-сообщения для оператора, без бизнес-семантики
  ///     (filter/sort/aggregate по ним не нужен);
  ///   - длина списка ограничена количеством шагов × размеров — для
  ///     MVP это десятки строк, JSONB хранит компактно;
  ///   - расширение формата (от `string[]` к `{ message, severity, … }[]`)
  ///     не требует миграции схемы.
  operationPlanWarnings     Json?

  /// Этап «Очередь выдачи кроя по размерам» (см.
  /// `apps/api/src/modules/order-cut-issue-rules/*`,
  /// `prisma/schema.prisma::OrderCutIssueRule`,
  /// `docs/domain.md §«Очередь выдачи кроя»`).
  ///
  /// Менеджер заказа может задать «первую очередь выдачи кроя по
  /// размерам» (`S — 70 шт`, `M — 50 шт`, `4XL — 100 шт`). Пока хотя
  /// бы одна строка очереди не выполнена (`issuedQty < requiredQty`),
  /// `PassportsService.issueToEmployee` пускает только паспорта тех
  /// размеров, по которым ещё есть «недовыданный» остаток. Остальные
  /// размеры блокируются `OrderCutIssueRuleViolationException` (409
  /// `ORDER_CUT_ISSUE_RULE_VIOLATION`). После того как все строки
  /// выполнены, проверка отключается, выдача снова свободная.
  ///
  /// Контур независим от `CutReleasePolicy` (см. ниже): порядок
  /// проверок в `issueToEmployee` — `OrderCutIssueRule` →
  /// `CutReleasePolicy`. Cascade удаление от заказа — без заказа
  /// очередь смысла не имеет.
  cutIssueRules OrderCutIssueRule[]

  /// Этап «Фактический расход материалов по заказу» (см.
  /// `model MaterialIssue` ниже,
  /// `apps/api/src/modules/material-issues/*`,
  /// `docs/api.md §«Material issues»`).
  ///
  /// Документы фактического списания материалов в производство.
  /// MVP-итерация — ручная фиксация расхода без проверки складских
  /// остатков, без FIFO/LIFO и без автосписания при выдаче кроя.
  /// Cascade — без заказа документ расхода смысла не имеет.
  materialIssues       MaterialIssue[]
  /// Документы возврата / сторно по проведённым `MaterialIssue`
  /// этого заказа (см. `model MaterialIssueReturn` ниже). Cascade —
  /// без заказа возврат теряет смысл.
  materialIssueReturns MaterialIssueReturn[]

  /// Этап «Склад выпуска готовой продукции» (см.
  /// `apps/api/src/modules/orders/orders.service.ts::create`/`update`,
  /// UI — `/admin/orders/new`, `/admin/orders/[id]/edit`,
  /// `docs/current-state.md §«Склад выпуска готовой продукции»`).
  ///
  /// Управленческое поле: на какой склад менеджер планирует
  /// выпустить готовую продукцию по этому заказу (например,
  /// «Склад готовой продукции B2B», «Склад маркетплейсов»,
  /// «Склад образцов»). Это **НЕ склад материалов** — изменение
  /// поля никак не затрагивает `StockBalance` / `StockMovement`,
  /// `MaterialIssue`, `PurchaseReceipt`, `WorkshopNeed`,
  /// `ProductionCostV2Service`.
  ///
  /// Дизайн поля:
  ///   - nullable + `onDelete: SetNull` — деактивация / удаление
  ///     карточки склада не сносит заказ, live-связь обнуляется,
  ///     UI показывает «Не выбран»;
  ///   - привязка валидируется на backend: при `null` сбрасывается,
  ///     при непустом id проверяется existence и `isActive = true`,
  ///     иначе 400 `WAREHOUSE_NOT_FOUND` / 409
  ///     `WAREHOUSE_INACTIVE`. Это управленческое поле, поэтому
  ///     меняется на любом статусе заказа (без `ORDER_LOCKED`-guard);
  ///   - именованная relation `OrderFinishedGoodsWarehouse` —
  ///     обязательна, чтобы Prisma могла отличить эту связь от
  ///     `Cell.warehouse` / `StockBalance.warehouse` /
  ///     `StockMovement.warehouse` на той же стороне `Warehouse`.
  finishedGoodsWarehouseId String?
  finishedGoodsWarehouse   Warehouse? @relation("OrderFinishedGoodsWarehouse", fields: [finishedGoodsWarehouseId], references: [id], onDelete: SetNull)

  /// Этап «Foundation готовой продукции» (см. `model FinishedGoodsBalance` /
  /// `model FinishedGoodsMovement` ниже,
  /// `apps/api/src/modules/finished-goods/*`,
  /// `docs/current-state.md §«Готовая продукция»`).
  ///
  /// Это **отдельный контур** от материалов: `StockBalance` /
  /// `StockMovement` / `MaterialIssue` / `PurchaseReceipt` /
  /// `StockAdjustment` / `StockTransfer` в этом flow не участвуют.
  /// Cascade — без заказа остаток/движение готовой продукции смысла
  /// не имеют.
  finishedGoodsBalances  FinishedGoodsBalance[]
  finishedGoodsMovements FinishedGoodsMovement[]

  /// Foundation полуфабриката (см. `model WorkInProgressBalance` /
  /// `model WorkInProgressMovement` ниже). Cascade — снос заказа
  /// сносит и его крой/движения по крою.
  workInProgressBalances  WorkInProgressBalance[]
  workInProgressMovements WorkInProgressMovement[]

  /// Документы и строки отгрузки готовой продукции по заказу (см.
  /// `model FinishedGoodsShipment` / `FinishedGoodsShipmentLine`,
  /// `apps/api/src/modules/finished-goods/finished-goods.service.ts::createShipmentForOrder`).
  /// Cascade — отгрузка живёт только в рамках заказа.
  finishedGoodsShipments     FinishedGoodsShipment[]
  finishedGoodsShipmentLines FinishedGoodsShipmentLine[]

  /// Упрощённая политика учёта материалов и фурнитуры в себестоимости
  /// заказа (см. `docs/current-state.md §«Давальческое сырьё клиента»`,
  /// `apps/api/src/modules/orders/orders.service.ts::create / update`,
  /// `apps/api/src/modules/costs/costs.service.ts`,
  /// `apps/web/components/orders/summary/build-order-summary-rows.ts`).
  ///
  /// Значения:
  ///   - `INCLUDE` — материалы и фурнитура учитываются в себестоимости
  ///     заказа и в production cost. Это default для всех новых и
  ///     исторических заказов (backward-compat).
  ///   - `EXCLUDE` — давальческое сырьё / фурнитура клиента: расчёт
  ///     потребности материалов и фурнитуры всё равно выполняется,
  ///     складские движения работают как раньше, но финансовое
  ///     включение MATERIAL / HARDWARE в себестоимость отключается
  ///     (план = `null` / `0`, факт = `0`, дельта = `null`).
  ///
  /// Поле сознательно `String` (а не Prisma enum): в проекте многие
  /// статусы/режимы хранятся строкой (`MaterialIssue.status`,
  /// `Order.customerCurrency`), и расширение списка значений в
  /// будущем не потребует миграции схемы.
  ///
  /// Это **только** про себестоимость. `WorkshopNeed`,
  /// `OrderMaterialRequirement`, `MaterialIssue`, `MaterialIssueReturn`,
  /// `StockBalance`, `StockMovement`, `StockAdjustment`, `StockTransfer`
  /// в этом контуре не меняются — складская и логистическая часть
  /// продолжает работать как раньше, чтобы клиенту можно было
  /// сообщить количество материалов и фурнитуры по его заказу.
  materialsAndHardwareCostPolicy String @default("INCLUDE")

  /// Inline-создание изделия из формы заказа (см.
  /// `apps/web/app/admin/orders/new/admin-create-order-form.tsx`,
  /// `apps/api/src/modules/orders/orders.service.ts::create`).
  ///
  /// Режим заведения «Изделия» по заказу:
  ///   - `EXISTING_PATTERN`         — стандартный путь, default;
  ///   - `CREATE_FOR_CALCULATION`   — backend в той же транзакции
  ///     create-заказа автоматически создаёт `PatternItem` +
  ///     `PatternMaterialArea[]` + technical Product;
  ///   - `SEND_TO_CONSTRUCTOR`      — зарезервировано (UI-заглушка).
  productCreationMode       String   @default("EXISTING_PATTERN")
  /// Стоимость разработки лекала из inline-сценария «Сделать расчёт»
  /// (см. `productCreationMode = CREATE_FOR_CALCULATION`).
  /// Управленческое поле — НЕ участвует в `OrderCostEstimate` /
  /// `WorkshopNeed` / `OrderOperationPlan` / складских движениях.
  patternDevelopmentCostRub Decimal? @db.Decimal(12, 2)

  @@index([status])
  @@index([orderDate])
  @@index([createdAt])
  @@index([routeTemplateId])
  @@index([techCardId])
  @@index([patternItemId])
  @@index([clientId])
  @@index([dueDate])
  @@index([companyDivisionId])
  @@index([finishedGoodsWarehouseId])
  @@index([materialsAndHardwareCostPolicy])
  @@index([productCreationMode])
}

/// Карточка клиента (управленческий справочник, см. `docs/domain.md
/// §«Клиенты»`, добавлено вместе с UI `/admin/clients`).
///
/// Дизайн сознательно простой: одна таблица, минимум полей, никакой
/// CRM-логики. Удаление out-of-scope — менеджер мягко гасит карточку
/// через `isActive = false`. Уникальность `name` НЕ требуется — у двух
/// разных клиентов вполне может быть одно человеческое имя.
model Client {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  comment   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([isActive])
  @@index([name])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  sizeId    String
  qtyPlan   Int

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  size    Size    @relation(fields: [sizeId], references: [id])

  @@unique([orderId, productId, sizeId])
  @@index([productId, sizeId])
}

/// Этап «Очередь выдачи кроя по размерам» (см.
/// `apps/api/src/modules/order-cut-issue-rules/*`,
/// `docs/domain.md §«Очередь выдачи кроя»`,
/// `docs/order-flow.md §«Очередь выдачи кроя»`).
///
/// Менеджер заказа задаёт «первую очередь выдачи кроя по размерам» —
/// сколько штук какого размера должно быть выдано в первую очередь
/// (`requiredQty`). Бэкенд materializes счётчик `issuedQty` (атомарный
/// инкремент в той же транзакции, что и `PassportsService.issueToEmployee`),
/// и пока хотя бы одна активная строка очереди не выполнена
/// (`issuedQty < requiredQty`), выдача паспортов «не очередных»
/// размеров блокируется адресной 409-кой
/// `ORDER_CUT_ISSUE_RULE_VIOLATION`.
///
/// Дизайн (см. ТЗ «Очередь выдачи кроя»):
///   - правило применяется ТОЛЬКО на первой операции маршрута
///     (`Passport.currentRouteStepIndex === 0`) или операциях
///     категории `CUTTING` — точно так же, как `CutReleasePolicy`;
///   - порядок проверок в `issueToEmployee`:
///     `OrderCutIssueRule` → `CutReleasePolicy`. Если очередь
///     блокирует выдачу, до политики проверка не доходит;
///   - `isActive = false` означает «правило выключено»: счётчики
///     остаются для аудита, но никаких проверок выдачи не
///     происходит. Деактивация не сбрасывает `issuedQty` (см. ТЗ
///     §«Ограничения / не делать reset counters в MVP»);
///   - bulk save = source of truth формы: строки, не пришедшие в
///     bulk-payload, переводятся в `isActive = false`. Полное
///     отключение очереди — `POST /api/orders/:id/cut-issue-rules/disable-all`
///     (атомарно `isActive = false` для всех строк заказа).
///   - НЕ дублируем `CutReleasePolicy`: тот контур — глобальный
///     управленческий стоп, а это — порядок выдачи внутри одного
///     заказа.
///
/// Уникальность `(orderId, queueIndex, sizeId)` гарантирована БД: в
/// рамках одной «очереди» (партии выдачи) на один размер может
/// быть только одна строка. Между очередями один и тот же размер
/// может встречаться много раз (например, план 1000: очередь №1 —
/// 150, очередь №2 — 850). Это упрощает атомарный consume через
/// conditional `updateMany` (`OrderCutIssueRulesService.consumeInTx`).
///
/// «Текущая очередь» = минимальный `queueIndex`, у которого есть
/// хоть одна активная строка с `issuedQty < requiredQty`. Блокировка
/// и инкремент выдачи всегда работают в её рамках; после закрытия
/// «текущей» автоматически становится следующая.
model OrderCutIssueRule {
  id          String   @id @default(cuid())
  orderId     String
  /// Индекс очереди (1-based). Менеджер может последовательно
  /// добавлять очереди; в каждой задаётся свой набор размеров.
  /// `queueIndex >= 1`. Строки с одним и тем же `(orderId, sizeId)`
  /// могут существовать в разных очередях — суммарно они
  /// ограничены планом размера в заказе.
  queueIndex  Int      @default(1)
  sizeId      String
  /// Сколько штук этого размера должно быть выдано в этой очереди.
  /// Валидация на сервисе: `requiredQty > 0`,
  /// `Σ requiredQty по всем очередям этого размера <= qtyPlan`
  /// (по `OrderItem`), `requiredQty >= issuedQty` при апдейте уже
  /// существующей строки (нельзя «откусить» уже выданный объём).
  requiredQty Int
  /// Materialized счётчик «уже выдано в рамках этой строки».
  /// Инкрементится атомарно в `OrderCutIssueRulesService.consumeInTx`
  /// через conditional `updateMany` (защита от race): инкремент
  /// срабатывает только если `isActive = true` и
  /// `issuedQty + qty <= requiredQty`. Не сбрасывается при
  /// деактивации (см. ТЗ §«не делать reset counters в MVP»).
  issuedQty   Int      @default(0)
  /// Управляемый менеджером порядок строк в UI и сообщении
  /// блокировки. Бэкенд сортирует строки по
  /// `(sortOrder ASC, Size.sortOrder ASC, Size.code ASC)` — последние
  /// два уровня обеспечивают стабильный порядок при равных
  /// `sortOrder` (или при дефолтных нулях).
  sortOrder   Int      @default(0)
  /// Активность строки. `false` = «правило выключено» (см. описание
  /// модели). Подсчёт `unfinished rows` в сервисе игнорирует
  /// неактивные строки.
  isActive    Boolean  @default(true)
  /// Кто завёл/обновил строку (менеджер / мастер цеха / админ). Без
  /// FK по тем же причинам, что и `CutReleasePolicy.createdById` —
  /// учётка может быть деактивирована, а строка очереди должна жить
  /// дальше для аудита.
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  size  Size  @relation(fields: [sizeId], references: [id], onDelete: Restrict)

  @@unique([orderId, queueIndex, sizeId])
  @@index([orderId, queueIndex, isActive])
  @@index([orderId, isActive])
  @@index([sizeId])
}

// =========================
// PASSPORT (AGGREGATE ROOT)
// =========================

model Passport {
  id     String @id @default(cuid())
  number String @unique
  qrCode String @unique

  orderId    String
  productId  String
  sizeId     String
  color      String
  rollNumber String
  cutDate    DateTime
  qtyPlan    Int
  qtyCut     Int
  qtyDefect  Int            @default(0)
  qtyGood    Int
  status     PassportStatus @default(CREATED)

  currentOperationId    String?
  currentEmployeeId     String?
  /// Текущая ячейка, в которой физически лежит партия (см. ADR-0010).
  /// Один паспорт = одна текущая ячейка (или null, если ещё не размещён).
  currentCellId         String?
  /// Soft-route MVP: индекс текущего шага в `OrderRouteStep[]` заказа
  /// (0-based). Заполняется в `PassportsService.create`, если у заказа
  /// уже есть snapshot маршрута, и обновляется в `scanOnOperation`,
  /// когда отсканированная операция совпадает с одной из ступеней
  /// маршрута. Никаких enforcement: `null` означает «маршрут не
  /// фиксировался / шаг неизвестен», существующий flow это не ломает.
  currentRouteStepIndex Int?

  cutterId  String
  creatorId String

  pdfUrl    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order            Order      @relation(fields: [orderId], references: [id])
  product          Product    @relation(fields: [productId], references: [id])
  size             Size       @relation(fields: [sizeId], references: [id])
  currentOperation Operation? @relation("PassportCurrentOperation", fields: [currentOperationId], references: [id])
  currentEmployee  Employee?  @relation("PassportCurrentEmployee", fields: [currentEmployeeId], references: [id])
  currentCell      Cell?      @relation("PassportCurrentCell", fields: [currentCellId], references: [id])
  cutter           Employee   @relation("PassportCutter", fields: [cutterId], references: [id])
  creator          Employee   @relation("PassportCreator", fields: [creatorId], references: [id])

  events   PassportEvent[]
  entries  OperationEntry[]
  boxItems BoxItem[]
  defects  PassportDefect[]

  /// Этап «Фактический расход материалов по заказу» (см.
  /// `model MaterialIssue` ниже). Документы расхода, опционально
  /// привязанные к конкретному паспорту (production batch). На MVP
  /// поле noop с точки зрения авто-списания — оставлено для
  /// аналитики и возможного расширения в следующих итерациях.
  /// `onDelete: SetNull` со стороны `MaterialIssue.passportId` —
  /// снос паспорта не сносит документ расхода.
  materialIssues       MaterialIssue[]
  /// Документы возврата / сторно `MaterialIssueReturn`, опционально
  /// привязанные к этому паспорту (см. `model MaterialIssueReturn`
  /// ниже). `onDelete: SetNull` — удаление паспорта не сносит
  /// исторический документ возврата.
  materialIssueReturns MaterialIssueReturn[]

  /// Foundation готовой продукции (см. `model FinishedGoodsMovement`
  /// ниже). Один паспорт → одно `PRODUCTION_RECEIPT` движение в
  /// момент `PassportStatus = PACKED` (idempotent через
  /// `sourceKey = PACKED_PASSPORT:<passportId>`). `onDelete: SetNull`
  /// — снос паспорта не сносит исторический выпуск.
  finishedGoodsMovements FinishedGoodsMovement[]

  /// Foundation полуфабриката (см. `model WorkInProgressMovement`).
  /// `onDelete: SetNull` — снос паспорта оставляет историю движений
  /// кроя без `passportId` (исторический след для аудита).
  workInProgressMovements WorkInProgressMovement[]

  @@index([status, currentOperationId])
  @@index([orderId])
  @@index([sizeId, status])
  @@index([createdAt])
  @@index([currentCellId])
}

// =========================
// EVENTS
// =========================

model PassportEvent {
  id              String            @id @default(cuid())
  passportId      String
  type            PassportEventType
  operationId     String?
  fromOperationId String?
  employeeId      String?
  qty             Int?
  defectQty       Int?
  cellId          String?
  boxId           String?
  payload         Json?
  createdAt       DateTime          @default(now())

  passport      Passport   @relation(fields: [passportId], references: [id])
  operation     Operation? @relation("EventOperation", fields: [operationId], references: [id])
  fromOperation Operation? @relation("EventFromOperation", fields: [fromOperationId], references: [id])
  employee      Employee?  @relation("EventEmployee", fields: [employeeId], references: [id])
  cell          Cell?      @relation(fields: [cellId], references: [id])
  box           Box?       @relation(fields: [boxId], references: [id])

  @@index([passportId, createdAt])
  @@index([type, createdAt])
  @@index([operationId, createdAt])
}

// =========================
// PAYROLL
// =========================

model OperationEntry {
  id              String        @id @default(cuid())
  passportId      String
  operationId     String
  employeeId      String
  qty             Int
  ratePerUnit     Decimal       @db.Decimal(12, 2)
  amount          Decimal       @db.Decimal(12, 2)
  status          EntryStatus   @default(PENDING_RELEASE)
  approvalMode    ApprovalMode  @default(AFTER_RELEASE)
  /// Дискриминатор источника, по которому возникло начисление.
  /// Используется как часть ключа идемпотентности (см. ADR-0012).
  sourceEventType EarningSource @default(OPERATION_TRANSITION)
  /// Опциональная ссылка на «триггер» (`PassportEvent.id` для пошивных
  /// переходов; для immediate-раскроя не используется). Не часть
  /// уникального ключа — нужна только для аудита.
  sourceEventId   String?
  createdAt       DateTime      @default(now())
  approvedAt      DateTime?

  passport  Passport  @relation(fields: [passportId], references: [id])
  operation Operation @relation(fields: [operationId], references: [id])
  employee  Employee  @relation(fields: [employeeId], references: [id])

  /// PHASE 3 «PayrollPayout»: обратные строки выплат, в которые попало
  /// это сдельное начисление. Без `@@unique` со стороны строки —
  /// активная уникальность проверяется в сервисе.
  payrollPayoutLines PayrollPayoutLine[]

  /// Идемпотентность сдельных начислений (Шаг 9, ADR-0012):
  /// один и тот же сотрудник не получает второе начисление за ту же
  /// операцию по тому же паспорту в рамках одного и того же источника.
  @@unique([passportId, operationId, employeeId, sourceEventType], name: "OperationEntry_idem")
  @@index([employeeId, status, createdAt])
  @@index([status, createdAt])
  @@index([passportId])
}

/// Окладное начисление за конкретный день для конкретного сотрудника
/// (post-Шаг 18 / Шаг 19, см. ADR-0021, `docs/domain.md §9a`,
/// `docs/erd.md §2.13b`, `docs/api.md §10a`).
///
/// Бизнес-инвариант: «один день — одна окладная запись на человека»
/// (для одного `source`). Закрепляется составным `@@unique` на
/// `(employeeId, date, source)`. На MVP `source = SHIFT_DAY` —
/// единственный путь автогенерации (см. `SalaryService.syncDailyForEmployee`):
///
///   - если у сотрудника `compensationType ∈ { SALARY, MIXED }`,
///   - и в этот день существует хотя бы одна `ShiftSession`
///     (даже не закрытая, даже несколько сессий подряд),
///   - то создаётся (или обновляется по `salaryPerShift`) ровно
///     одна запись с `amount = Employee.salaryPerShift`.
///
/// `editedManually = true` означает, что начальник производства
/// руками поправил сумму (переработка / ушёл раньше / полсмены) и
/// автоматическая sync-логика её больше не затирает: см.
/// `SalaryService.syncDailyForEmployee` ниже.
model SalaryEntry {
  id                 String            @id @default(cuid())
  employeeId         String
  /// Дата без времени (Postgres `DATE`). Нормализуется на сервере к
  /// календарной дате: одна запись на сотрудника на день, независимо
  /// от часового пояса смены и количества смен в этот день.
  date               DateTime          @db.Date
  /// Сумма выплаты за этот день. По умолчанию = `Employee.salaryPerShift`
  /// в момент первой sync; ручная правка через `PATCH
  /// /api/salary/:id` заменяет её и поднимает `editedManually = true`.
  amount             Decimal           @db.Decimal(12, 2)
  source             SalaryEntrySource @default(SHIFT_DAY)
  /// Флаг ручной правки. Sync-логика проверяет его перед тем, как
  /// синхронизировать `amount` со ставкой сотрудника: если стоит
  /// `true`, сумма НЕ перезаписывается. Снимается обратно через
  /// `?reset=true` в PATCH (см. `docs/api.md §10a`).
  editedManually     Boolean           @default(false)
  /// Свободный комментарий начальника производства. Не обязателен,
  /// но помогает отличить «переработку» от «ушёл раньше» в ведомости.
  managerComment     String?           @db.Text
  /// Кто последний правил запись руками. `null` для автогенерируемых
  /// нерасправленных записей. Используется для аудит-подсветки в UI
  /// и как логическая «ответственность» в спорных кейсах.
  editedByEmployeeId String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  employee Employee  @relation(fields: [employeeId], references: [id])
  editedBy Employee? @relation("SalaryEntryEditor", fields: [editedByEmployeeId], references: [id])

  /// PHASE 3 «PayrollPayout»: обратные строки выплат, в которые попало
  /// это окладное начисление. Без `@@unique` со стороны строки —
  /// активная уникальность проверяется в сервисе.
  payrollPayoutLines PayrollPayoutLine[]

  @@unique([employeeId, date, source], name: "SalaryEntry_employee_date_source_uniq")
  @@index([employeeId, date])
  @@index([date])
}

/// Выплата зарплаты сотруднику за период (PHASE 3, см.
/// `docs/erd.md §2.9`, `docs/domain.md §10.7`).
///
/// Отдельный документ, который менеджер формирует поверх уже
/// созданных начислений (`OperationEntry` / `SalaryEntry`):
/// внутри `PayrollPayoutLine` лежит набор строк за период,
/// snapshot-ом фиксируются денежные итоги (`amountPieceworkRub`,
/// `amountSalaryRub`, `amountTotalRub`). Сами таблицы начислений
/// **не помечаются как «выплачено»** — статус выплаты живёт здесь.
///
/// Жизненный цикл — `PayrollPayoutStatus`:
/// `DRAFT → ISSUED → (ACKNOWLEDGED | CANCELLED)` или
/// `DRAFT → CANCELLED`. Активную уникальность «одна строка
/// начисления — максимум в одной не-CANCELLED выплате» проверяет
/// сервис: на уровне БД `@@unique` на `operationEntryId` /
/// `salaryEntryId` НЕ ставится — это сломало бы пере-включение
/// строки в новую выплату после `CANCELLED`.
model PayrollPayout {
  id                       String              @id @default(cuid())
  employeeId               String
  /// Период, за который сформирована выплата. Хранится как
  /// `DATE` (без времени), сравнивается с `OperationEntry.createdAt`
  /// (`occurredOn`-снимок строки) и `SalaryEntry.date`.
  periodFrom               DateTime            @db.Date
  periodTo                 DateTime            @db.Date
  status                   PayrollPayoutStatus @default(DRAFT)
  /// Snapshot-итоги по выплате. Заполняются при `recompute`/`issue`
  /// и больше не пересчитываются автоматически после `ISSUED`.
  amountPieceworkRub       Decimal             @default(0) @db.Decimal(12, 2)
  amountSalaryRub          Decimal             @default(0) @db.Decimal(12, 2)
  amountTotalRub           Decimal             @default(0) @db.Decimal(12, 2)
  managerComment           String?             @db.Text
  createdAt                DateTime            @default(now())
  createdById              String
  issuedAt                 DateTime?
  issuedById               String?
  acknowledgedAt           DateTime?
  acknowledgedByEmployeeId String?
  cancelledAt              DateTime?
  cancelledById            String?
  cancelReason             String?             @db.Text
  updatedAt                DateTime            @updatedAt

  employee             Employee                     @relation("PayrollPayoutEmployee", fields: [employeeId], references: [id])
  createdBy            Employee                     @relation("PayrollPayoutCreatedBy", fields: [createdById], references: [id])
  issuedBy             Employee?                    @relation("PayrollPayoutIssuedBy", fields: [issuedById], references: [id])
  acknowledgedBy       Employee?                    @relation("PayrollPayoutAcknowledgedBy", fields: [acknowledgedByEmployeeId], references: [id])
  cancelledBy          Employee?                    @relation("PayrollPayoutCancelledBy", fields: [cancelledById], references: [id])
  lines                PayrollPayoutLine[]
  /// PHASE 3 STEP 6: строки документа начисления, из которых
  /// была сформирована эта выплата (`PayrollAccrualDocumentLine.payoutId`).
  accrualDocumentLines PayrollAccrualDocumentLine[]

  @@index([employeeId, status])
  @@index([periodFrom, periodTo])
  @@index([status, createdAt])
}

/// Строка выплаты `PayrollPayout`. Ровно одна из
/// (`operationEntryId`, `salaryEntryId`) обязана быть заполнена;
/// `kind` дублирует выбор enum-ом для удобства фильтров.
///
/// `snapshot` хранит свёрнутый JSON-вид начисления на момент
/// добавления строки в выплату (паспорт/операция/сотрудник/qty/rate/
/// amount для PIECEWORK; date/source/amount для SALARY) — чтобы
/// после правки исходного начисления / справочников выплата всё
/// ещё показывала «как было выдано».
///
/// `@@unique` на `operationEntryId` / `salaryEntryId` сознательно НЕ
/// ставится: после `CANCELLED` выплаты строки начислений снова
/// доступны. Активную уникальность («строка в максимум одной
/// не-CANCELLED выплате») проверяет `PayrollPayoutsService`.
model PayrollPayoutLine {
  id               String                @id @default(cuid())
  payoutId         String
  kind             PayrollPayoutLineKind
  operationEntryId String?
  salaryEntryId    String?
  amountRub        Decimal               @db.Decimal(12, 2)
  /// Дата события начисления — `OperationEntry.createdAt` для
  /// сдельных и `SalaryEntry.date` для окладных, нормализованные
  /// до календарной даты. Используется для отчётов и фильтрации
  /// в UI.
  occurredOn       DateTime              @db.Date
  snapshot         Json
  createdAt        DateTime              @default(now())

  payout         PayrollPayout   @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  operationEntry OperationEntry? @relation(fields: [operationEntryId], references: [id])
  salaryEntry    SalaryEntry?    @relation(fields: [salaryEntryId], references: [id])

  @@index([payoutId])
  @@index([operationEntryId])
  @@index([salaryEntryId])
  @@index([kind, occurredOn])
}

/// Документ начисления зарплаты (PHASE 3 STEP 6).
///
/// Менеджер нажимает «Начислить зарплату», указывает `accrualDate`
/// (дату расчёта включительно). Система формирует DRAFT-документ
/// со списком сотрудников и суммами к выплате на эту дату:
/// учитываются только операции и смены до `accrualDate` включительно.
/// Строки документа — `PayrollAccrualDocumentLine`. После проведения
/// (status → PAID) для каждой строки может быть создан
/// индивидуальный `PayrollPayout`.
///
/// Жизненный цикл: `DRAFT → PAID | CANCELLED`.
model PayrollAccrualDocument {
  id String @id @default(cuid())

  /// Дата расчёта включительно. Учитываются только `OperationEntry`
  /// и `SalaryEntry` с датой ≤ `accrualDate`.
  accrualDate DateTime                     @db.Date
  status      PayrollAccrualDocumentStatus @default(DRAFT)

  /// Snapshot-итоги по документу. Заполняются при формировании и
  /// пересчёте строк. После PAID не пересчитываются автоматически.
  totalPieceworkRub Decimal @default(0) @db.Decimal(12, 2)
  totalSalaryRub    Decimal @default(0) @db.Decimal(12, 2)
  totalAdjustRub    Decimal @default(0) @db.Decimal(12, 2)
  totalToPayRub     Decimal @default(0) @db.Decimal(12, 2)

  managerComment String? @db.Text

  createdById   String
  paidById      String?
  cancelledById String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  paidAt       DateTime?
  cancelledAt  DateTime?
  cancelReason String?   @db.Text

  createdBy   Employee  @relation("PayrollAccrualDocumentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  paidBy      Employee? @relation("PayrollAccrualDocumentPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  cancelledBy Employee? @relation("PayrollAccrualDocumentCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  lines PayrollAccrualDocumentLine[]

  @@index([status, accrualDate])
  @@index([createdById])
  @@index([paidById])
  @@index([cancelledById])
  @@index([createdAt])
}

/// Строка документа начисления зарплаты `PayrollAccrualDocument`.
/// По одной строке на сотрудника в документе (`@@unique([documentId, employeeId])`).
///
/// `snapshot` хранит свёрнутый JSON-вид начислений на момент формирования
/// строки — список `OperationEntry`/`SalaryEntry` с суммами, чтобы
/// после правки исходных начислений / справочников документ сохранял
/// «как было посчитано».
///
/// `payoutId` — связь с созданным `PayrollPayout` после перевода
/// документа в PAID. Изначально `null`.
model PayrollAccrualDocumentLine {
  id String @id @default(cuid())

  documentId String
  employeeId String

  amountPieceworkRub Decimal @default(0) @db.Decimal(12, 2)
  amountSalaryRub    Decimal @default(0) @db.Decimal(12, 2)
  manualAdjustRub    Decimal @default(0) @db.Decimal(12, 2)
  manualComment      String? @db.Text
  amountToPayRub     Decimal @default(0) @db.Decimal(12, 2)

  /// Ссылка на индивидуальную выплату, созданную из этой строки
  /// после перевода документа в PAID. `null` до создания выплаты.
  payoutId String?

  /// Snapshot начислений на момент формирования строки.
  snapshot Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  document PayrollAccrualDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  employee Employee               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  payout   PayrollPayout?         @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@unique([documentId, employeeId])
  @@index([employeeId])
  @@index([payoutId])
  @@index([documentId])
}

// =========================
// CELLS (WMS light)
// =========================

/// Склад — управленческая группировка ячеек физического хранения.
/// Введён вместе с экраном `/admin/warehouses` (см. `docs/domain.md §16`,
/// `docs/erd.md §2.13a`, `docs/api.md §15`). Сама модель ячеек и flow
/// размещения паспорта (`POST /api/passports/:id/place`) не меняются —
/// `Cell.warehouseId` опционален и допускает «бесхозные» исторические
/// ячейки, которые менеджер может позже привязать к складу.
model Warehouse {
  id            String   @id @default(cuid())
  /// Человекочитаемое название, видимое в UI (`/admin/warehouses` и
  /// карточка склада). Уникально, чтобы менеджер не путал два склада
  /// с одинаковым именем.
  name          String   @unique
  /// Короткий код склада (например, `MAIN`, `WH-01`). Опционален —
  /// для маленького цеха достаточно имени; вводится менеджером.
  code          String?  @unique
  isActive      Boolean  @default(true)
  /// Шаблон печатной формы наклейки ячеек этого склада. На MVP — просто
  /// строка/JSON, без рендера: бизнес-логика рендера наклеек появится
  /// позже. См. `docs/domain.md §16` (раздел «Линии и наклейки»).
  /// Хранится как `text` (а не jsonb), чтобы менеджер мог положить
  /// произвольный человекочитаемый шаблон без жёсткой схемы.
  labelTemplate String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cells Cell[]
  lines WarehouseLine[]

  /// Foundation: остатки материала по `WorkshopNeed` (см. `StockBalance`).
  stockBalances  StockBalance[]
  /// Foundation: журнал складских движений (см. `StockMovement`).
  stockMovements StockMovement[]

  /// Заказы покупателя, у которых этот склад выбран как «склад выпуска
  /// готовой продукции» (см. `Order.finishedGoodsWarehouseId`). Это
  /// **management-only** связь: она НЕ создаёт ни `StockBalance`, ни
  /// `StockMovement` — готовая продукция в плоскости склада на этой
  /// итерации не отслеживается. Поле живёт ровно на уровне заказа,
  /// чтобы менеджер мог зафиксировать «куда поедет тираж после
  /// упаковки».
  ///
  /// Именованная relation — обязательна, потому что при удалении
  /// карточки склада мы хотим `SetNull` именно по этой связи, а у
  /// `Cell.warehouse`/`StockBalance.warehouse`/`StockMovement.warehouse`
  /// своё поведение (Restrict/SetNull) и Prisma требует разделять
  /// несколько relation-ов на ту же модель явными именами.
  finishedGoodsOrders Order[] @relation("OrderFinishedGoodsWarehouse")

  /// Foundation готовой продукции (см. `model FinishedGoodsBalance` /
  /// `model FinishedGoodsMovement` ниже,
  /// `apps/api/src/modules/finished-goods/*`). Этот склад — назначение
  /// выпуска готовых изделий по заказу (берётся из
  /// `Order.finishedGoodsWarehouseId` в момент упаковки). На стороне
  /// баланса/движения — `onDelete: SetNull`: деактивация / удаление
  /// карточки склада не сносит исторический выпуск, balance/movement
  /// остаются с `warehouseId = null`.
  finishedGoodsBalances  FinishedGoodsBalance[]
  finishedGoodsMovements FinishedGoodsMovement[]

  /// Foundation полуфабриката (см. `model WorkInProgressBalance` /
  /// `model WorkInProgressMovement` ниже). `onDelete: SetNull` — снос
  /// карточки склада оставляет балансы/движения с `warehouseId = null`.
  workInProgressBalances  WorkInProgressBalance[]
  workInProgressMovements WorkInProgressMovement[]

  /// Back-relation на строки отгрузки готовой продукции (см.
  /// `model FinishedGoodsShipmentLine`). `onDelete: SetNull` со
  /// стороны строки — историческая отгрузка переживает деактивацию
  /// карточки склада с warehouseId = null.
  finishedGoodsShipmentLines FinishedGoodsShipmentLine[]

  @@index([isActive])
}

/// Линия склада — управленческая группировка ячеек по физической полке/ряду
/// (например, линия `A` = ячейки `A1..A20`). Линия принадлежит конкретному
/// складу, но её `code` уникален глобально: оператор сканирует/называет
/// линию без указания склада, и система должна найти её однозначно.
///
/// Связь с `Cell` — one-to-many: линия группирует ячейки, созданные через
/// массовый инструмент `POST /api/warehouses/:id/lines` (см. `docs/api.md §15`).
/// Существующие («бесхозные») ячейки могут быть без линии — `Cell.lineId`
/// nullable, чтобы не ломать миграцию и flow размещения паспорта (ADR-0019).
model WarehouseLine {
  id          String   @id @default(cuid())
  warehouseId String
  /// Глобально уникальный код линии (например, `A`, `B-NORTH`). Уникальность
  /// глобальная, потому что в UI/сканировании линия идентифицируется
  /// одним коротким значением — двух одинаковых не должно быть нигде.
  code        String   @unique
  createdAt   DateTime @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  cells     Cell[]

  @@index([warehouseId])
}

model Cell {
  id          String   @id @default(cuid())
  code        String   @unique
  qrCode      String   @unique
  active      Boolean  @default(true)
  /// Склад-владелец ячейки. Nullable: исторические/нераспределённые
  /// ячейки допустимы, чтобы не ломать существующий flow `place`
  /// (см. ADR-0019 и `docs/domain.md §16`). Менеджер может позже
  /// привязать такую ячейку к конкретному складу через
  /// `PATCH /api/cells/:id`.
  warehouseId String?
  /// Линия склада (если ячейка создана через массовый инструмент линий).
  /// Nullable: исторические/одиночные ячейки могут жить без линии,
  /// flow размещения паспорта это не задевает.
  lineId      String?
  /// Порядковый номер ячейки внутри линии (1..N). Имеет смысл только
  /// вместе с `lineId`. Используется для сортировки и для проверки
  /// инварианта «уникальность пары (lineId, lineIndex)».
  lineIndex   Int?
  createdAt   DateTime @default(now())

  warehouse                Warehouse?                @relation(fields: [warehouseId], references: [id])
  line                     WarehouseLine?            @relation(fields: [lineId], references: [id], onDelete: SetNull)
  events                   PassportEvent[]
  currentPassports         Passport[]                @relation("PassportCurrentCell")
  /// Этап 7А «Приёмка поставок» (см. `model PurchaseReceiptLine`
  /// ниже, `apps/api/src/modules/purchase-receipts/*`).
  /// Размещение принятой партии материала: одна строка приёмки —
  /// одна ячейка хранения. Сознательная граница MVP: это «куда
  /// положили», а НЕ полноценный складской остаток. `CellContent`
  /// этой связью НЕ затрагивается, движок паспортов / production
  /// продолжает работать как раньше. `onDelete: SetNull` со
  /// стороны `PurchaseReceiptLine.cellId`: удаление ячейки
  /// (на MVP не делается) не сносит документ приёмки.
  purchaseReceiptLines     PurchaseReceiptLine[]
  /// Этап «Фактический расход материалов по заказу» (см.
  /// `model MaterialIssueLine` ниже). Опционально на строке
  /// расхода фиксируется ячейка, откуда материал выдан в крой —
  /// это аналитический срез (НЕ движение остатков). `onDelete:
  /// SetNull` со стороны `MaterialIssueLine.cellId` — удаление
  /// ячейки не сносит исторический документ расхода.
  materialIssueLines       MaterialIssueLine[]
  /// Строки документов возврата `MaterialIssueReturnLine`,
  /// опционально привязанные к ячейке (см. `model
  /// MaterialIssueReturnLine` ниже). `onDelete: SetNull` —
  /// удаление ячейки не сносит исторический возврат.
  materialIssueReturnLines MaterialIssueReturnLine[]

  /// Foundation: остатки по ячейке (MVP — привязка к `WorkshopNeed`).
  stockBalances  StockBalance[]
  stockMovements StockMovement[]

  /// Foundation готовой продукции (см. `model FinishedGoodsBalance` /
  /// `model FinishedGoodsMovement` ниже). На текущей итерации
  /// `cellId` готовой продукции всегда `null`, связи держим ради
  /// будущей итерации «размещение готовой продукции по ячейкам».
  /// `onDelete: SetNull` — снос ячейки не валит исторический выпуск.
  finishedGoodsBalances  FinishedGoodsBalance[]
  finishedGoodsMovements FinishedGoodsMovement[]

  /// Foundation полуфабриката (см. `model WorkInProgressBalance` /
  /// `model WorkInProgressMovement` ниже). `onDelete: SetNull` — снос
  /// ячейки оставляет балансы/движения с `cellId = null`.
  workInProgressBalances  WorkInProgressBalance[]
  workInProgressMovements WorkInProgressMovement[]

  /// Back-relation на строки отгрузки готовой продукции (см.
  /// `model FinishedGoodsShipmentLine`). `onDelete: SetNull` со
  /// стороны строки — снос ячейки не валит историческую отгрузку.
  finishedGoodsShipmentLines FinishedGoodsShipmentLine[]

  /// Размещённые в ячейку коробки упаковки (см. `model Box.placedInCellId`).
  /// `onDelete: SetNull` со стороны коробки — снос ячейки не сносит
  /// историческое размещение.
  placedBoxes Box[] @relation("BoxPlacement")

  @@unique([lineId, lineIndex], name: "Cell_line_index_uniq")
  @@index([warehouseId])
  @@index([lineId])
}

// =========================
// PACKING
// =========================

model Box {
  id          String    @id @default(cuid())
  number      String    @unique
  qrCode      String    @unique
  totalQty    Int       @default(0)
  maxQty      Int       @default(100)
  closedAt    DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  /// Размещение коробки в ячейку склада. После закрытия коробка
  /// показывается в терминале упаковщика как «ждёт размещения», пока
  /// `placedAt` не будет проставлено через
  /// `POST /api/packing/boxes/:id/place` (скан QR ячейки).
  /// `placedInCellId` обнуляется на удалении ячейки (`onDelete: SetNull`),
  /// чтобы не сносить историческую коробку.
  placedAt       DateTime?
  placedInCellId String?

  createdBy    Employee        @relation("BoxCreator", fields: [createdById], references: [id])
  items        BoxItem[]
  events       PassportEvent[]
  placedInCell Cell?           @relation("BoxPlacement", fields: [placedInCellId], references: [id], onDelete: SetNull)

  /// Foundation готовой продукции (см. `model FinishedGoodsMovement`
  /// ниже). Опциональная back-ссылка от движения выпуска к коробке,
  /// в которую упакован паспорт (если коробка известна на момент
  /// фиксации `PACKED`). `onDelete: SetNull` — снос коробки не валит
  /// исторический выпуск.
  finishedGoodsMovements FinishedGoodsMovement[]

  @@index([closedAt])
  @@index([placedAt])
  @@index([placedInCellId])
}

model BoxItem {
  id         String   @id @default(cuid())
  boxId      String
  passportId String   @unique
  qty        Int
  createdAt  DateTime @default(now())

  box      Box      @relation(fields: [boxId], references: [id])
  passport Passport @relation(fields: [passportId], references: [id])

  @@unique([boxId, passportId])
}

// =========================
// QC / DEFECTS (Шаг 7)
// =========================

/// Справочник видов брака (Шаг 7). См. docs/domain.md §10 и
/// docs/erd.md §2.17. Заполняется через `prisma/seed.ts`
/// (`seedDefectTypes`), идемпотентно по `code`.
model DefectType {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int
  createdAt DateTime @default(now())

  defects PassportDefect[]

  @@index([sortOrder])
}

/// Запись брака по конкретному паспорту (Шаг 7). Один паспорт может
/// иметь несколько записей; на каждую — `PassportEvent(DEFECT_RECORDED)`
/// в той же транзакции. См. docs/flows.md §F5 и docs/api.md §8.
model PassportDefect {
  id                  String   @id @default(cuid())
  passportId          String
  defectTypeId        String
  qty                 Int
  comment             String?
  createdByEmployeeId String?
  createdAt           DateTime @default(now())

  passport          Passport   @relation(fields: [passportId], references: [id])
  defectType        DefectType @relation(fields: [defectTypeId], references: [id])
  createdByEmployee Employee?  @relation("DefectCreator", fields: [createdByEmployeeId], references: [id])

  @@index([passportId, createdAt])
  @@index([defectTypeId, createdAt])
}

// =========================
// CUTTING CLOSURE REQUESTS (управленческое закрытие раскроя по размеру)
// =========================

/// Заявка на закрытие раскроя по конкретной размерной строке заказа
/// (`Order × Product × Size`). Помощник раскройщика подаёт её, когда
/// фактический раскрой по размеру меньше плана и дальше кроить не
/// будут. Мастер цеха подтверждает или отклоняет. Подтверждённая
/// заявка (`status = APPROVED`) запрещает выпуск новых паспортов по
/// этой строке (см. `PassportsService.create`, ADR-0018).
///
/// Уникальность одной активной заявки на строку обеспечивает
/// частичный уникальный индекс
/// `cutting_closure_request_active_uniq` на
/// `(orderId, productId, sizeId)` где `status = 'REQUESTED'`. Он
/// создаётся в миграции и идемпотентно — в `PrismaService.onModuleInit`.
/// Точно так же запрещено иметь два `APPROVED` по одной и той же
/// строке (`cutting_closure_request_approved_uniq`).
model CuttingClosureRequest {
  id                    String                      @id @default(cuid())
  orderId               String
  productId             String
  sizeId                String
  status                CuttingClosureRequestStatus @default(REQUESTED)
  reason                String?
  requestedByEmployeeId String
  requestedAt           DateTime                    @default(now())
  reviewedByEmployeeId  String?
  reviewedAt            DateTime?
  reviewerNote          String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  order               Order     @relation(fields: [orderId], references: [id])
  product             Product   @relation(fields: [productId], references: [id])
  size                Size      @relation(fields: [sizeId], references: [id])
  requestedByEmployee Employee  @relation("ClosureRequestRequester", fields: [requestedByEmployeeId], references: [id])
  reviewedByEmployee  Employee? @relation("ClosureRequestReviewer", fields: [reviewedByEmployeeId], references: [id])

  @@index([orderId, productId, sizeId])
  @@index([status, requestedAt])
}

// =========================
// PRINTERS / PRINT JOBS (MVP, см. docs/domain.md §17)
// =========================

/// Принтер, физически стоящий рядом с рабочим местом и обслуживаемый
/// агентом (см. `apps/agent`). Один принтер привязан максимум к одной
/// единице оборудования (`equipmentId`) — это MVP-инвариант: «по
/// рабочему месту мы знаем, на чём печатать». Несколько принтеров на
/// одно `equipmentId` логически разрешены БД-схемой (FK без unique)
/// и могут понадобиться для расширения «один QR-принтер + один
/// принтер этикеток на одно место», но логика выбора в `PrintJobsService`
/// на MVP берёт первый активный — этого достаточно.
///
/// `pairingCode` — короткий одноразовый код, который менеджер
/// генерирует кнопкой «Сгенерировать код» и сообщает оператору.
/// Агент при первом запуске обменивает его через `POST
/// /api/printers/agent/pair` на постоянный `printerId` и `agentToken`.
/// После сpair-а код можно перегенерировать (например, если
/// компьютер агента сменили) — старые токены остаются валидными,
/// но новый агент получит свежие.
///
/// `agentToken` — секрет, которым агент аутентифицируется на
/// `/api/print-jobs/agent` и `/api/printers/agent/heartbeat`. Хранится
/// открытым: на MVP это нормально (внутренняя сеть цеха), позже можно
/// перейти на хеш + bearer (см. ADR-0014).
///
/// `isOnline` и `lastSeenAt` обновляются на каждом heartbeat-е агента
/// (а также при выдаче job-ов). UI `/admin/printers` рисует «онлайн»
/// если `isOnline` и heartbeat был недавно (<60 сек по UTC).
model Printer {
  id                       String      @id @default(cuid())
  name                     String
  type                     PrinterType @default(DEFAULT)
  /// Привязка принтера к роли сотрудника (см. enum `Role`). Один
  /// принтер обслуживает одну роль; одна роль может иметь несколько
  /// принтеров (несколько столов QC и т.п.). NULL = без привязки —
  /// печать через смену не сработает (`PRINTER_NOT_CONFIGURED_FOR_ROLE`),
  /// но принтер можно использовать для тестовой/массовой печати по
  /// явному `printerId`. Эта привязка пришла на замену `equipmentId`
  /// (см. ниже): см. `docs/domain.md §17`, миграция 2026-05-04.
  role                     Role?
  /// DEPRECATED: историческая привязка к рабочему месту (Equipment).
  /// Сохранена ради обратной совместимости с агентом и старыми
  /// инсталляциями: новые UI на этом поле не пишут, но
  /// `PrintJobsService.resolvePrinter` использует его как fallback,
  /// если у сотрудника нет принтера по роли. Можно удалить вместе с
  /// fallback-веткой в следующем major-релизе.
  equipmentId              String?
  isActive                 Boolean     @default(true)
  /// Короткий одноразовый код подключения (UI кнопка «Сгенерировать
  /// код»). NULL после успешного pair-а — pair его очищает, чтобы
  /// случайно не использовать повторно. Может быть выдан повторно
  /// той же кнопкой.
  pairingCode              String?
  /// Постоянный секрет для агента. Заполняется при `pair`-е.
  agentToken               String?
  isOnline                 Boolean     @default(false)
  lastSeenAt               DateTime?
  /// Hostname Windows-машины, на которой запущен агент (см.
  /// `docs/domain.md §17b «Физический Windows-принтер»`). Заполняется
  /// агентом при старте/heartbeat-е через
  /// `POST /api/printers/agent/windows-printers`. Используется в UI
  /// `/admin/printers/:id`, чтобы менеджер видел «какой именно
  /// компьютер сейчас подключён».
  agentHostName            String?
  /// Список системных принтеров Windows (по `Get-Printer.Name`),
  /// присланный агентом. Хранится как `String[]` — простой и
  /// устойчивый формат: новый список целиком перезаписывает старый
  /// при каждом upload-е (без отдельной таблицы и без диффа).
  /// Пустой массив = «агент пока ничего не прислал».
  availableWindowsPrinters String[]    @default([])
  /// Когда агент в последний раз прислал свой список Windows-принтеров.
  /// Отдельно от `lastSeenAt`, чтобы UI мог показать «список устарел»
  /// без подсчёта.
  windowsPrintersUpdatedAt DateTime?
  /// Имя системного принтера Windows, на который должен печатать
  /// агент. Менеджер выбирает его в UI из `availableWindowsPrinters`.
  /// Если `null` — агент не печатает и помечает job как FAILED с
  /// `WINDOWS_PRINTER_NOT_SELECTED`. Выбор валидируется backend-ом:
  /// должен присутствовать в `availableWindowsPrinters` (см.
  /// `WINDOWS_PRINTER_NOT_FOUND_FOR_AGENT`).
  selectedWindowsPrinter   String?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  equipment Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  jobs      PrintJob[]

  @@index([equipmentId, isActive])
  @@index([role, isActive])
  @@index([isOnline])
  @@index([pairingCode])
  @@index([agentToken])
}

/// Задание на печать (`docs/domain.md §17`). Создаётся, когда
/// сотрудник нажимает «Печать» в системе или менеджер запускает
/// «Тестовая печать» в карточке принтера.
///
/// `payloadUrl` — абсолютный URL, по которому агент скачивает
/// готовый HTML/PNG для печати. Backend подставляет существующие
/// печатные endpoint-ы (`/api/passports/:id/print`,
/// `/api/passports/:id/qr`, `/api/packing/boxes/:id/label`,
/// `/api/cells/:id/qr`) — мы НЕ дублируем рендер, а только
/// отправляем агента туда же, куда раньше открывалась вкладка
/// браузера (см. ADR-0010).
model PrintJob {
  id           String         @id @default(cuid())
  printerId    String
  sourceType   PrintJobSource
  /// Идентификатор объекта-источника (`Passport.id`, `Box.id`,
  /// `Cell.id`). Хранится строкой, чтобы не плодить FK на каждый
  /// тип. Для `TEST` может быть пустым.
  sourceId     String?
  payloadUrl   String
  status       PrintJobStatus @default(PENDING)
  errorMessage String?
  createdAt    DateTime       @default(now())
  /// Когда агент забрал job в работу (PATCH PRINTED/FAILED). Для
  /// PENDING — null. Хранится отдельно от `createdAt`, чтобы UI мог
  /// показать «висит давно» без подсчёта.
  completedAt  DateTime?

  printer Printer @relation(fields: [printerId], references: [id], onDelete: Cascade)

  @@index([printerId, status, createdAt])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Production routes (MVP, soft-route)
//
// «Шаблон маршрута производства» = упорядоченный список операций, по
// которому идёт партия. На MVP это «мягкий» механизм:
//   - менеджер заводит шаблоны в `/admin/routes`;
//   - при создании заказа можно опционально привязать `routeTemplateId`;
//   - при `OrdersService.start()` шаблон фиксируется в snapshot
//     `OrderRouteStep[]` (чтобы заказ был «застывшим» — поздняя правка
//     шаблона не меняет уже запущенные заказы);
//   - паспорт хранит `currentRouteStepIndex` как подсказку для UI;
//   - НИКАКОГО enforcement: при scan-е операции, не входящей в маршрут,
//     /work только покажет warning (не блокирует), индекс не меняется.
//
// См. `docs/domain.md §«Маршруты производства»`.
// ---------------------------------------------------------------------------

model RouteTemplate {
  id        String   @id @default(cuid())
  /// Человекочитаемый код шаблона, уникальный (например, "TSHIRT-BASIC").
  /// Используется в API (`GET /api/routes?code=...`) и в UI.
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps  RouteTemplateStep[]
  orders Order[]

  @@index([isActive])
}

model RouteTemplateStep {
  id          String  @id @default(cuid())
  templateId  String
  /// Позиция шага в маршруте (0-based). Уникальна в рамках шаблона —
  /// см. `@@unique([templateId, index])`.
  index       Int
  operationId String
  /// На MVP не используется в enforcement, но фиксируется в данных,
  /// чтобы потом можно было реализовать «можно пропустить шаг».
  isOptional  Boolean @default(false)

  template  RouteTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  operation Operation     @relation(fields: [operationId], references: [id])

  @@unique([templateId, index])
  @@unique([templateId, operationId])
  @@index([operationId])
}

/// Снимок маршрута, привязанный к заказу. Создаётся в
/// `OrdersService.start()`, если у заказа выставлен `routeTemplateId`.
/// После snapshot-а заказ перестаёт зависеть от того, что менеджер
/// сделает с шаблоном дальше (правка / удаление шагов / деактивация).
model OrderRouteStep {
  id          String @id @default(cuid())
  orderId     String
  index       Int
  operationId String

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  operation Operation @relation(fields: [operationId], references: [id])

  @@unique([orderId, index])
  @@index([orderId])
  @@index([operationId])
}

// ---------------------------------------------------------------------------
// Tech cards (MVP, ADR-0022)
//
// «Техкарта» (TechCardTemplate) = справочный шаблон потребностей на одно
// изделие: список материалов и список внешних подрядных размещений
// (OUTSOURCED_SERVICE). Это управленческий справочник, аналогичный
// `RouteTemplate`, но независимый от маршрута:
//   - менеджер заводит техкарты в `/admin/tech-cards`;
//   - при создании заказа можно опционально привязать `techCardId`;
//   - при `OrdersService.start()` строки фиксируются в snapshot-ы
//     `OrderMaterialRequirement[]` и `OrderOutsourceRequirement[]`
//     (поздняя правка шаблона не меняет уже запущенные заказы);
//   - никакого enforcement, никаких формул, никаких размеров —
//     `totalQty = qtyPerUnit * Σ qtyPlan` по строкам заказа.
//
// См. `docs/domain.md §«Техкарты»`, `docs/erd.md §«Tech cards»`, ADR-0022.
// ---------------------------------------------------------------------------

model TechCardTemplate {
  id        String   @id @default(cuid())
  /// Человекочитаемый код техкарты (например, "TSHIRT-MAT"). Уникален
  /// глобально — это управленческий идентификатор, как `RouteTemplate.code`.
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  /// Soft-привязка техкарты к группе номенклатуры (`PatternCategory`).
  /// Этап «Inline-создание изделия из формы заказа»: модалка «Создать
  /// изделие» предзаполняет materialLines по AREA_M2_BY_SIZE параметрам
  /// категории. На остальных формах поле опционально и nullable.
  /// `onDelete: SetNull` — архивация/удаление категории не сносит техкарту.
  patternCategoryId String?
  patternCategory   PatternCategory? @relation(fields: [patternCategoryId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  materialLines  TechCardMaterialLine[]
  outsourceLines TechCardOutsourceLine[]
  orders         Order[]

  @@index([isActive])
  @@index([patternCategoryId])
}

/// Строка материала в шаблоне техкарты. На MVP — простая линейная
/// норма «qtyPerUnit на 1 единицу изделия»; никаких формул или
/// зависимостей от размеров (см. ADR-0022).
///
/// Этап 3 «Потребности цеха» (см. `docs/recon-soft-integration.md
/// §«Этап 3»`): добавлены nullable-поля, которые будут участвовать в
/// будущем расчёте «чистый вес = площадь × плотность × количество»
/// без формулы на этом этапе.
///
/// - `materialRole` — связка с `PatternMaterialArea.materialRole`
///   (свободная строка, валидируется списком `MATERIAL_ROLES` из
///   `@sewing/shared/material-roles`; Prisma enum сознательно НЕ
///   делаем — список расширяется без миграции).
/// - `fabricType` — характеристика полотна / материала (кулирка,
///   двунитка, рибана, футер, пакет, нитки и т.п.). На MVP свободная
///   строка, без справочника.
/// - `densityGsm` / `plannedWidthCm` — параметры тканей; для пакетов /
///   ниток / фурнитуры остаются null.
/// - `colorRule` — правило выбора цвета для этой строки на конкретном
///   заказе (`ORDER_COLOR` / `FIXED_COLOR` / `NO_COLOR`). Хранится
///   строкой по той же причине, что `materialRole`.
/// - `fixedColorText` — заполняется только при `colorRule = FIXED_COLOR`.
///   Сервис сам зачищает поле, если правило другое.
///
/// Все поля сознательно nullable + backward-compatible: старые
/// техкарты остаются валидными, заказы по ним стартуют как раньше.
model TechCardMaterialLine {
  id                            String   @id @default(cuid())
  techCardId                    String
  /// Порядок отображения. Backend нормализует как `(i + 1) * 10` при
  /// записи (см. `TechCardsService.replaceMaterialLines`).
  sortOrder                     Int
  /// Свободное человекочитаемое имя материала (на MVP без справочника).
  name                          String
  /// Единица измерения (м, шт, г, и т.п.). Свободная строка.
  unit                          String
  /// Норма расхода на одну единицу изделия. Положительное число,
  /// валидируется в DTO/сервисе (без БД-check).
  qtyPerUnit                    Decimal  @db.Decimal(12, 4)
  note                          String?
  /// Этап 3: роль материала из общего списка `MATERIAL_ROLES` (см.
  /// `@sewing/shared/material-roles`). Связывается с
  /// `PatternMaterialArea.materialRole` для будущей «Потребности цеха».
  materialRole                  String?
  /// Этап 3: характеристика полотна (кулирка, двунитка, …). Свободная
  /// строка на MVP, без справочника.
  fabricType                    String?
  /// Этап 3: плотность материала, г/м². Заполняется для тканей; для
  /// пакетов / ниток / фурнитуры остаётся null.
  densityGsm                    Int?
  /// Этап 3: плановая ширина рулона, см. Заполняется для тканей; для
  /// пакетов / ниток / фурнитуры остаётся null.
  plannedWidthCm                Int?
  /// Этап 3: правило выбора цвета — `ORDER_COLOR` / `FIXED_COLOR` /
  /// `NO_COLOR`. Хранится строкой; список расширяется без миграции.
  colorRule                     String?
  /// Этап 3: фиксированный цвет — заполняется только при
  /// `colorRule = FIXED_COLOR`. Сервис нормализует null/empty в null
  /// и зачищает поле для других значений `colorRule`.
  fixedColorText                String?
  /// Этап «Фурнитура в техкарте» (см. ТЗ §3): дополнительные
  /// характеристики строки фурнитуры. Имеют смысл только для
  /// `materialRole = PACKAGING` (UI скрывает поля для других ролей,
  /// сервис зачищает их в null при сохранении). Названы явно через
  /// префикс `hardware*`, чтобы не перепутать с `Size`/общим `unit`
  /// и не конфликтовать с другими полями.
  hardwareSizeText              String?
  hardwareMaterialText          String?
  /// Этап «Изображение материала» (см. ТЗ §5): URL/относительный путь
  /// картинки строки материала и опционально оригинальное имя файла.
  /// Хранение URL на MVP — upload сделан отдельной задачей. Поля
  /// nullable + backward-compatible.
  materialImageUrl              String?
  materialImageOriginalFileName String?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  techCard          TechCardTemplate           @relation(fields: [techCardId], references: [id], onDelete: Cascade)
  orderRequirements OrderMaterialRequirement[]

  @@index([techCardId, sortOrder])
  @@index([materialRole])
}

/// Строка внешнего подрядного размещения (OUTSOURCED_SERVICE) в шаблоне
/// техкарты. Сознательно НЕ моделируется как операция и НЕ как материал —
/// это отдельная управленческая ось (см. ADR-0022).
model TechCardOutsourceLine {
  id          String               @id @default(cuid())
  techCardId  String
  sortOrder   Int
  /// Свободное человекочитаемое описание услуги/размещения.
  name        String
  /// Единица измерения опциональна: иногда подряд считается «за партию»
  /// без явной нормы.
  unit        String?
  /// Норма на одну единицу изделия. Если не задана — totalQty в snapshot
  /// тоже остаётся null (см. `OrdersService.start`).
  qtyPerUnit  Decimal?             @db.Decimal(12, 4)
  /// Опциональный подрядчик (на MVP — свободная строка, без справочника
  /// vendor-ов; см. ADR-0022 §«vendor directory postponed»).
  vendorName  String?
  note        String?
  /// Триггер активации этой строки на заказе (см. `OutsourceTriggerType`,
  /// ADR-0022 §«Cut-ready readiness (MVP-2)»). Дефолт `MANUAL` —
  /// безопасный, backward-compat: snapshot заказа не получает никакого
  /// сигнала готовности и поведение остаётся прежним. `CUT_READY`
  /// означает «потребность готова к заказу, когда весь крой заказа
  /// размещён в ячейки». Копируется в snapshot
  /// `OrderOutsourceRequirement.triggerType` при `OrdersService.start()`.
  triggerType OutsourceTriggerType @default(MANUAL)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  techCard          TechCardTemplate            @relation(fields: [techCardId], references: [id], onDelete: Cascade)
  orderRequirements OrderOutsourceRequirement[]

  @@index([techCardId, sortOrder])
}

/// Snapshot строки материала на конкретном заказе. Создаётся в
/// `OrdersService.start()` из текущих `TechCardMaterialLine` шаблона.
/// После snapshot-а заказ живёт независимо от того, что менеджер
/// сделает с шаблоном (правка строк / деактивация / удаление строки):
/// `sourceTechCardLineId` имеет `onDelete: SetNull`, поэтому snapshot
/// никогда не удаляется вместе с источником.
model OrderMaterialRequirement {
  id                            String   @id @default(cuid())
  orderId                       String
  /// Ссылка на исходную строку шаблона (для аудита). Nullable: если
  /// строку шаблона потом удалили, snapshot заказа продолжает жить с
  /// `null`-ом тут (см. ADR-0022 §«snapshot independence»).
  sourceTechCardLineId          String?
  sortOrder                     Int
  name                          String
  unit                          String
  /// Норма на единицу изделия — копия `TechCardMaterialLine.qtyPerUnit`
  /// в момент snapshot-а.
  qtyPerUnit                    Decimal  @db.Decimal(12, 4)
  /// Полная потребность по заказу: `qtyPerUnit * Σ OrderItem.qtyPlan`.
  totalQty                      Decimal  @db.Decimal(12, 4)
  note                          String?
  /// Этап 3 «Потребности цеха»: snapshot-копии новых полей
  /// `TechCardMaterialLine` в момент `OrdersService.start()`. Все
  /// nullable + backward-compatible — старые snapshot-строки остаются
  /// валидными, новые получают значения, только если они заданы в
  /// техкарте. См. `docs/recon-soft-integration.md §«Этап 3»`.
  materialRole                  String?
  fabricType                    String?
  densityGsm                    Int?
  plannedWidthCm                Int?
  colorRule                     String?
  fixedColorText                String?
  /// Этап 3: итоговый цвет для конкретного заказа, вычисленный в
  /// `OrdersService.start()` по `colorRule`:
  ///   - `ORDER_COLOR`          → `Order.color` (или null, если у заказа нет цвета);
  ///   - `FIXED_COLOR`          → `fixedColorText` (или null, если он пуст);
  ///   - `NO_COLOR`             → null;
  ///   - `ORDER_SELECTED_COLOR` → null на старте; потом синхронизируется с `selectedColorText`,
  ///                              когда менеджер сохранит цвет через action;
  ///   - null/empty             → null.
  /// Хранится как snapshot — поздние правки заказа/техкарты не меняют
  /// это значение (та же семантика, что у остальных snapshot-полей).
  resolvedColorText             String?
  /// Этап «Указать в заказе» (см. ТЗ §4): для строк техкарты с
  /// `colorRule = ORDER_SELECTED_COLOR` фиксируется true в момент
  /// `OrdersService.start()`. UI карточки заказа по этому флагу
  /// рисует поле «Цвет» с подсказкой «Цвет нужно указать в заказе»
  /// и action «Сохранить цвет». Дефолт `false` обеспечивает
  /// backward-compat: старые snapshot-строки приходят как
  /// `requiresColorSelection = false`.
  requiresColorSelection        Boolean  @default(false)
  /// Этап «Указать в заказе»: значение, которое менеджер ввёл для
  /// конкретной строки заказа. Меняется через
  /// `PATCH /api/orders/:id/material-requirements/:requirementId/color`
  /// и одновременно перезаписывается в `resolvedColorText` (см.
  /// `OrdersService.updateMaterialRequirementColor`). Не считается
  /// автоматически: для других `colorRule` остаётся null.
  selectedColorText             String?
  /// Этап «Фурнитура / изображение» (см. ТЗ §3, §5): snapshot-копии
  /// новых полей строки техкарты. Заполняются в `OrdersService.start()`
  /// из шаблона. Все nullable + backward-compatible.
  hardwareSizeText              String?
  hardwareMaterialText          String?
  materialImageUrl              String?
  materialImageOriginalFileName String?
  createdAt                     DateTime @default(now())

  order              Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sourceTechCardLine TechCardMaterialLine? @relation(fields: [sourceTechCardLineId], references: [id], onDelete: SetNull)

  @@index([orderId, sortOrder])
  @@index([sourceTechCardLineId])
  @@index([materialRole])
}

/// Snapshot строки внешнего подрядного размещения на конкретном заказе.
/// Создаётся в `OrdersService.start()` из `TechCardOutsourceLine` шаблона.
/// `qtyPerUnit`/`totalQty` могут быть `null` — это нормально для подряда,
/// который считается «за партию» без явной нормы.
model OrderOutsourceRequirement {
  id                   String                        @id @default(cuid())
  orderId              String
  sourceTechCardLineId String?
  sortOrder            Int
  name                 String
  unit                 String?
  qtyPerUnit           Decimal?                      @db.Decimal(12, 4)
  totalQty             Decimal?                      @db.Decimal(12, 4)
  vendorName           String?
  note                 String?
  /// Snapshot триггера активации (копируется из
  /// `TechCardOutsourceLine.triggerType` в `OrdersService.start()`).
  /// Используется только в `OrdersService.getOne()` для derive
  /// `isReadyToOrder` / `readinessLabel` на чтении (см. ADR-0022
  /// §«Cut-ready readiness (MVP-2)»). В БД статус готовности не
  /// храним: derive по этому полю + `Passport.currentCellId`.
  triggerType          OutsourceTriggerType          @default(MANUAL)
  /// Ручной операционный статус выполнения внешней потребности
  /// (см. `OrderOutsourceExecutionStatus`, ADR-0022 §«Manual
  /// execution status (MVP-3)»). Меняется только через action
  /// `POST /api/orders/:id/outsource-requirements/:requirementId/status`.
  /// Дефолт `PLANNED` — backward-compat для всех существующих snapshot-
  /// строк, поведение карточки заказа без ручных переходов остаётся
  /// прежним.
  executionStatus      OrderOutsourceExecutionStatus @default(PLANNED)
  /// Когда менеджер впервые перевёл строку в `ORDERED`. Лёгкий
  /// audit-trail без отдельного event-log: одна колонка достаточно
  /// для UI-метки «Отмечено: …». Не редактируется руками; не
  /// «обратнозаполняется» при прыжке `PLANNED → RECEIVED` (на MVP
  /// такой прыжок запрещён, см. сервис).
  orderedAt            DateTime?
  /// Когда менеджер перевёл строку в `RECEIVED`. Семантика та же,
  /// что у `orderedAt`.
  receivedAt           DateTime?
  createdAt            DateTime                      @default(now())

  order              Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sourceTechCardLine TechCardOutsourceLine? @relation(fields: [sourceTechCardLineId], references: [id], onDelete: SetNull)

  @@index([orderId, sortOrder])
  @@index([sourceTechCardLineId])
}

// ---------------------------------------------------------------------------
// Display screens (большой монитор цеха)
//
// Конфигурация конкретного display-экрана, висящего в зале. Каждый
// экран — отдельная сущность, у которой:
//   - есть собственная DISPLAY-учётка (`Employee` с `role = DISPLAY`)
//     для логина именно с этого монитора;
//   - зафиксировано подразделение (`CompanyDivision`), которое экран
//     должен показывать без участия URL;
//   - есть человекочитаемое имя для админ-листинга.
//
// Связь `1:1` с `Employee`: один экран = одна учётка. Это
// гарантируется `employeeId @unique`, плюс админская форма создания
// сразу заводит обе сущности в одной транзакции (см.
// `DisplayScreensService.create`). Менять `Employee.role` руками
// после этого нельзя — запись бы перестала иметь смысл, но это
// формально не enforced (на MVP админ просто не редактирует учётки
// DISPLAY вне этой формы).
//
// См. `docs/domain.md §«Подразделения заказа»` (раздел display
// screen-ов), `docs/api.md §11`, `docs/screens.md §10e`.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Audit log (универсальный журнал управленческих событий)
//
// Минимальная универсальная таблица под журнал бизнес-событий, не
// привязанная к конкретному агрегату. Это явно НЕ замена `PassportEvent`
// (тот описывает движение партии по pipeline и читается бизнес-логикой);
// `AuditLog` — это операционный лог «что произошло, кто инициировал, что
// именно изменилось», который можно безопасно дописывать новыми типами
// событий без миграции схемы.
//
// Дизайн (см. `docs/domain.md §«Audit log»`):
//   - `event` — короткий код события (`PASSPORT_ISSUED`, `ORDER_CREATED`,
//     `BOX_CLOSED`, …). Свободная строка, без enum: enum заставлял бы
//     писать миграцию на каждый новый тип события и блокировал
//     эволюцию журнала.
//   - `entityType` — тип агрегата (`PASSPORT`, `ORDER`, `QC`, `WTO`,
//     `PACKING`). Тоже строкой: один и тот же `entityType = PASSPORT`
//     может приходить из разных модулей (passports/qc/wto/packing).
//   - `entityId` — id основного агрегата (passportId / orderId /
//     boxId). Хранится строкой, без FK: AuditLog должен переживать
//     удаление/архивирование агрегата.
//   - `payload` — `Json`, в котором сервис кладёт минимально полезный
//     срез: ключевые поля действия (operationId, employeeId предыдущего
//     шага, qty, fromStatus/toStatus и т.п.). Никаких больших dump-ов
//     паспорта целиком — payload должен оставаться обозримым в UI.
//   - `employeeId` — кто инициировал действие (`null` для системных
//     событий). FK не ставим: учётка может быть деактивирована/
//     удалена, а строка журнала должна уцелеть.
//   - `createdAt` — момент записи; берётся БД default-ом, чтобы внутри
//     одной транзакции порядок журналирования совпадал с порядком
//     операций.
//   - Индексы: `(entityType, entityId)` для карточки «история
//     действий по объекту» и `createdAt` для общей ленты/последних
//     событий.
//
// Записывается строго в той же `prisma.$transaction`, что и сама
// бизнес-операция (см. `AuditService.log`), — это инвариант
// «либо и операция, и аудит, либо ничего».
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  event      String
  entityType String
  entityId   String
  payload    Json
  employeeId String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model DisplayScreenConfig {
  id                String           @id @default(cuid())
  /// Человекочитаемое имя экрана: «ТВ маркетплейс на стене у выхода»,
  /// «Дисплей у раскройщиков». Используется только в админ-листинге
  /// (`/admin/display-screens`); фронту дисплея не отдаётся.
  name              String
  /// Подразделение, которое экран показывает без `?divisionCode=` в
  /// URL — FK на master-справочник `CompanyDivision`. Источник
  /// истины подразделения экрана (см. `docs/display-board.md`,
  /// `docs/screens.md §10e`).
  ///
  /// Nullable + `onDelete: SetNull`: удаление справочной карточки не
  /// сносит экран — UI показывает «Не указано», `ShopfloorService`
  /// возвращает «общий» агрегат до тех пор, пока менеджер не
  /// перепривяжет экран к актуальной карточке.
  companyDivisionId String?
  companyDivision   CompanyDivision? @relation(fields: [companyDivisionId], references: [id], onDelete: SetNull)
  /// FK на `Employee.id` под этой DISPLAY-учёткой. UNIQUE — один
  /// экран = ровно одна учётка. На delete сотрудника каскадно
  /// удаляется и конфиг (учётку DISPLAY мы заводим строго под этот
  /// экран и не используем где-то ещё).
  employeeId        String           @unique
  /// Мягкий выключатель экрана. Если `false` — `ShopfloorService`
  /// игнорирует конфиг при автоопределении подразделения для
  /// DISPLAY-пользователя и возвращает «общий» агрегат, как раньше.
  /// Сама учётка может всё равно жить, поэтому отключить экран
  /// временно можно без удаления.
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@index([companyDivisionId])
}

/// Вызов мастера цеха (MVP, см. `docs/domain.md §«Мастер цеха»`,
/// `docs/flows.md §«Вызов мастера»`).
///
/// Жизненный цикл:
///   1. Рабочий (SEAMSTRESS / CUTTER / CUTTER_ASSISTANT / QC / IRONING /
///      PACKING) на своём терминале нажимает кнопку «Мастер» →
///      `POST /api/master-calls` создаёт запись в статусе `OPEN`.
///      Идемпотентно: если у сотрудника уже есть `OPEN` вызов —
///      возвращаем его, а не плодим дубль.
///   2. Backend в момент создания подтягивает активную
///      `ShiftSession` сотрудника (если есть) и копирует из неё
///      `equipmentId` и `operationId` — это нужно, чтобы:
///        - `/master` показал «оборудование, операцию, размеры»;
///        - `/shopfloor/display` мягко мигал плиткой именно того
///          станка (см. `display-equipment-tile--master-call`).
///   3. Мастер на `/master` сканирует QR сотрудника
///      (`EMPLOYEE:<employeeId>`) → `POST /api/master-calls/
///      resolve-by-employee-qr` находит `OPEN` вызов того же
///      сотрудника, переводит в `RESOLVED`, фиксирует `resolvedAt`
///      и `resolvedById` (FK на `Employee`).
///
/// Сообщение `message` и `CANCELLED`-статус оставлены под будущее
/// расширение (произвольный текст вызова, авто-протухание и т.п.).
/// На MVP они не пишутся — но в схеме сразу есть поля, чтобы новые
/// сценарии не требовали миграции.
model MasterCall {
  id           String           @id @default(cuid())
  employeeId   String
  equipmentId  String?
  operationId  String?
  status       MasterCallStatus @default(OPEN)
  message      String?
  createdAt    DateTime         @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  employee   Employee   @relation("MasterCallEmployee", fields: [employeeId], references: [id])
  equipment  Equipment? @relation(fields: [equipmentId], references: [id])
  operation  Operation? @relation(fields: [operationId], references: [id])
  resolvedBy Employee?  @relation("MasterCallResolver", fields: [resolvedById], references: [id])

  @@index([status, createdAt])
  @@index([employeeId, status])
  @@index([equipmentId, status])
}

// ---------------------------------------------------------------------------
// Cut release policy (Stage 3 «Мастер цеха», MVP)
//
// Управленческое ограничение выдачи кроя сотрудникам на ПЕРВОЙ операции
// маршрута (или операции категории `CUTTING`). Мастер цеха задаёт
// фильтр (цвет / размер / суммарный лимит штук) → бекенд режет
// `PassportsService.issueToEmployee` для паспортов, не подходящих под
// фильтр, и инкрементит `consumedQty` для подходящих. Само движение
// паспорта по маршруту (`scan`/`complete-operation`) НЕ блокируется —
// ограничение действует только на «получить крой из ячейки» / «получить
// крой по маршруту-WIP» (см. `apps/api/src/modules/cut-release-policy/*`,
// `apps/api/src/modules/passports/passports.service.ts`).
//
// Инвариант MVP: одновременно активна максимум одна политика
// (`isActive = true`). Enforce-им на уровне сервиса
// (`CutReleasePolicyService.create` сначала деактивирует предыдущую
// активную, потом создаёт новую). Уникальный частичный индекс
// сознательно НЕ ставим — мастер может «временно отключить»
// политику, оставить её записью в БД и завести новую с другим
// фильтром; уникальный индекс заставлял бы удалять старую запись.
//
// Лимит штук считается по `passport.qtyCut` (не `qtyGood`): мы
// ограничиваем «сколько кроя ушло со склада в работу», а не «сколько
// сшилось». Это устойчиво к последующему браку (`qtyGood < qtyCut`)
// и совпадает с тем, как считают cell-content движения.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Patterns (изолированный модуль «Лекала», MVP-1)
//
// Цель — завести самостоятельный справочник лекал, которым менеджер сможет
// управлять независимо от заказа: артикул + превью + загруженные DXF-файлы
// по размерам + площади материалов по размеру/роли. На этом этапе никакой
// связи с `Order`/`OrderItem`/`TechCard*` не вводим — лекала живут как
// отдельная сущность. Soft-интеграция (`Order.patternItemId` и snapshot на
// заказе) откладывается на следующий этап (см. `docs/recon-soft-integration.md`).
//
// Контракт MVP:
//   - `PatternItem` — карточка лекала: артикул (`article` уникально),
//     название, категория, статус (`ACTIVE`/`ARCHIVED`/...), превью.
//     `previewImageUrl`/`fileUrl` хранят публичный URL (`/uploads/...`),
//     binary в БД не лежит (см. `apps/api/src/modules/patterns/storage`).
//   - `PatternSizeFile` — версионированный DXF по конкретному размеру.
//     Версия инкрементится сервисом (`max(version) + 1` по
//     `(patternItemId, sizeId)`); удаление = архивация (status =
//     `ARCHIVED`), физический файл с диска не удаляется.
//   - `PatternMaterialArea` — площадь материала на размере по роли
//     (`MAIN_FABRIC`/`RIB`/`LINING`/...). Роль — свободная строка с
//     валидацией по списку в `@sewing/shared/patterns` (без Prisma enum
//     — ради расширяемости без миграции).
//
// RBAC — `ADMIN`/`SHOP_MANAGER` (см. `apps/api/src/modules/patterns`).
// Аудит — события `PATTERN_*` через универсальный `AuditService`.
// ---------------------------------------------------------------------------

model PatternItem {
  id              String   @id @default(cuid())
  /// Человекочитаемое название лекала (в UI первично). Не уникально:
  /// в каталоге могут быть два лекала с одинаковым названием, но
  /// разными артикулами/конструкциями.
  name            String
  /// Артикул лекала — уникальный управленческий идентификатор. Видим в
  /// списке `/admin/patterns` и в карточке. Уникальность гарантируется
  /// БД, дубликат → 409 `PATTERN_ARTICLE_TAKEN`.
  article         String   @unique
  /// Legacy-поле «Опциональный код категории» (свободная строка). Этап
  /// «Категории номенклатуры» (см. `model PatternCategory`) ввёл
  /// типизированный справочник `PatternCategory` — новые лекала
  /// привязываются к нему через `categoryId`. Поле `categoryCode`
  /// сохранено как fallback для исторических записей: до миграции на
  /// справочник менеджер набирал категорию руками, и эту строку нам
  /// нужно показать в списке/карточке как «старая категория». Никаких
  /// destructive миграций; новый UI создаёт лекала уже без `categoryCode`.
  categoryCode    String?
  /// Этап «Категории номенклатуры»: FK на типизированный справочник
  /// `PatternCategory`. Nullable, потому что:
  ///   - старые записи остаются без категории (мы не делаем
  ///     destructive миграцию);
  ///   - менеджер может временно создать лекало без категории и
  ///     прицепить её позже.
  /// `onDelete: SetNull` — архивация / удаление категории не сносит
  /// карточку лекала. Параметры площадей (см. `PatternCategoryParameter`)
  /// при отсутствии категории не показываются — UI fallback-ит на
  /// глобальный `MATERIAL_ROLES`, чтобы старые лекала продолжали
  /// работать (см. `apps/api/src/modules/patterns/patterns.service.ts`,
  /// `replaceMaterialAreas`).
  categoryId      String?
  /// Публичный URL превью (`/uploads/patterns/<id>/preview/<file>`).
  /// Хранится только URL — binary в БД не лежит. NULL пока менеджер не
  /// загрузил превью; UI показывает placeholder.
  previewImageUrl String?
  description     String?
  /// Статус карточки. На MVP свободная строка с дефолтом `ACTIVE`,
  /// чтобы менеджер мог завести `ARCHIVED`/`DRAFT` без миграции схемы.
  /// UI отображает только известные значения (см.
  /// `@sewing/shared/patterns::PATTERN_ITEM_STATUSES`), остальные —
  /// показывает строкой как есть.
  status          String   @default("ACTIVE")
  /// Этап «Номенклатура = Лекала» (см. `docs/recon-soft-integration.md
  /// §«Номенклатура = Лекала»). Ссылка на «технический» Product,
  /// который автоматически создаётся `OrdersService.ensureLegacyProductForPattern()`
  /// для этого лекала и подставляется в `OrderItem.productId` при
  /// создании заказа из нового admin-UI. Один лекало = один Product
  /// (UNIQUE), `onDelete: SetNull` — удаление Product не сносит
  /// карточку лекала, при необходимости helper создаст новый Product
  /// по требованию. В UI создания заказа Product спрятан: пользователь
  /// выбирает только лекало, backend сам обеспечивает legacy
  /// `productId` для паспортов / ставок / старого учётного flow.
  legacyProductId String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sizeFiles           PatternSizeFile[]
  materialAreas       PatternMaterialArea[]
  /// Этап «Фурнитура и нормы» (см. `model PatternItemParameterNorm`
  /// ниже). Для параметров категории с `inputType = QTY_PER_ITEM`
  /// карточка лекала хранит «норму на изделие» (Люверсы = 2 шт,
  /// Шнур = 1 шт, …). Связь 1:N — у одного лекала по одной норме на
  /// каждый QTY_PER_ITEM параметр его категории. При расчёте
  /// потребности цеха `WorkshopNeedsService.calculateForOrder`
  /// раскрывает каждую норму в отдельную строку `WorkshopNeed`
  /// (`sourceType = PATTERN_PARAMETER_NORM`, `sourceId = norm.id`).
  parameterNorms      PatternItemParameterNorm[]
  /// Этап «Погонные метры по размерам» (см.
  /// `model PatternItemSizeParameterValue` ниже). Для параметров
  /// категории с `inputType = LINEAR_M_BY_SIZE` карточка лекала
  /// хранит численные значения (м пог.) по каждому размеру. При
  /// расчёте потребности цеха `WorkshopNeedsService` группирует
  /// значения по `categoryParameterId` и считает
  /// `Σ(value × OrderItem.qtyPlan)` по совпадающим размерам.
  /// `PatternMaterialArea` для погонных метров НЕ используется —
  /// там семантика про areaM2 (см. ТЗ §5).
  sizeParameterValues PatternItemSizeParameterValue[]
  /// Soft-pattern MVP (этап 2 «Лекала»): обратная связь от заказов,
  /// у которых выбрано это лекало. На API на этапе 2 не используется
  /// (заказ читает лекало через `Order.patternItem`); связь нужна,
  /// чтобы Prisma знала о relation-поле и могла поддерживать
  /// `onDelete: SetNull` на стороне `Order.patternItemId`.
  orders              Order[]
  /// Этап «Номенклатура = Лекала»: связь с авто-создаваемым
  /// «техническим» Product (см. `legacyProductId` выше).
  legacyProduct       Product?                        @relation("PatternLegacyProduct", fields: [legacyProductId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  /// Этап «Категории номенклатуры»: типизированный справочник
  /// категорий с параметрами площадей. См. `model PatternCategory`.
  category            PatternCategory?                @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([categoryId])
}

/// Справочник категорий номенклатуры (этап «Категории номенклатуры»,
/// см. `docs/recon-soft-integration.md §«Этап Категории»`).
///
/// Категория = тип изделия в каталоге («Худи», «Футболка», «Брюки»),
/// у каждой свой набор параметров материалов (`PatternCategoryParameter`).
/// Карточка номенклатуры (`PatternItem`) ссылается на категорию через
/// `categoryId`, и UI «Площади материалов» строится по параметрам
/// этой категории — а не по глобальному `MATERIAL_ROLES`. Это даёт
/// каждому изделию свои колонки м² (например, «Основной материал» +
/// «Кашкорсе» для худи, без «Подклада» / «Упаковки»).
///
/// Удаление = soft-archive: `status = ARCHIVED`. Hard-delete не
/// поддерживается, чтобы не уронить связанные `PatternItem.categoryId`
/// (FK `onDelete: SetNull` страхует от ручных удалений в БД).
///
/// `slug` — URL-friendly идентификатор для будущих deep-link и
/// быстрых seed-операций; уникален. `iconKey` — ключ из whitelist
/// `PATTERN_CATEGORY_ICON_KEYS` (`@sewing/shared/pattern-categories`),
/// UI рисует иконку lucide по ключу — никаких файлов-иконок.
model PatternCategory {
  id                   String   @id @default(cuid())
  /// Человекочитаемое название категории (видим в UI первично).
  name                 String
  /// URL-friendly идентификатор категории, уникальный. На MVP сервис
  /// генерирует slug из `name`, если не передан.
  slug                 String   @unique
  /// Legacy: ключ lucide-иконки (whitelist в `PATTERN_CATEGORY_ICON_KEYS`).
  /// Хранится строкой — расширение whitelist не требует миграции.
  /// На MVP «Загружаемая JPEG-иконка категории» поле сохранено как
  /// fallback для старых записей: если `iconImageUrl` пуст, UI рисует
  /// lucide по этому ключу (см. `apps/web/lib/pattern-category-icon.tsx`,
  /// `apps/web/app/admin/patterns/page.tsx::CategoryFilterChip`).
  iconKey              String
  /// Публичный URL загруженной JPEG-иконки категории
  /// (`/uploads/pattern-categories/<id>/icon/<safe-name>.jpg`). Основной
  /// источник иконки в новых UI: фильтр категорий, чипсы, формы создания
  /// номенклатуры. Если пуст — fallback на `iconKey` (lucide). См.
  /// `apps/api/src/modules/pattern-categories/pattern-categories-storage.service.ts`.
  iconImageUrl         String?
  /// Оригинальное имя загруженного JPEG-файла иконки (то, что выбрал
  /// менеджер). На диск записывается безопасное сгенерированное имя
  /// (см. `PatternCategoriesStorageService.makeStoredFileName`); это
  /// поле используется только для отображения «исходного» названия в
  /// карточке категории.
  iconOriginalFileName String?
  /// Управленческий порядок сортировки в фильтре каталога. Меньше —
  /// выше в списке. Default 100, чтобы новые категории не «прыгали»
  /// в начало.
  sortOrder            Int      @default(100)
  /// `ACTIVE` / `ARCHIVED`. Свободная строка ради расширяемости
  /// (см. `PATTERN_CATEGORY_STATUSES`). Архивные не отдаются в
  /// дефолтном `GET /api/pattern-categories?status=ACTIVE`.
  status               String   @default("ACTIVE")
  description          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  patterns   PatternItem[]
  parameters PatternCategoryParameter[]
  /// Этап «Inline-создание изделия из формы заказа»: техкарты,
  /// опционально привязанные к этой группе (см. `TechCardTemplate.patternCategoryId`).
  techCards  TechCardTemplate[]

  @@index([status])
  @@index([sortOrder])
}

/// Параметр категории номенклатуры — одна позиция «что нужно
/// замерить/указать у изделия этой категории» (этап «Категории
/// номенклатуры»).
///
/// Главный смысл: `roleKey` — это та же строка, которую
/// `PatternMaterialArea.materialRole` хранит для конкретного
/// размера лекала. То есть параметр категории определяет, какие
/// `materialRole` разрешены при сохранении площадей — backend
/// валидирует это в `PatternsService.replaceMaterialAreas`.
///
/// `inputType` (см. `PATTERN_CATEGORY_PARAMETER_INPUT_TYPES`):
///   - `AREA_M2_BY_SIZE` — параметр попадает в таблицу «Площади
///     материалов» как колонка м² (UI этого этапа);
///   - `QTY_PER_ITEM` — количество на изделие, кладётся в карточке
///     как информационное поле (UI отдельный, на этом этапе не
///     рисуем — backend хранит, frontend пока не визуализирует);
///   - `TEXT_ONLY` — описание / услуга (например «Нанесение»).
///
/// Уникальность `(categoryId, roleKey)` НЕ enforced на уровне БД:
/// для группы «Фурнитура» в одной категории должно быть несколько
/// параметров с одним и тем же `roleKey = PACKAGING`, но разными
/// `label` (Люверсы / Молния / Кнопки / Пуговицы / Шнур). Уникальность
/// внутри `AREA_M2_BY_SIZE` (чтобы расчёт «по какой колонке м²» не
/// был неоднозначен) валидируется в shared Zod-схеме
/// `PatternCategoryParameterInputSchema` (`packages/shared/src/pattern-categories.ts`)
/// и сервисе `PatternCategoriesService`. См. миграцию
/// `20260518100000_allow_multiple_category_hardware_parameters`.
model PatternCategoryParameter {
  id String @id @default(cuid())

  categoryId String
  category   PatternCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  /// Ключ роли материала (uppercase letters/digits/underscore). Должен
  /// маппиться 1:1 на строку, которую хранит
  /// `PatternMaterialArea.materialRole`. Backend валидирует это в
  /// `PatternsService.replaceMaterialAreas`: при наличии категории
  /// принимаются только те `materialRole`, которые есть в активных
  /// параметрах категории; без категории — fallback на глобальный
  /// `MATERIAL_ROLES`.
  roleKey     String
  /// Человекочитаемое название параметра — UI рисует его в шапке
  /// колонки таблицы «Площади материалов» (например, «Основной
  /// материал», «Кашкорсе»).
  label       String
  /// Тип ввода (см. `PATTERN_CATEGORY_PARAMETER_INPUT_TYPES`).
  /// На этом этапе в таблицу «Площади материалов» попадают только
  /// `AREA_M2_BY_SIZE`. Остальные сохраняются и зарезервированы под
  /// будущий UI.
  inputType   String  @default("AREA_M2_BY_SIZE")
  /// Единица измерения (для AREA_M2_BY_SIZE = «м²» по умолчанию,
  /// для QTY_PER_ITEM = «шт», для TEXT_ONLY может быть пустой).
  /// На MVP UI берёт строку как есть — никакой нормализации.
  unit        String  @default("м²")
  /// Признак «параметр обязателен» — frontend рисует подсказку, но
  /// на MVP не блокирует сохранение площадей с пустыми ячейками.
  isRequired  Boolean @default(false)
  /// Управленческий порядок параметров в карточке категории и в
  /// шапке таблицы «Площади материалов».
  sortOrder   Int     @default(100)
  /// `ACTIVE` / `ARCHIVED` (см. `PATTERN_CATEGORY_PARAMETER_STATUSES`).
  /// Архивный параметр не показывается в новых карточках
  /// номенклатуры, но если в `PatternMaterialArea` уже есть строка с
  /// таким `roleKey`, она остаётся валидной (backend не подчищает
  /// исторические данные).
  status      String  @default("ACTIVE")
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Этап «Фурнитура и нормы»: обратная связь от карточек лекал,
  /// которые сохранили норму «количество на изделие» по этому
  /// параметру (см. `model PatternItemParameterNorm`). Используется
  /// `onDelete: Cascade` — если параметр удалён из категории,
  /// соответствующие нормы уезжают вместе с ним. Backend дополнительно
  /// архивирует параметры категории через `status = ARCHIVED` —
  /// архивные параметры не показываются в форме «Фурнитура и нормы»,
  /// но норма остаётся в БД до явной замены.
  patternItemNorms      PatternItemParameterNorm[]
  /// Этап «Погонные метры по размерам»: обратная связь от карточек
  /// лекал, которые сохранили численные значения по размерам по
  /// этому параметру (см. `model PatternItemSizeParameterValue`).
  /// `onDelete: Cascade` — если параметр удалён, значения уезжают
  /// вместе с ним. Архивные параметры (status = ARCHIVED) не
  /// показываются в UI «Погонные метры», но значения сохраняются
  /// в БД до явной замены.
  patternItemSizeValues PatternItemSizeParameterValue[]

  // (categoryId, roleKey) — обычный индекс. В прошлой миграции это было
  // `@@unique`, но теперь группа «Фурнитура» допускает несколько строк
  // с roleKey = PACKAGING (Люверсы / Молния / ...). Уникальность внутри
  // `AREA_M2_BY_SIZE` валидируется приложением (Zod-схема
  // `PatternCategoryParameterInputSchema`).
  @@index([categoryId, roleKey])
  @@index([categoryId])
  @@index([status])
  @@index([sortOrder])
}

/// DXF-файл лекала по конкретному размеру. Один `(patternItemId, sizeId)`
/// может иметь несколько версий — менеджер загружает новую версию
/// файла кнопкой «Заменить», старая остаётся как `ACTIVE` с младшим
/// `version`. Удаление через UI = `status = ARCHIVED` (физически файл
/// с диска НЕ удаляем — см. `PatternsService.archiveSizeFile`).
model PatternSizeFile {
  id               String   @id @default(cuid())
  patternItemId    String
  sizeId           String
  /// Публичный URL DXF-файла (`/uploads/patterns/<patternId>/sizes/<sizeId>/<file>`).
  fileUrl          String
  /// Исходное имя файла, как его сохранил менеджер (для UI и
  /// «скачать» с понятным названием).
  originalFileName String
  /// Версия в рамках `(patternItemId, sizeId)`. Считается сервисом как
  /// `max(version) + 1` при заливке нового файла; уникальность
  /// `(patternItemId, sizeId, version)` гарантируется БД.
  version          Int      @default(1)
  /// Состояние записи. На MVP `ACTIVE`/`ARCHIVED` (свободная строка
  /// для будущей расширяемости). Архивная запись остаётся в БД и
  /// показывается в истории файлов карточки.
  status           String   @default("ACTIVE")
  /// FK на сотрудника, который загрузил версию. Nullable — на случай,
  /// когда сессия аудит-нейтральна (системные/seed-инициализации).
  /// `onDelete: SetNull`, чтобы удаление учётки не сносило файл лекала.
  uploadedById     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  patternItem PatternItem @relation(fields: [patternItemId], references: [id], onDelete: Cascade)
  size        Size        @relation(fields: [sizeId], references: [id])
  uploadedBy  Employee?   @relation("PatternSizeFileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([patternItemId, sizeId, version], name: "PatternSizeFile_pattern_size_version_uniq")
  @@index([patternItemId])
}

/// Площадь материала на конкретном размере для конкретной роли
/// (`MAIN_FABRIC`/`RIB`/`LINING`/...). Хранится в м² с точностью
/// 4 знака после запятой. На MVP редактируется bulk-replace
/// (`PUT /api/patterns/:id/material-areas`): сервис в одной
/// транзакции удаляет старые строки лекала и записывает новые.
///
/// `materialRole` — String (без Prisma enum) ради расширения списка
/// без миграции (см. `@sewing/shared/patterns::MATERIAL_ROLES`).
/// Уникальность пары `(patternItemId, sizeId, materialRole)` гарантирует,
/// что одна и та же роль не задана дважды для одного размера.
model PatternMaterialArea {
  id            String   @id @default(cuid())
  patternItemId String
  sizeId        String
  materialRole  String
  areaM2        Decimal  @db.Decimal(10, 4)
  comment       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  patternItem PatternItem @relation(fields: [patternItemId], references: [id], onDelete: Cascade)
  size        Size        @relation(fields: [sizeId], references: [id])

  @@unique([patternItemId, sizeId, materialRole], name: "PatternMaterialArea_pattern_size_role_uniq")
  @@index([patternItemId, materialRole])
}

/// Этап «Фурнитура и нормы» (см. ТЗ «Карточка номенклатуры — блок
/// Фурнитура и нормы», `apps/web/app/admin/patterns/[id]/parameter-norms-form.tsx`,
/// `apps/api/src/modules/patterns/patterns.service.ts::replaceParameterNorms`).
///
/// Хранит «норму на изделие» по конкретному параметру категории
/// (`PatternCategoryParameter`) в карточке лекала
/// (`PatternItem`). UI показывает блок «Фурнитура и нормы» только
/// для параметров с `inputType = QTY_PER_ITEM` (`status = ACTIVE`):
/// Люверсы / Шнур / Наконечники / Молния / Кнопки / Пуговицы.
///
/// Хранить нормы по `categoryParameterId`, а не только по `roleKey`,
/// принципиально: для группы «Фурнитура» в одной категории может
/// быть несколько параметров с одним и тем же `roleKey = PACKAGING`,
/// но разными `label`. Уникальность `(patternItemId, categoryParameterId)`
/// гарантирует, что норма не задана дважды для одного параметра, и
/// «PUT /patterns/:id/parameter-norms» делает атомарный bulk-replace.
///
/// Snapshot-поля (`labelSnapshot`, `inputTypeSnapshot`, `unit`,
/// `roleKey`) пишутся в момент сохранения и переживают переименование
/// или удаление параметра категории — `WorkshopNeedsService` использует
/// snapshot, не текущие значения параметра. `unit` копируется из
/// параметра категории и используется как `unit` строки `WorkshopNeed`.
///
/// `qtyPerItem` — Decimal(14, 4), > 0. Если поле пустое в форме —
/// норма НЕ сохраняется (см. `replaceParameterNorms` бизнес-логику).
/// Если norm отсутствует для required параметра, на MVP не блокируем
/// — `WorkshopNeed` просто не создаётся (см. ТЗ §«Cut readiness»).
model PatternItemParameterNorm {
  id String @id @default(cuid())

  patternItemId String
  patternItem   PatternItem @relation(fields: [patternItemId], references: [id], onDelete: Cascade)

  categoryParameterId String
  categoryParameter   PatternCategoryParameter @relation(fields: [categoryParameterId], references: [id], onDelete: Cascade)

  /// Snapshot `roleKey` параметра категории на момент сохранения нормы.
  /// Используется `WorkshopNeedsService` для записи `WorkshopNeed.materialRole`.
  /// Для группы фурнитуры это обычно `PACKAGING`, но в одной категории
  /// несколько норм могут иметь одинаковый `roleKey` — различаются
  /// они по `categoryParameterId` (Люверсы / Шнур / Наконечники).
  roleKey           String
  /// Snapshot `label` параметра — отображается в `WorkshopNeed.description`
  /// и `sourceName`. Сохраняется в момент сохранения нормы, чтобы
  /// переименование параметра категории позже не повлияло на
  /// исторические `WorkshopNeed`-строки.
  labelSnapshot     String
  /// Snapshot `inputType` параметра — на MVP всегда `QTY_PER_ITEM`,
  /// но поле зарезервировано на случай расширения списка
  /// `PATTERN_CATEGORY_PARAMETER_INPUT_TYPES`.
  inputTypeSnapshot String
  /// Единица измерения, скопированная из параметра категории
  /// (`PatternCategoryParameter.unit`). Для QTY_PER_ITEM по умолчанию
  /// «шт». Используется как `WorkshopNeed.unit`.
  unit              String

  /// Норма на изделие. Decimal(14, 4), > 0. Backend валидирует через
  /// `ReplacePatternItemParameterNormsSchema` (см. `@sewing/shared`).
  qtyPerItem Decimal @db.Decimal(14, 4)
  /// Опциональный комментарий менеджера (например, «китайские
  /// люверсы 11 мм»). Хранится строкой как есть.
  comment    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([patternItemId, categoryParameterId])
  @@index([patternItemId])
  @@index([categoryParameterId])
  @@index([roleKey])
}

/// Этап «Погонные метры по размерам» (см. ТЗ «Доработать параметры
/// категорий номенклатуры», `apps/web/app/admin/patterns/[id]/size-parameter-values-form.tsx`,
/// `apps/api/src/modules/patterns/patterns.service.ts::replaceSizeParameterValues`).
///
/// Хранит численное значение по конкретному размеру (`Size`) для
/// конкретного параметра категории (`PatternCategoryParameter`) в
/// карточке лекала (`PatternItem`). На MVP таблица используется
/// только для `inputType = LINEAR_M_BY_SIZE` (погонные метры,
/// `unit = "м пог."`), но schema допускает любые numeric-by-size
/// значения — `inputTypeSnapshot` различает их.
///
/// Для AREA_M2_BY_SIZE существует отдельная таблица
/// `PatternMaterialArea` (там семантика про areaM2 м²); для
/// QTY_PER_ITEM — `PatternItemParameterNorm` (норма на изделие).
/// Это сознательно: «одна семантика — одна таблица», старые данные
/// не переводятся, обратная совместимость не нарушается.
///
/// Уникальность `(patternItemId, categoryParameterId, sizeId)` —
/// одно значение на тройку. Bulk-replace
/// `PUT /api/patterns/:id/size-parameter-values` стирает все старые
/// LINEAR_M_BY_SIZE-значения лекала по «допустимому окну» параметров
/// категории и пишет новый набор.
///
/// Snapshot-поля (`roleKey`, `labelSnapshot`, `inputTypeSnapshot`,
/// `unit`) пишутся в момент сохранения и переживают переименование
/// или архивацию параметра — `WorkshopNeedsService` использует
/// snapshot, не текущие значения параметра.
///
/// `value` — Decimal(14, 4), > 0. Если поле пустое в форме —
/// значение НЕ сохраняется (см. service `replaceSizeParameterValues`).
/// Если для required параметра нет значений, на MVP не блокируем
/// — `WorkshopNeed` просто не создаётся (с warning в `calculationNote`).
model PatternItemSizeParameterValue {
  id String @id @default(cuid())

  patternItemId String
  patternItem   PatternItem @relation(fields: [patternItemId], references: [id], onDelete: Cascade)

  categoryParameterId String
  categoryParameter   PatternCategoryParameter @relation(fields: [categoryParameterId], references: [id], onDelete: Cascade)

  sizeId String
  size   Size   @relation(fields: [sizeId], references: [id], onDelete: Cascade)

  /// Snapshot `PatternCategoryParameter.roleKey` на момент сохранения.
  /// Используется `WorkshopNeedsService` для записи `WorkshopNeed.materialRole`.
  roleKey           String
  /// Snapshot `PatternCategoryParameter.label` — отображается в
  /// `WorkshopNeed.description` и `sourceName`. Сохраняется в момент
  /// сохранения, чтобы переименование параметра не повлияло на
  /// исторические `WorkshopNeed`-строки.
  labelSnapshot     String
  /// Snapshot `PatternCategoryParameter.inputType` — на MVP всегда
  /// `LINEAR_M_BY_SIZE`, но поле зарезервировано на случай расширения
  /// списка `PATTERN_CATEGORY_PARAMETER_INPUT_TYPES`.
  inputTypeSnapshot String
  /// Единица измерения, скопированная из параметра категории
  /// (`PatternCategoryParameter.unit`). Для LINEAR_M_BY_SIZE по
  /// умолчанию «м пог.». Используется как `WorkshopNeed.unit`.
  unit              String

  /// Численное значение по этому размеру. Decimal(14, 4), > 0.
  /// Backend валидирует через `ReplacePatternItemSizeParameterValuesSchema`
  /// (см. `@sewing/shared`).
  value   Decimal @db.Decimal(14, 4)
  /// Опциональный комментарий менеджера. Хранится строкой как есть.
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([patternItemId, categoryParameterId, sizeId], name: "PatternItemSizeParameterValue_pattern_param_size_uniq")
  @@index([patternItemId])
  @@index([categoryParameterId])
  @@index([sizeId])
  @@index([roleKey])
}

model CutReleasePolicy {
  id       String  @id @default(cuid())
  /// Активная политика. На MVP одновременно активна максимум одна
  /// (enforce — `CutReleasePolicyService.create`). Деактивированные
  /// записи остаются для аудита и отчётности (сколько штук успели
  /// выдать в рамках этой политики до её отмены).
  isActive Boolean @default(true)

  /// Опциональный фильтр по цвету (`Passport.color`). Сравниваем
  /// строго по равенству строки. NULL = «цвет не ограничен». UI на
  /// `/master` рендерит select из набора реально используемых цветов;
  /// backend никакой нормализации не делает.
  color    String?
  /// Опциональный фильтр по размеру (`Passport.sizeId`). NULL =
  /// «размер не ограничен». FK не ставим: размер может быть удалён
  /// из справочника (на MVP такое не делают, но мы не хотим связи,
  /// которая блокирует удаление справочной записи). Валидация
  /// существования размера — на стороне сервиса при `create`.
  sizeId   String?
  /// Лимит штук, который сотрудники могут забрать в рамках этой
  /// политики (`Σ passport.qtyCut`). `0` — формально допустим
  /// (Zod валидирует `>= 1` со стороны API), но в БД это просто
  /// запись с лимитом 0 — она будет блокировать любую выдачу,
  /// что может быть полезно для админских стопов.
  limitQty Int

  /// Сколько уже выдано в рамках этой политики (накопительно).
  /// Инкрементится атомарно в той же транзакции, что и issue
  /// (см. `PassportsService.issueToEmployee`). Не сбрасывается —
  /// чтобы посмотреть «сколько успели выдать до отмены».
  consumedQty Int @default(0)

  /// Кто создал политику (мастер / менеджер / админ). Хранится
  /// строкой без FK — учётка может быть деактивирована, а запись
  /// политики должна уцелеть для аудита.
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

// ---------------------------------------------------------------------------
// Workshop needs (Этап 4А «Потребность цеха»)
//
// Рабочее место закупщика: чистая потребность заказа в материалах,
// рассчитанная системой по «лекало × техкарта × размерная матрица».
// См. `apps/api/src/modules/workshop-needs/*`,
// `docs/recon-soft-integration.md §«Этап 4А»`.
//
// Сознательные ограничения MVP:
//   - НЕ закупочная номенклатура: это описание того, что нужно
//     найти/купить (`description` человекочитаемой строкой);
//   - НЕТ справочника поставщиков — `supplierNameText` /
//     `purchaseItemNameText` свободные строки;
//   - НЕТ закупочных документов / приёмки / складских ячеек;
//   - НЕТ потерь / коэффициентов: считается только чистая
//     потребность;
//   - `purchaseQty` заполняет закупщик руками (system НЕ копирует
//     `calculatedQty` в `purchaseQty` автоматически).
//
// Источник материала (`sourceType`):
//   - `TECH_CARD_MATERIAL_LINE` — заказ в DRAFT, считаем по live
//     техкарте;
//   - `ORDER_MATERIAL_REQUIREMENT` — заказ запущен, считаем по
//     snapshot строкам `OrderMaterialRequirement`.
// `sourceId` — id исходной строки (для аудита). Хранится строкой,
// без FK — snapshot/строка техкарты могут быть позже удалены, а
// потребность должна уцелеть.
//
// `status` и `calculationMethod` — String (без Prisma enum), список
// расширяется без миграции (см. `@sewing/shared/workshop-needs`).
// ---------------------------------------------------------------------------

model WorkshopNeed {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// `TECH_CARD_MATERIAL_LINE` | `ORDER_MATERIAL_REQUIREMENT`. Хранится
  /// строкой ради расширяемости (см. JSDoc выше).
  sourceType String?
  /// `id` исходной строки в источнике (`TechCardMaterialLine.id` или
  /// `OrderMaterialRequirement.id`). Без FK: исходная строка может
  /// быть удалена позже, а потребность должна уцелеть для аудита.
  sourceId   String?

  /// Роль материала (`MAIN_FABRIC`, `RIB`, `LINING`, …). Свободная
  /// строка по тем же соображениям, что
  /// `TechCardMaterialLine.materialRole`.
  materialRole String?
  /// Имя строки техкарты / snapshot-строки на момент расчёта.
  /// Используется в `description`-fallback и для UI-таблицы.
  sourceName   String?
  /// Готовое человекочитаемое описание потребности — то, что
  /// закупщик ищет/покупает («Кулирка 180 г/м², чёрный, ширина 180
  /// см»). Пишется в момент расчёта, в БД хранится «как есть».
  description  String

  fabricType     String?
  densityGsm     Int?
  plannedWidthCm Int?

  /// Snapshot-копии правила цвета и фиксированного цвета — на тот
  /// случай, если строку техкарты позже отредактируют.
  colorRule         String?
  fixedColorText    String?
  /// Итоговый цвет, выведенный по `colorRule` в момент расчёта.
  resolvedColorText String?

  /// Суммарная площадь по всем размерам заказа, м² (только для
  /// `AREA_DENSITY`). Сумма `Σ(areaM2 × qtyPlan)` по
  /// `PatternMaterialArea` для роли материала. `null` для
  /// `QTY_PER_UNIT`.
  totalAreaM2   Decimal? @db.Decimal(14, 4)
  /// Чистая потребность, рассчитанная системой. Единица — `unit`.
  /// Для `AREA_DENSITY`: `totalAreaM2 × densityGsm / 1000` (кг).
  /// Для `QTY_PER_UNIT`: `qtyPerUnit × totalOrderQty` или
  /// `requirement.totalQty`.
  calculatedQty Decimal  @db.Decimal(14, 4)
  /// Сколько закупщик решил реально купить/запросить. `null` пока
  /// закупщик не заполнил руками. НЕ копируется автоматически из
  /// `calculatedQty`.
  purchaseQty   Decimal? @db.Decimal(14, 4)
  unit          String

  /// `AREA_DENSITY` | `QTY_PER_UNIT`. Свободная строка ради
  /// расширения списка (см. `@sewing/shared/workshop-needs`).
  calculationMethod String @default("QTY_PER_UNIT")
  /// `CALCULATED` | `REVIEWED` | `PURCHASE_PLANNED` | `CANCELLED`.
  /// Дефолт `CALCULATED` — сразу после расчёта системой. Закупщик
  /// двигает руками. См. `@sewing/shared/workshop-needs`.
  status            String @default("CALCULATED")

  /// Текст поставщика, как его записал закупщик. Этап 5 «Поставщики»:
  /// поле сохранено как fallback, когда поставщика ещё нет в справочнике
  /// (`selectedSupplierId = null`) или когда закупщик хочет оставить
  /// «ручную» строку. UI показывает `selectedSupplier?.name` →
  /// `supplierNameText`. Никогда не перезаписывается при выборе
  /// `selectedSupplierId`.
  supplierNameText     String?
  /// Закупочная номенклатура текстом (например, «Кулирка 180 г/м²
  /// чёрный, рулон 50 м»). Этап 5: fallback к
  /// `selectedSupplierCatalogItem.name` (см. JSDoc выше).
  purchaseItemNameText String?
  quotedPrice          Decimal?  @db.Decimal(14, 2)
  quotedCurrency       String?
  expectedDeliveryDate DateTime?

  /// Этап 5 «Поставщики» (см. `model Supplier` ниже,
  /// `apps/api/src/modules/suppliers/*`,
  /// `docs/recon-soft-integration.md §«Этап 5»`).
  ///
  /// Опциональная связь с карточкой поставщика из справочника:
  ///   - `null`  — закупщик ещё не выбрал, работаем по `supplierNameText`;
  ///   - string — выбран конкретный Supplier (валидируется на сервисе:
  ///              существует и `status = ACTIVE`).
  ///
  /// `onDelete: SetNull` — удаление карточки поставщика не сносит
  /// потребность, связь обнуляется и UI снова показывает текстовый
  /// fallback.
  selectedSupplierId String?
  selectedSupplier   Supplier? @relation(fields: [selectedSupplierId], references: [id], onDelete: SetNull)

  /// Этап 5: опциональная ссылка на конкретную позицию каталога
  /// поставщика (артикул/название/единица/цена). Также nullable +
  /// `onDelete: SetNull` (на самом деле каталог-позиции мы физически
  /// не удаляем, а архивируем, см. сервис; SetNull — страховка для
  /// будущих ручных удалений).
  ///
  /// Если выбран `selectedSupplierCatalogItemId`, его
  /// `supplierId` обязан совпадать с `selectedSupplierId` (валидация
  /// в сервисе). Закупщик может сначала выбрать catalog item — тогда
  /// сервис подставит `selectedSupplierId = item.supplierId`
  /// автоматически.
  selectedSupplierCatalogItemId String?
  selectedSupplierCatalogItem   SupplierCatalogItem? @relation(fields: [selectedSupplierCatalogItemId], references: [id], onDelete: SetNull)

  comment         String?
  /// Технический комментарий, который пишет сам алгоритм расчёта:
  /// предупреждения о неполной площади по размерам, fallback и т.п.
  /// UI показывает его как warning-строку под `description`.
  calculationNote String?

  calculatedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Этап 6А «Заказы поставщикам» (см. `model PurchaseOrder` ниже).
  /// Строки закупочных документов, через которые эта потребность
  /// «уходит» к поставщику. На MVP закупщик создаёт PO именно из
  /// `WorkshopNeed`; обратная связь нужна для:
  ///   - валидации «нет ли уже активной строки PO» при попытке
  ///     создать новую (см. `PurchaseOrdersService.createFromNeeds`);
  ///   - возврата `WorkshopNeed.status` в `PURCHASE_PLANNED` при
  ///     отмене PO, если по этой потребности больше нет активных
  ///     `PurchaseOrderLine` (см. `PurchaseOrdersService.cancel`).
  /// `onDelete: SetNull` со стороны `PurchaseOrderLine.workshopNeedId`:
  /// удаление строки потребности (через cascade от заказа) не сносит
  /// уже выпущенный PO — он остаётся как закупочный документ с
  /// item snapshot.
  purchaseOrderLines PurchaseOrderLine[]

  /// Этап 7А «Приёмка поставок» (см. `model PurchaseReceiptLine`
  /// ниже). Строки приёмки, фактически закрывающие эту потребность.
  /// Используется и для списка «уже принято по этой потребности»,
  /// и для пересчёта `WorkshopNeed.status` (`PARTIALLY_RECEIVED`/
  /// `RECEIVED`) при создании/отмене приёмки. `onDelete: SetNull`
  /// со стороны `PurchaseReceiptLine.workshopNeedId`: удаление
  /// потребности (через cascade от заказа) не сносит акт приёмки.
  receiptLines PurchaseReceiptLine[]

  /// Этап «Себестоимость заказа» (см. `model OrderCostEstimateLine`
  /// ниже). Строки расчётов себестоимости, ссылающиеся на эту
  /// потребность как на источник. `onDelete: SetNull` со стороны
  /// `OrderCostEstimateLine.workshopNeedId`: удаление потребности
  /// (через cascade от заказа) не сносит уже завершённый расчёт —
  /// строка остаётся как исторический срез.
  costEstimateLines OrderCostEstimateLine[]

  /// Этап «Ручная отметка поступления материала» (см.
  /// `model OrderMaterialArrivalOverride` ниже). Активные ACTIVE-overrides
  /// учитываются `CutReadinessService` как «материал поступил» —
  /// прибавляются к `placedQty` для проверки готовности к крою.
  /// `onDelete: SetNull` со стороны `OrderMaterialArrivalOverride.workshopNeedId`:
  /// удаление потребности (через cascade от заказа) не сносит override.
  materialArrivalOverrides OrderMaterialArrivalOverride[]

  /// Этап «Фактический расход материалов по заказу» (см.
  /// `model MaterialIssueLine` ниже). Строки расхода, в которых
  /// эта потребность указана как источник (description / unit /
  /// materialRole переносятся из `WorkshopNeed`). `onDelete: SetNull`
  /// со стороны `MaterialIssueLine.workshopNeedId`: удаление
  /// потребности (через cascade от заказа) не сносит уже выпущенный
  /// документ расхода — он остаётся как исторический срез.
  materialIssueLines       MaterialIssueLine[]
  /// Строки документов возврата `MaterialIssueReturnLine`,
  /// опционально привязанные к этой потребности (см. `model
  /// MaterialIssueReturnLine` ниже). `onDelete: SetNull` —
  /// удаление потребности (через cascade от заказа) не сносит
  /// уже созданный документ возврата.
  materialIssueReturnLines MaterialIssueReturnLine[]

  /// Foundation складского учёта: текущий остаток по потребности заказа.
  stockBalances  StockBalance[]
  /// Foundation: журнал движений (ещё не вызывается из приёмки/расхода).
  stockMovements StockMovement[]

  @@index([orderId])
  @@index([status])
  @@index([materialRole])
  @@index([calculationMethod])
  @@index([selectedSupplierId])
  @@index([selectedSupplierCatalogItemId])
}

// ---------------------------------------------------------------------------
// Suppliers (Этап 5 «Справочник поставщиков»)
//
// Управленческий справочник контрагентов и их закупочной номенклатуры.
// Сознательно изолирован от закупочного контура (нет PurchaseOrder, нет
// приёмки, нет складских ячеек, нет остатков). На этом этапе цель —
// дать закупщику место, где можно один раз завести поставщика, его
// контакты и список регулярно покупаемых позиций, и потом выбирать их
// в `WorkshopNeed`. Связь с `WorkshopNeed` сознательно мягкая: текстовые
// `supplierNameText` / `purchaseItemNameText` остаются как fallback,
// пока справочник пуст.
//
// Дизайн:
//   - `Supplier.status` хранится как String (без Prisma enum), список
//     валидируется Zod-ом по `SUPPLIER_STATUSES` в
//     `@sewing/shared/suppliers`. Расширение списка не требует миграции;
//   - `SupplierContact` — отдельная таблица «контакты менеджеров»
//     внутри одной карточки поставщика (one-to-many);
//   - `SupplierCatalogItem` — каталог позиций, которые этот поставщик
//     продаёт. `lastPrice` и `currency` — последняя предложенная цена
//     (закупщик руками подтверждает `quotedPrice` в `WorkshopNeed`,
//     backend lastPrice автоматически НЕ копирует);
//   - физического удаления Supplier не делаем (`PATCH status = INACTIVE`),
//     контакты можно удалять физически, catalog item — soft-archive
//     через `status = INACTIVE` (см. сервис).
//
// RBAC — `ADMIN` / `SHOP_MANAGER` (см. `apps/api/src/modules/suppliers/*`).
// Аудит — события `SUPPLIER_*` через универсальный `AuditService`.
// ---------------------------------------------------------------------------

model Supplier {
  id        String   @id @default(cuid())
  /// Человекочитаемое название поставщика (в UI первично). Не уникально:
  /// у двух разных юр-лиц вполне может быть одно и то же бытовое имя.
  name      String
  phone     String?
  website   String?
  address   String?
  comment   String?
  /// Статус карточки. Дефолт `ACTIVE`. Хранится строкой, чтобы расширять
  /// список без миграции (см. `SUPPLIER_STATUSES` в
  /// `@sewing/shared/suppliers`). UI скрывает не-`ACTIVE` поставщиков
  /// из селекта в `WorkshopNeed`; backend дополнительно блокирует выбор
  /// неактивного `Supplier` через `SupplierInactiveException`.
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts         SupplierContact[]
  catalogItems     SupplierCatalogItem[]
  workshopNeeds    WorkshopNeed[]
  /// Этап 6А «Заказы поставщикам» (см. `model PurchaseOrder` ниже).
  /// Закупочные документы, выписанные на этого поставщика. Удаление
  /// поставщика блокируется RESTRICT-ом со стороны
  /// `PurchaseOrder.supplierId` — нельзя «потерять» поставщика,
  /// если есть открытый PO; на MVP мы вообще не удаляем Supplier
  /// (status = INACTIVE).
  purchaseOrders   PurchaseOrder[]
  /// Этап 7А «Приёмка поставок» (см. `model PurchaseReceipt` ниже).
  /// Документы фактической приёмки, в snapshot которых попал этот
  /// поставщик. `onDelete: SetNull` со стороны
  /// `PurchaseReceipt.supplierId`: даже при удалении карточки
  /// поставщика акт приёмки уцелеет — поля
  /// `supplierNameSnapshot/...` уже зафиксированы.
  purchaseReceipts PurchaseReceipt[]

  @@index([status])
  @@index([name])
}

/// Контакт менеджера у поставщика (one-to-many от `Supplier`).
/// Минимально достаточный набор полей для записной книжки закупщика,
/// без CRM-логики. `isPrimary` — мягкая отметка «основной контакт»;
/// uniqueness НЕ enforce-им, чтобы менеджер мог временно поставить
/// флаг на двух людях, если идёт пересменка.
model SupplierContact {
  id         String   @id @default(cuid())
  supplierId String
  name       String
  position   String?
  phone      String?
  email      String?
  /// Произвольный мессенджер (Telegram, WhatsApp, ник и т.п.). Свободная
  /// строка; никаких deeplink-ов на MVP, чтобы не плодить регэкспы.
  messenger  String?
  isPrimary  Boolean  @default(false)
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

/// Позиция в каталоге поставщика — конкретная номенклатура, которую он
/// продаёт. Один Supplier → много `SupplierCatalogItem`.
///
/// Сознательно много nullable-полей: на старте закупщик может завести
/// строку с одним именем и единицей, а параметры (плотность/ширина/цена)
/// дополнить позже.
///
/// Уникальность `(supplierId, supplierArticle)` НЕ накладываем:
/// `supplierArticle` может быть `null` или дублироваться у редких
/// поставщиков с разнобоем в номенклатуре.
model SupplierCatalogItem {
  id              String   @id @default(cuid())
  supplierId      String
  /// Человекочитаемое название позиции, как закупщик её называет
  /// в письмах поставщику.
  name            String
  /// Артикул в системе поставщика. Опционально; если задан, должен
  /// быть уникален в рамках поставщика (валидируется в сервисе мягко).
  supplierArticle String?
  category        String?
  /// Тип полотна / материала (кулирка, двунитка, …) — совпадает
  /// семантически с `TechCardMaterialLine.fabricType`. Свободная строка.
  fabricType      String?
  densityGsm      Int?
  /// Цвет позиции. Свободная строка (часто это конкретный pantone-код
  /// или фабричное название цвета).
  colorText       String?
  /// Единица измерения, в которой поставщик продаёт позицию (`кг`, `м`,
  /// `шт`, `рулон`).
  unit            String
  /// Последняя предложенная цена за единицу. Backend сюда автоматически
  /// ничего не копирует — менеджер заносит её при обновлении карточки;
  /// UI «Потребность цеха» показывает её как подсказку, но в `quotedPrice`
  /// строки `WorkshopNeed` подставляется только по явному действию
  /// закупщика.
  lastPrice       Decimal? @db.Decimal(14, 2)
  currency        String?
  /// Минимальная партия заказа в `unit`. На MVP — справочное поле для
  /// UI; backend не enforce-ит «не покупать меньше».
  minOrderQty     Decimal? @db.Decimal(14, 4)
  deliveryDays    Int?
  comment         String?
  /// Статус позиции. Дефолт `ACTIVE`. DELETE через UI переводит в
  /// `INACTIVE` (soft-archive), физического удаления нет — это
  /// инвариант MVP: уже выбранную в `WorkshopNeed` строку нельзя
  /// «потерять» из истории.
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  supplier           Supplier              @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  workshopNeeds      WorkshopNeed[]
  /// Этап 6А «Заказы поставщикам». Строки закупочных документов,
  /// в которых выбрана эта позиция каталога. `onDelete: SetNull` со
  /// стороны `PurchaseOrderLine.supplierCatalogItemId`: позицию
  /// можно физически удалить (на MVP это не делается, только
  /// архивация), и snapshot строки PO не пропадёт.
  purchaseOrderLines PurchaseOrderLine[]
  /// Этап 7А «Приёмка поставок». Строки приёмки, в snapshot
  /// которых попала эта позиция каталога. `onDelete: SetNull` —
  /// каталог-позицию мы физически не удаляем (только архивация),
  /// но даже при ручном удалении строка приёмки уцелеет.
  receiptLines       PurchaseReceiptLine[]

  @@index([supplierId])
  @@index([status])
  @@index([fabricType])
  @@index([densityGsm])
}

// ---------------------------------------------------------------------------
// Purchase orders (Этап 6А «Заказы поставщикам», MVP)
//
// Закупочный документ: один заказ поставщику объединяет одну или
// несколько строк `PurchaseOrderLine`, каждая из которых ссылается
// на исходную `WorkshopNeed`. Сознательная граница MVP:
//   - НЕТ приёмки, НЕТ MaterialReceipt / FabricRoll;
//   - НЕТ связи со складскими ячейками / WMS;
//   - НЕТ оплаты поставщику / финансовых документов;
//   - НЕТ закрытия PO по приёмке;
//   - НЕТ новых ролей (`PURCHASER`/`WAREHOUSE_KEEPER`/...) —
//     RBAC завязан на существующие `ADMIN`/`SHOP_MANAGER`
//     (см. `apps/api/src/modules/purchase-orders/*`).
//
// Snapshot-инварианты (см. `PurchaseOrdersService.createFromNeeds`):
//   - в момент создания фиксируем supplier-snapshot
//     (`supplierNameSnapshot`/`supplierPhoneSnapshot`/
//     `supplierWebsiteSnapshot`/`supplierAddressSnapshot`),
//     чтобы карточка PO жила независимо от поздних правок
//     `Supplier`;
//   - в момент создания каждой строки фиксируем item-snapshot
//     (`itemNameSnapshot`/`supplierArticleSnapshot`/
//     `unitSnapshot`/`catalogLastPriceSnapshot`), чтобы строка
//     не «теряла» имя/единицу при архивации каталога;
//   - `qty` копируется из `WorkshopNeed.purchaseQty`,
//     `price` — из `WorkshopNeed.quotedPrice` (если задан),
//     `expectedDeliveryDate` — из `WorkshopNeed.expectedDeliveryDate`.
//
// Статусы (свободная строка, без Prisma enum — список расширяется
// без миграции; см. `@sewing/shared/purchase-orders`):
//   - `DRAFT`     — только что создан, можно редактировать строки;
//   - `SENT`      — отправлен поставщику (зафиксированы `sentAt`,
//                   все активные строки → `SENT`);
//   - `CONFIRMED` — поставщик подтвердил (зафиксированы `confirmedAt`
//                   и опционально `confirmedQty`/`confirmedPrice`/
//                   `confirmedDeliveryDate` в строках);
//   - `CANCELLED` — заказ отменён, строки → `CANCELLED`,
//                   связанные `WorkshopNeed` возвращаются в
//                   `PURCHASE_PLANNED`, если по ним больше нет
//                   активных строк.
// ---------------------------------------------------------------------------

model PurchaseOrder {
  id     String @id @default(cuid())
  /// Уникальный человекочитаемый номер вида `PO-YYYYMMDD-NNNN`.
  /// Генерация — `PurchaseOrderNumberService` по той же схеме,
  /// что `OrderNumberService.nextNumber()`.
  number String @unique

  /// Карточка поставщика. `onDelete: Restrict` — на MVP мы не
  /// удаляем `Supplier` в принципе (status = INACTIVE), а если
  /// удаление и появится, оно не должно «потерять» PO.
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  /// Snapshot полей поставщика на момент создания PO. Защищает
  /// карточку PO от поздних правок `Supplier`: даже если менеджер
  /// сменил телефон/адрес, в карточке PO видно «как было».
  supplierNameSnapshot    String
  supplierPhoneSnapshot   String?
  supplierWebsiteSnapshot String?
  supplierAddressSnapshot String?

  /// Заказ покупателя, к которому относится этот PO (если все
  /// строки PO взяты из потребностей одного заказа покупателя).
  /// На MVP мы запрещаем смешивать потребности разных заказов
  /// в одном PO (см. `PurchaseOrderNeedsDifferentOrdersException`).
  /// `onDelete: SetNull` — удаление заказа покупателя не сносит
  /// PO, обратная ссылка просто обнуляется.
  customerOrderId String?
  customerOrder   Order?  @relation(fields: [customerOrderId], references: [id], onDelete: SetNull)

  /// Жизненный цикл PO. Свободная строка по той же причине, что и
  /// `WorkshopNeed.status` / `Supplier.status` — список расширяется
  /// без миграции БД.
  status String @default("DRAFT")

  expectedDeliveryDate DateTime?
  sentAt               DateTime?
  confirmedAt          DateTime?
  cancelledAt          DateTime?

  comment String?

  /// Кто создал PO. `onDelete: SetNull` — учётка может быть
  /// деактивирована/удалена, а закупочный документ должен уцелеть.
  createdById String?
  createdBy   Employee? @relation("PurchaseOrderCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines            PurchaseOrderLine[]
  /// Этап 7А «Приёмка поставок» (см. `model PurchaseReceipt` ниже).
  /// Документы фактической приёмки, оформленные по этому PO.
  /// `onDelete: Restrict` со стороны `PurchaseReceipt.purchaseOrderId`:
  /// нельзя удалить PO, по которому уже есть приёмка (на MVP
  /// ручного удаления PO нет — только `CANCELLED`).
  purchaseReceipts PurchaseReceipt[]

  @@index([supplierId])
  @@index([customerOrderId])
  @@index([status])
  @@index([expectedDeliveryDate])
  @@index([createdAt])
}

/// Строка закупочного документа: одна `WorkshopNeed` → одна
/// `PurchaseOrderLine` в транзакции `createFromNeeds`. На MVP
/// строки PO друг другу не «склеиваются» — даже если две
/// потребности с одинаковой номенклатурой, мы создаём две
/// строки, чтобы сохранить связь с исходными `WorkshopNeed`.
model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  /// Связь с исходной потребностью цеха (для аудита и для
  /// возврата `WorkshopNeed.status` в `PURCHASE_PLANNED` при
  /// отмене PO). `onDelete: SetNull` — потребность может быть
  /// удалена через cascade от заказа покупателя, а строка PO
  /// должна уцелеть как закупочный документ.
  workshopNeedId String?
  workshopNeed   WorkshopNeed? @relation(fields: [workshopNeedId], references: [id], onDelete: SetNull)

  /// Связь с конкретной позицией каталога поставщика, если она
  /// была выбрана в момент создания PO. `onDelete: SetNull` —
  /// каталог-позицию на MVP физически не удаляем, но снимок
  /// всё равно живёт независимо.
  supplierCatalogItemId String?
  supplierCatalogItem   SupplierCatalogItem? @relation(fields: [supplierCatalogItemId], references: [id], onDelete: SetNull)

  /// Snapshot имени позиции (приоритет:
  /// `selectedSupplierCatalogItem.name` →
  /// `WorkshopNeed.purchaseItemNameText` → `WorkshopNeed.description`).
  itemNameSnapshot         String
  /// Snapshot артикула позиции в каталоге поставщика.
  supplierArticleSnapshot  String?
  /// Snapshot единицы измерения (приоритет:
  /// `selectedSupplierCatalogItem.unit` → `WorkshopNeed.unit`).
  unitSnapshot             String
  /// Snapshot последней цены каталога на момент создания PO.
  /// Хранится отдельно от `price`, чтобы было видно «у поставщика
  /// в каталоге было X, мы заказали по Y».
  catalogLastPriceSnapshot Decimal? @db.Decimal(14, 2)

  /// Закупочное количество. Копируется из `WorkshopNeed.purchaseQty`.
  /// Decimal(14, 4) совпадает с `WorkshopNeed.purchaseQty` —
  /// snapshot ровно в той же точности.
  qty                  Decimal   @db.Decimal(14, 4)
  /// Закупочная цена за единицу. Копируется из
  /// `WorkshopNeed.quotedPrice`; если не задан — оставляем `null`,
  /// автоматически из `catalog.lastPrice` НЕ берём (см. ТЗ §6).
  price                Decimal?  @db.Decimal(14, 2)
  currency             String?
  expectedDeliveryDate DateTime?

  /// Подтверждённое поставщиком количество (опционально). Заполняется
  /// в момент `confirm`, если поставщик прислал реальные цифры.
  confirmedQty          Decimal?  @db.Decimal(14, 4)
  confirmedPrice        Decimal?  @db.Decimal(14, 2)
  confirmedDeliveryDate DateTime?

  /// Жизненный цикл строки. Эволюционирует параллельно с
  /// `PurchaseOrder.status`, но строка может быть переведена
  /// руками в `CANCELLED` независимо от заголовка (на MVP UI
  /// этого не делает, но API позволяет).
  status String @default("DRAFT")

  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Этап 7А «Приёмка поставок». Строки фактической приёмки,
  /// привязанные к этой строке PO. По ним пересчитывается
  /// `PurchaseOrderLine.status` (`PARTIALLY_RECEIVED`/`RECEIVED`) и
  /// заголовок PO. `onDelete: SetNull` со стороны
  /// `PurchaseReceiptLine.purchaseOrderLineId`: даже при ручном
  /// удалении строки PO акт приёмки уцелеет.
  receiptLines PurchaseReceiptLine[]

  @@index([purchaseOrderId])
  @@index([workshopNeedId])
  @@index([supplierCatalogItemId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Purchase receipts (Этап 7А «Приёмка поставок», MVP)
//
// Документ фактической приёмки материала/позиции по конкретному
// `PurchaseOrder`. Сознательная граница MVP:
//   - НЕТ полноценного складского остатка: размещение хранится
//     прямо в `PurchaseReceiptLine.cellId` и НЕ создаёт записей
//     `CellContent` / `MaterialStock` / `FabricRoll`;
//   - НЕТ перемещений между ячейками, НЕТ списания в крой;
//   - НЕТ блокировки кроя или паспортов;
//   - НЕТ оплаты поставщику;
//   - НЕТ новых ролей (`PURCHASER`/`WAREHOUSE_KEEPER`/...) —
//     RBAC завязан на существующие `ADMIN`/`SHOP_MANAGER`.
//
// Snapshot-инварианты (см. `PurchaseReceiptsService.createFromPurchaseOrder`):
//   - в момент создания фиксируем supplier-snapshot из снимков PO
//     (`supplierNameSnapshot` и т.д.);
//   - по каждой строке фиксируем item-snapshot из строки PO
//     (`itemNameSnapshot`/`supplierArticleSnapshot`/`unitSnapshot`/
//     `orderedQtySnapshot`/`confirmedQtySnapshot`/`priceSnapshot`/
//     `currencySnapshot`).
//
// Статусы (свободная строка, без Prisma enum — список расширяется
// без миграции; см. `@sewing/shared/purchase-receipts`):
//   - `POSTED`    — нормальный документ приёмки;
//   - `CANCELLED` — отменён, при отмене строки тоже становятся
//                   `CANCELLED`, статусы PO/PO-line/WorkshopNeed
//                   пересчитываются обратно.
// ---------------------------------------------------------------------------

model PurchaseReceipt {
  id     String @id @default(cuid())
  /// Уникальный человекочитаемый номер вида `PR-YYYYMMDD-NNNN`.
  /// Генерация — `PurchaseReceiptNumberService.nextNumber()` по
  /// той же схеме, что `PurchaseOrderNumberService`.
  number String @unique

  /// Закупочный документ, по которому идёт приёмка.
  /// `onDelete: Restrict` — нельзя физически снести PO, по
  /// которому уже есть приёмка (на MVP PO не удаляются вовсе,
  /// только `CANCELLED`).
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)

  /// Карточка поставщика. Опционально + `onDelete: SetNull`:
  /// snapshot-поля ниже сохраняются как «было» даже после
  /// удаления карточки.
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  /// Snapshot-поля поставщика на момент приёмки. Копируются из
  /// одноимённых полей `PurchaseOrder` (которые сами snapshot-ом
  /// зафиксированы в момент создания PO).
  supplierNameSnapshot    String?
  supplierPhoneSnapshot   String?
  supplierWebsiteSnapshot String?
  supplierAddressSnapshot String?

  /// Заказ покупателя, к которому относится PO (если у PO есть
  /// `customerOrderId`). Денормализуется здесь, чтобы фильтровать
  /// приёмки по заказу покупателя без join-а через PO.
  /// `onDelete: SetNull` — удаление заказа покупателя не сносит
  /// акт приёмки.
  customerOrderId String?
  customerOrder   Order?  @relation(fields: [customerOrderId], references: [id], onDelete: SetNull)

  /// Жизненный цикл документа. Свободная строка по той же
  /// причине, что и `PurchaseOrder.status` — список расширяется
  /// без миграции БД.
  status String @default("POSTED")

  /// Когда фактически принят товар. Дефолт — момент создания.
  receivedAt  DateTime  @default(now())
  cancelledAt DateTime?

  /// Кто принял (закупщик/кладовщик). `onDelete: SetNull` —
  /// деактивация/удаление учётки не сносит документ приёмки.
  receivedById String?
  receivedBy   Employee? @relation("PurchaseReceiptReceiver", fields: [receivedById], references: [id], onDelete: SetNull)

  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines PurchaseReceiptLine[]

  /// Foundation: движения с привязкой к приёмке (FK опционален, бизнес-flow пока не пишет).
  stockMovements StockMovement[]

  @@index([purchaseOrderId])
  @@index([supplierId])
  @@index([customerOrderId])
  @@index([status])
  @@index([receivedAt])
  @@index([createdAt])
}

/// Строка фактической приёмки. Одна строка `PurchaseReceiptLine`
/// = одна позиция (рулон/упаковка/партия), уехавшая в одну
/// `Cell`. На MVP «куда положили» хранится прямо здесь
/// (`cellId`), без записей в `CellContent`.
model PurchaseReceiptLine {
  id String @id @default(cuid())

  purchaseReceiptId String
  purchaseReceipt   PurchaseReceipt @relation(fields: [purchaseReceiptId], references: [id], onDelete: Cascade)

  /// Связь со строкой закупочного документа. По ней backend
  /// пересчитывает статус строки PO. `onDelete: SetNull` —
  /// при ручном удалении строки PO акт приёмки уцелеет.
  purchaseOrderLineId String?
  purchaseOrderLine   PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id], onDelete: SetNull)

  /// Денормализованная связь с потребностью цеха (берётся из
  /// `purchaseOrderLine.workshopNeedId`). По ней backend
  /// пересчитывает статус `WorkshopNeed`. `onDelete: SetNull` —
  /// при удалении строки потребности (cascade от заказа) акт
  /// приёмки уцелеет.
  workshopNeedId String?
  workshopNeed   WorkshopNeed? @relation(fields: [workshopNeedId], references: [id], onDelete: SetNull)

  /// Денормализованная связь с конкретной позицией каталога
  /// поставщика (берётся из `purchaseOrderLine.supplierCatalogItemId`).
  /// `onDelete: SetNull` — каталог-позиции мы физически не
  /// удаляем, но и при ручном удалении строка приёмки уцелеет.
  supplierCatalogItemId String?
  supplierCatalogItem   SupplierCatalogItem? @relation(fields: [supplierCatalogItemId], references: [id], onDelete: SetNull)

  /// Snapshot номенклатуры на момент приёмки. Копируется из
  /// строки PO, чтобы документ приёмки оставался читаемым,
  /// даже если PO/каталог потом отредактируют.
  itemNameSnapshot        String
  supplierArticleSnapshot String?
  unitSnapshot            String
  orderedQtySnapshot      Decimal? @db.Decimal(14, 4)
  confirmedQtySnapshot    Decimal? @db.Decimal(14, 4)
  priceSnapshot           Decimal? @db.Decimal(14, 2)
  currencySnapshot        String?

  /// Фактически принятое количество в `unit`. Decimal(14,4)
  /// совпадает с `PurchaseOrderLine.qty` — snapshot ровно в
  /// той же точности.
  receivedQty Decimal @db.Decimal(14, 4)
  /// Единица фактически принятого количества (обычно совпадает
  /// с `unitSnapshot`, но допускается отклонение, если поставщик
  /// прислал в другой фасовке).
  unit        String

  /// Фактические параметры партии — заполняет приёмщик. Используется
  /// для прослеживаемости, никаких бизнес-инвариантов на MVP не
  /// накладывается (но конкретные поля специально оставлены, чтобы
  /// не плодить free-form JSON).
  batchNumber      String?
  rollNumber       String?
  shade            String?
  actualWidthCm    Int?
  actualDensityGsm Int?

  /// Размещение в физической ячейке. Опционально — закупщик может
  /// принять без выбора ячейки (например, материал ушёл напрямую в
  /// крой). `onDelete: SetNull` — удаление ячейки (на MVP не
  /// делается) не сносит акт приёмки.
  cellId       String?
  cell         Cell?   @relation(fields: [cellId], references: [id], onDelete: SetNull)
  /// Free-form подсказка по месту хранения для ситуаций, когда
  /// конкретной `Cell` ещё нет (например, паллета в проходе).
  locationNote String?

  /// Жизненный цикл строки. На MVP полностью совпадает со статусом
  /// заголовка `PurchaseReceipt` — `POSTED` → `CANCELLED` при
  /// отмене документа.
  status String @default("POSTED")

  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockMovements StockMovement[]

  @@index([purchaseReceiptId])
  @@index([purchaseOrderLineId])
  @@index([workshopNeedId])
  @@index([supplierCatalogItemId])
  @@index([cellId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Order applications (этап «Нанесение на заказе покупателя»)
//
// До этого этапа нанесение жило в техкарте (`TechCardOutsourceLine` с
// ролью «нанесение») и фиксировалось в `OrderOutsourceRequirement` при
// запуске заказа. На практике параметры конкретного нанесения
// (тип, размер, количество, цвет, файл макета) — атрибут заказа
// покупателя, а не шаблона техкарты: один и тот же шаблон может
// использоваться для заказов с разными нанесениями.
//
// Модель сознательно простая (additive, без изменения существующих
// таблиц / моделей):
//   - `type` — тип нанесения (SCREEN_PRINT / DTF / EMBROIDERY /
//     HEAT_TRANSFER / SUBLIMATION / OTHER). Хранится строкой, без
//     Prisma enum, чтобы расширять список без миграций. Источник
//     истины для допустимых значений — `@sewing/shared/order-applications`.
//   - `stage` — когда выполняется (`CUT_PARTS` — на крое / на
//     деталях до пошива; `FINISHED_ITEM` — на готовом изделии).
//     От этого зависит логика «Готовность к крою»: CUT_PARTS с
//     неполными данными блокирует крой, FINISHED_ITEM не блокирует.
//   - `placement`, `widthMm`, `heightMm`, `colorsCount`, `quantity`,
//     `unit`, `colorText`, `description`, `comment`, `fileUrl` —
//     параметры конкретного нанесения. Все nullable: менеджер может
//     завести «черновик» нанесения (только тип + stage) и постепенно
//     заполнить остальное.
//   - `status` — `PLANNED` / `SENT` / `DONE` / `CANCELLED`. Тоже
//     строкой, без enum.
//
// Старые `TechCardOutsourceLine` / `OrderOutsourceRequirement` НЕ
// удаляются — они остаются legacy-fallback на случай заказов,
// которые ещё не получили `OrderApplication`. Маршрут не меняется:
// нанесение НЕ становится новым шагом маршрута, не добавляется в
// `OrderRouteStep`. Это сознательная граница этапа.
// ---------------------------------------------------------------------------

model OrderApplication {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Тип нанесения. Список — `ORDER_APPLICATION_TYPES` в
  /// `@sewing/shared/order-applications`. Хранится строкой
  /// (без Prisma enum), список расширяется без миграции.
  type String

  /// Когда выполняется: `CUT_PARTS` (на крое) или `FINISHED_ITEM`
  /// (на готовом изделии). От `stage` зависит, блокирует ли
  /// нанесение готовность к крою (см. `CutReadinessService`).
  stage String @default("CUT_PARTS")

  /// Место нанесения (например, «грудь», «спина», «рукав»).
  /// Свободная строка.
  placement   String?
  /// Ширина / высота макета в мм. Для проверки готовности к крою
  /// и описания потребности цеха.
  widthMm     Int?
  heightMm    Int?
  /// Количество цветов (для шелкографии и т.п.).
  colorsCount Int?

  /// Количество нанесений. Если null — `WorkshopNeedsService`
  /// фоллбэчит на `Σ OrderItem.qtyPlan` (всё изделие = одно нанесение).
  quantity Decimal? @db.Decimal(14, 4)
  /// Единица измерения (по умолчанию «шт»).
  unit     String   @default("шт")

  /// Свободное описание цвета («белый», «PMS 185 C», «как на образце»).
  colorText   String?
  /// Свободное описание (например, текст принта).
  description String?
  /// Комментарий менеджера / для подрядчика.
  comment     String?
  /// Опциональный файл макета (PNG / SVG / PDF / DXF). На MVP —
  /// просто URL, без media-handler-а: загрузка файла может появиться
  /// в следующих этапах.
  fileUrl     String?

  /// `PLANNED` (по умолчанию) → `SENT` (отправлено подрядчику) →
  /// `DONE` (выполнено) | `CANCELLED`. Хранится строкой.
  status String @default("PLANNED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([type])
  @@index([stage])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Order cost estimates (этап «Себестоимость заказа»)
//
// См. `apps/api/src/modules/orders/orders.service.ts` —
// `completeCalculation` / `reopenCalculation`,
// `packages/shared/src/order-cost-estimates.ts`.
//
// Документ «Себестоимость заказа» — снимок цен/количеств/валют, с
// которыми закупщик завершил расчёт. Строки берутся из
// `WorkshopNeed` на момент завершения, но НЕ являются их FK-копией:
// исходные потребности продолжают жить своей жизнью (их редактирует
// закупщик, по ним создаются `PurchaseOrder`/`PurchaseReceipt`),
// а `OrderCostEstimate` остаётся неизменным историческим срезом.
//
// Дизайн:
//   - один заказ может иметь много `OrderCostEstimate` (история
//     «расчёт → reopen → новый расчёт»). Активный — `status =
//     COMPLETED`; повторное завершение помечает старый как
//     `REVOKED` и создаёт новый с `version = max + 1` (см.
//     `@@unique([orderId, version])`);
//   - `status` хранится строкой, валидация через Zod-enum
//     `OrderCostEstimateStatusSchema`;
//   - все цены копируются «как есть» в `OrderCostEstimateLine`
//     вместе с курсом USD на момент завершения и snapshot-именами
//     поставщика и номенклатуры — расчёт не должен «плыть» вслед за
//     поздним переименованием поставщика / номенклатуры.
// ---------------------------------------------------------------------------

model OrderCostEstimate {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Порядковый номер расчёта по этому заказу (`max(version) + 1` на
  /// каждом «Завершить расчёт»). Уникальность гарантирует, что два
  /// конкурирующих completeCalculation не создадут дубликат.
  version Int

  /// `COMPLETED` | `REVOKED` (см.
  /// `@sewing/shared/order-cost-estimates::ORDER_COST_ESTIMATE_STATUSES`).
  status String @default("COMPLETED")

  /// Итог по всем строкам в рублях (после конвертации USD по
  /// `usdRateRub`). Decimal(14,2) — копейки.
  totalCostRub Decimal @db.Decimal(14, 2)

  /// Курс USD к рублю, выбранный закупщиком на момент завершения
  /// расчёта. Заполняется только если хотя бы одна строка в USD;
  /// иначе `null`. Decimal(14,4) — четыре знака после запятой
  /// достаточно для бизнес-курсов.
  usdRateRub Decimal? @db.Decimal(14, 4)

  /// Когда расчёт был завершён.
  completedAt   DateTime  @default(now())
  /// Кто завершил (нажал «Завершить расчёт»). `onDelete: SetNull` —
  /// деактивация/удаление учётки не сносит исторический документ.
  completedById String?
  completedBy   Employee? @relation("OrderCostEstimateCompleter", fields: [completedById], references: [id], onDelete: SetNull)

  /// Когда расчёт был отозван (`reopenCalculation`). `null` для
  /// активных `COMPLETED`-расчётов и для расчётов, которые ни разу
  /// не отзывали.
  revokedAt   DateTime?
  revokedById String?
  revokedBy   Employee? @relation("OrderCostEstimateRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

  /// Произвольный комментарий: что отличает этот расчёт (см.
  /// `CompleteOrderCalculationSchema.comment`) или причина reopen
  /// (см. `ReopenOrderCalculationSchema.reason`).
  comment String?

  lines OrderCostEstimateLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, version])
  @@index([orderId])
  @@index([status])
}

model OrderCostEstimateLine {
  id String @id @default(cuid())

  estimateId String
  estimate   OrderCostEstimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  /// Опциональная ссылка на исходную `WorkshopNeed`. На момент
  /// завершения расчёта она существует, но дальше может быть
  /// удалена (через cascade от заказа на reopen-snapshot-расчёте
  /// — невозможно, потому что `OrderCostEstimate` тоже cascade
  /// от заказа; здесь страховка на случай ручного удаления). При
  /// SetNull строка остаётся самодостаточной за счёт snapshot-полей.
  workshopNeedId String?
  workshopNeed   WorkshopNeed? @relation(fields: [workshopNeedId], references: [id], onDelete: SetNull)

  /// `TECH_CARD_MATERIAL_LINE` | `ORDER_MATERIAL_REQUIREMENT` |
  /// `ORDER_APPLICATION` | `PATTERN_PARAMETER_NORM` — переписан
  /// напрямую с `WorkshopNeed.sourceType` (без FK). Хранится
  /// строкой ради расширяемости.
  sourceType String?
  sourceId   String?

  /// `MATERIAL` | `HARDWARE` | `APPLICATION` | `OTHER` — классификация
  /// для блока «Себестоимость» в карточке заказа (по
  /// `getWorkshopNeedKind`). Хранится строкой, см.
  /// `@sewing/shared/order-cost-estimates::ORDER_COST_ESTIMATE_LINE_KINDS`.
  kind        String
  description String
  unit        String

  /// Сколько посчитала система (`WorkshopNeed.calculatedQty`); может
  /// быть `null`, если система ничего не считала (например, новая
  /// строка, которую закупщик добавил руками — на этом этапе UI
  /// этого не делает, но поле nullable «на будущее»).
  calculatedQty Decimal? @db.Decimal(14, 4)
  /// Сколько идём покупать (`WorkshopNeed.purchaseQty ?? calculatedQty`).
  purchaseQty   Decimal  @db.Decimal(14, 4)

  quotedPrice    Decimal @db.Decimal(14, 2)
  quotedCurrency String

  /// Курс USD на момент завершения расчёта (snapshot из
  /// `OrderCostEstimate.usdRateRub`). Дублируем в строку, чтобы
  /// строка была самодостаточной при выгрузке/анализе.
  usdRateRub Decimal? @db.Decimal(14, 4)

  /// `purchaseQty × quotedPrice` в исходной валюте.
  lineTotalOriginal Decimal @db.Decimal(14, 2)
  /// Тот же итог в рублях (для USD = `lineTotalOriginal × usdRateRub`).
  lineTotalRub      Decimal @db.Decimal(14, 2)

  /// Snapshot-имя поставщика на момент завершения расчёта
  /// (`Supplier.name` или `WorkshopNeed.supplierNameText`).
  /// Защищает завершённый расчёт от поздних правок справочника.
  supplierNameSnapshot     String?
  /// Snapshot-имя номенклатуры поставщика
  /// (`SupplierCatalogItem.name` или `WorkshopNeed.purchaseItemNameText`).
  purchaseItemNameSnapshot String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estimateId])
  @@index([workshopNeedId])
  @@index([kind])
}

// ---------------------------------------------------------------------------
// OrderMaterialArrivalOverride (этап «Ручная отметка поступления материала»)
//
// См. `apps/api/src/modules/order-material-arrivals/*`,
// `apps/api/src/modules/cut-readiness/cut-readiness.service.ts`,
// `apps/web/components/orders/cut-readiness-card.tsx`.
//
// Назначение: дать ADMIN/SHOP_MANAGER кнопку «Материал поступил» в
// карточке заказа, которая разблокирует крой даже если складская
// приёмка ещё не оформлена. Это сознательно НЕ складская операция:
//   - PurchaseReceipt / PurchaseReceiptLine не создаются;
//   - CellContent / складские остатки не меняются;
//   - WorkshopNeed.status не двигается (PURCHASE_PLANNED / ORDERED
//     / PARTIALLY_RECEIVED — только настоящая приёмка может перевести
//     потребность в RECEIVED).
//
// Это override готовности к крою, а не складская операция: запись
// существует исключительно ради учёта факта «менеджер сказал — крой
// можно начинать». `CutReadinessService` читает ACTIVE-строки и
// добавляет их `qty` (или, если `qty IS NULL`, считает покрытием
// `targetQty`) к `placedQty` — если итог >= `targetQty`, материал
// считается готовым.
//
// Дизайн:
//   - `status` хранится строкой (`ACTIVE`/`REVOKED`), валидация
//     Zod-листом `ORDER_MATERIAL_ARRIVAL_OVERRIDE_STATUSES` —
//     расширение списка не требует миграции;
//   - `comment` обязателен (валидируется Zod-ом) — ручная
//     разблокировка должна быть объяснена;
//   - `revokedAt`/`revokedById`/`revokeReason` заполняются при
//     ручной отмене — позволяет «откатить» override;
//   - `qty`/`unit` — snapshot из `WorkshopNeed`, чтобы строка была
//     самодостаточной для аудита, даже если потребность позже
//     отредактируют/удалят;
//   - все relation-ы `onDelete: SetNull`/`onDelete: Cascade`
//     согласованы со снимками: удаление заказа сносит override
//     (cascade), удаление потребности обнуляет `workshopNeedId`,
//     удаление учётки сотрудника не сносит исторический override.
// ---------------------------------------------------------------------------

model OrderMaterialArrivalOverride {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Опциональная привязка к конкретной строке `WorkshopNeed`. На MVP
  /// override всегда создаётся для конкретной потребности (через POST
  /// `/api/orders/:id/material-arrived` с `workshopNeedIds`), но поле
  /// nullable — потребность может быть удалена через cascade от заказа,
  /// а override остаётся для аудита.
  workshopNeedId String?
  workshopNeed   WorkshopNeed? @relation(fields: [workshopNeedId], references: [id], onDelete: SetNull)

  /// Snapshot-роль материала из `WorkshopNeed.materialRole` на момент
  /// создания override. Хранится строкой ради расширяемости (см.
  /// `@sewing/shared/material-roles`).
  materialRole String?
  /// Snapshot-описание потребности (`WorkshopNeed.description`/`sourceName`)
  /// — пишется в момент создания, чтобы строка была читаема даже после
  /// удаления потребности.
  description  String?

  /// Snapshot целевого количества (`purchaseQty ?? calculatedQty`) на
  /// момент создания override. Если `null` — считаем «покрытие
  /// targetQty» (см. `CutReadinessService`).
  qty  Decimal? @db.Decimal(14, 4)
  /// Snapshot единицы измерения (`WorkshopNeed.unit`).
  unit String?

  /// `ACTIVE` (по умолчанию) | `REVOKED`. Хранится строкой.
  status  String  @default("ACTIVE")
  /// Обязательный комментарий / причина — почему менеджер вручную
  /// разблокировал крой. Валидируется Zod-ом (`min(2)`).
  comment String?

  /// Кто создал. `onDelete: SetNull` со стороны Employee: удаление
  /// учётки не сносит исторический override.
  createdById String?
  createdBy   Employee? @relation("OrderMaterialArrivalOverrideCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  /// Когда отменён (если отменён). `null` для активных override-ов.
  revokedAt    DateTime?
  revokedById  String?
  revokedBy    Employee? @relation("OrderMaterialArrivalOverrideRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  /// Обязательная причина отмены — приходит из тела revoke-эндпоинта.
  revokeReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([workshopNeedId])
  @@index([status])
  @@index([materialRole])
}

// ---------------------------------------------------------------------------
// CompanySettings — реквизиты организации (singleton).
// ---------------------------------------------------------------------------
//
// Хранит юридические/банковские реквизиты компании, телефон/email/руководителей.
// Предположение MVP: одна компания на инсталляцию → singleton-таблица:
//   - `id` всегда `"default"` (фиксированная константа), `singleton = true`
//     с `@unique` — гарантирует на уровне БД, что строк не больше одной.
//   - сервис `CompanySettingsService.getOrCreate()` идемпотентно создаёт
//     запись с дефолтами при первом обращении (пустые строки → `null`).
//   - расширение «много компаний/филиалов» вне scope MVP: специально
//     отдельной осью введена `CompanyDivision` (см. ниже), а реквизиты
//     остаются у одного юрлица.
//
// Все поля реквизитов — `String?` без жёсткой длины: формат
// (10/12 цифр для INN и т.п.) валидируется в Zod-схемах
// `@sewing/shared/company-settings.ts`, а не в БД, чтобы не плодить
// миграцию при поправках формата.
//
// Audit: события `COMPANY_SETTINGS_UPDATED` пишутся `AuditService`-ом с
// `entityType = COMPANY_SETTINGS`, `entityId = "default"`.
// ---------------------------------------------------------------------------

model CompanySettings {
  /// Всегда `"default"` — singleton singleton-таблицы. Прибит вручную, чтобы
  /// можно было ссылаться на запись без отдельного lookup-а.
  id String @id @default("default")

  /// Marker singleton-инварианта: `true` + `@unique` ⇒ в таблице может быть
  /// максимум одна запись (вторая `INSERT` валится на уровне БД, без race-window).
  singleton Boolean @unique @default(true)

  /// Полное название организации («ООО „Швейная фабрика“»).
  legalName String?
  /// Краткое название организации («ШФ-1») — для шапок/печатных форм.
  shortName String?

  /// ИНН: 10 или 12 цифр (Zod проверяет формат).
  inn  String?
  /// КПП: 9 цифр.
  kpp  String?
  /// ОГРН: 13 или 15 цифр.
  ogrn String?

  legalAddress  String?
  actualAddress String?

  phone          String?
  email          String?
  directorName   String?
  accountantName String?

  /// Банковские реквизиты. Все поля свободные — формат проверяет Zod.
  bankName             String?
  /// БИК: 9 цифр.
  bik                  String?
  /// Корреспондентский счёт: 20 цифр.
  correspondentAccount String?
  /// Расчётный счёт: 20 цифр.
  settlementAccount    String?

  /// Hardening-флаг: автосписание материалов при выдаче кроя
  /// (`PassportsService.issueToEmployee` →
  /// `MaterialIssuesService.createAutoCutIssueForPassport`).
  ///
  /// Семантика:
  ///   - `false` (default) — выдача кроя сотруднику НЕ создаёт
  ///     `MaterialIssue`. Прочая транзакционная логика
  ///     `issueToEmployee` (события паспорта, статус, currentEmployee,
  ///     `CutReleasePolicy` / `OrderCutIssueRule`-учёт) работает
  ///     штатно.
  ///   - `true`  — `issueToEmployee` дополнительно вызывает
  ///     `createAutoCutIssueForPassport(tx, passportId, employeeId)`
  ///     в той же транзакции (создаётся POSTED `MaterialIssue` с
  ///     `source = AUTO_CUT_ISSUE`, см. JSDoc метода).
  ///
  /// Default `false` сознательно: после миграции production
  /// поведение НЕ меняется самостоятельно — переключение на
  /// автосписание остаётся явным действием владельца проекта
  /// (см. `docs/current-state.md §«Auto cut issue»`,
  /// `docs/erd.md §2.15`). Публичный DTO/PATCH
  /// `/api/company-settings` это поле НЕ принимает на этой итерации
  /// — UI-настройка ещё не утверждена; чтение делает
  /// `CompanySettingsService.getAutoIssueMaterialsOnCutRelease()`.
  autoIssueMaterialsOnCutRelease Boolean @default(false)

  /// Hardening-флаг: разрешать ли отрицательный `StockBalance.qty`
  /// при списании материалов в `MaterialIssue.post` /
  /// `AUTO_CUT_ISSUE`
  /// (см. `apps/api/src/modules/stock/stock.service.ts::applyMovementInTx`,
  /// `apps/api/src/modules/material-issues/material-issues.service.ts`,
  /// `docs/current-state.md §«Material issue → StockMovement OUT»`).
  ///
  /// Семантика:
  ///   - `true`  (default) — текущее MVP-поведение: `MaterialIssue.post`
  ///     и `AUTO_CUT_ISSUE` могут увести `StockBalance.qty` в минус.
  ///     `applyMovementInTx` пишет OUT-движение и no-location negative
  ///     balance, если положительного остатка нет.
  ///   - `false` — сервис проверяет достаточность остатка ДО записи
  ///     движения. При нехватке OUT не создаётся, `StockBalance` не
  ///     меняется, бросается доменная ошибка `MATERIAL_STOCK_INSUFFICIENT`
  ///     (409). Транзакция откатывается, `MaterialIssue` остаётся
  ///     `DRAFT` (для авто-выдачи кроя — `issueToEmployee` тоже падает,
  ///     потому что владелец явно запретил минус).
  ///
  /// Default `true` сознательно: после миграции production-flow НЕ
  /// меняется самостоятельно — переключение на жёсткую блокировку
  /// остаётся явным действием владельца проекта. Если строки
  /// `CompanySettings` ещё нет (свежая БД), backend трактует значение
  /// как `true` и не создаёт singleton-row по пути production-flow
  /// (см. `CompanySettingsService.getAllowNegativeMaterialStock()`).
  ///
  /// Флаг применяется ТОЛЬКО к OUT-движениям `MaterialIssue` (ручному
  /// `post` и `AUTO_CUT_ISSUE`). `PurchaseReceipt` cancel / REVERSAL
  /// OUT остаётся permissive — отмена приёмки бизнес-сценарий
  /// отдельной итерации.
  ///
  /// Публичный DTO/PATCH `/api/company-settings` это поле НЕ
  /// принимает на этой итерации (UI-настройка ещё не утверждена);
  /// чтение делает
  /// `CompanySettingsService.getAllowNegativeMaterialStock()`.
  allowNegativeMaterialStock Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// CompanyDivision — master-справочник «Подразделения компании».
// ---------------------------------------------------------------------------
//
// `CompanyDivision` — единственный источник истины «к какому
// подразделению относится заказ / экран цеха». На него ссылаются
// `Order.companyDivisionId` и `DisplayScreenConfig.companyDivisionId`
// (см. модели выше). Backend (`OrdersService` / `DisplayScreensService`
// / `EarningsService` / `ShopfloorService`) работает только с
// `CompanyDivision.code` — никаких параллельных enum-полей.
//
// Базовые карточки `MARKETPLACE` / `OTHER` (b2b) гарантированно
// существуют в БД: их upsert-ит миграция
// `…_link_company_divisions_to_orders`, а `prisma/seed.ts` /
// `tests/utils/seed.ts` идемпотентно создают их при каждом re-seed.
// Менеджер может переименовать их и завести дополнительные
// подразделения — earnings-helper
// `getCutterCompensationSchemeForDivision` для произвольного `code`
// возвращает безопасный default `B2B_SEWING_PERCENT`, а
// shopfloor-фильтр работает по любому коду через
// `?divisionCode=<code>`.
//
// Soft-delete: `isActive = false` через `PATCH`, hard-delete сознательно
// не делаем. `code` уникален глобально — на него ссылаются и
// `Order.companyDivision`, и helper-ы вроде
// `getCutterCompensationSchemeForDivision`.
//
// Audit: `COMPANY_DIVISION_CREATED` / `COMPANY_DIVISION_UPDATED` под
// `entityType = COMPANY_DIVISION`.
// ---------------------------------------------------------------------------

model CompanyDivision {
  id          String  @id @default(cuid())
  /// Технический slug подразделения — должен быть глобально уникален
  /// (например, `MARKETPLACE`, `OTHER`, `MAIN_SHOP`). Менеджер задаёт
  /// сам; дубль ловится partial-unique индексом в БД и через
  /// `P2002` → `409 COMPANY_DIVISION_CODE_TAKEN`.
  ///
  /// Коды `MARKETPLACE` / `OTHER` создаются миграцией / seed-ом и
  /// используются `EarningsService` для выбора схемы начисления
  /// закройщика (см. `getCutterCompensationSchemeForDivision`).
  /// Менеджер может их переименовывать на уровне `name`, но
  /// переименование `code` сознательно не запрещено схемой —
  /// earnings-helper для незнакомого кода даст безопасный default
  /// `B2B_SEWING_PERCENT`.
  code        String  @unique
  /// Человекочитаемое имя («Маркетплейс», «B2B», «Цех №1»).
  name        String
  description String?
  /// Soft-delete: при отключении менеджер ставит `isActive = false`,
  /// hard-delete сознательно не делаем.
  isActive    Boolean @default(true)
  /// Управленческий порядок в селектах/таблицах. По умолчанию `100`,
  /// чтобы новые карточки попадали в конец списка, не ломая ручной
  /// порядок старых.
  sortOrder   Int     @default(100)

  /// Per-division override флагов блока «Материалы и склад» из
  /// `CompanySettings` (см. `model CompanySettings` выше,
  /// `apps/api/src/modules/company-settings/company-settings.service.ts::getEffectiveMaterialStockSettingsForOrderInTx`,
  /// `docs/current-state.md §«Материалы и склад — division overrides»`).
  ///
  /// Семантика nullable (сознательно без `@default`):
  ///   - `null`  → наследовать глобальный `CompanySettings.<флаг>`;
  ///   - `true`  → принудительно включить для подразделения;
  ///   - `false` → принудительно выключить для подразделения.
  ///
  /// Применяются к: `PassportsService.issueToEmployee`,
  /// `MaterialIssuesService.post` / `createAutoCutIssueForPassport`,
  /// `StockService.createAdjustment` (OUT). `PurchaseReceipt` cancel /
  /// REVERSAL OUT сознательно остаётся permissive и от division
  /// overrides не зависит. Effective policy считается сервисом
  /// `CompanySettingsService.getEffectiveMaterialStockSettingsForOrder`,
  /// который идёт через `Order.companyDivisionId`. Если у заказа нет
  /// division (старые заказы до `link_company_divisions_to_orders` —
  /// FK `onDelete: SetNull`), используется глобальный
  /// `CompanySettings.<флаг>`.
  autoIssueMaterialsOnCutReleaseOverride Boolean?
  allowNegativeMaterialStockOverride     Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Обратные связи. Заказы и display-экраны, привязанные к этому
  /// подразделению. `onDelete: SetNull` со стороны Order /
  /// DisplayScreenConfig — здесь только ради читаемости схемы.
  orders         Order[]
  displayScreens DisplayScreenConfig[]
  /// PHASE 2 STEP 2: сотрудники этого подразделения. `onDelete: SetNull`
  /// со стороны `Employee.companyDivisionId` — снос карточки
  /// подразделения отвязывает сотрудника, а не удаляет его.
  employees      Employee[]

  @@index([isActive])
  @@index([sortOrder])
}

// =========================
// MATERIAL ISSUES (фактический расход материалов по заказу)
// =========================

/// Документ фактического расхода материалов по заказу
/// (см. `apps/api/src/modules/material-issues/*`,
/// `docs/api.md §«Material issues»`,
/// `docs/erd.md §«MaterialIssue / MaterialIssueLine»`).
///
/// Назначение MVP-итерации:
///   - дать менеджеру цеха ручную фиксацию того, сколько материала
///     реально было выдано в крой по заказу (с количеством, ценой,
///     ячейкой и комментарием);
///   - получить аналитический slice «фактический расход × заказ» для
///     отчёта о себестоимости — независимо от плановых строк
///     `WorkshopNeed`;
///   - оставить место для будущей интеграции со складскими остатками
///     (`MaterialStockLot` / `StockMovement` / FIFO/LIFO) — этого в
///     MVP сознательно нет.
///
/// Сознательная граница MVP:
///   - НЕТ складских остатков (`StockBalance` / `MaterialStockLot`
///     не создаются);
///   - НЕТ движений (`StockMovement` не пишется);
///   - НЕТ FIFO/LIFO;
///   - НЕТ автосписания при выдаче кроя
///     (`PassportsService.issueToEmployee` не дёргает этот сервис);
///   - НЕТ master-модели `Material` — описание/единица берутся из
///     `WorkshopNeed` или вводятся текстом;
///   - POSTED-документ в MVP нельзя отменить (см. сервис).
///
/// Жизненный цикл (статусы хранятся как `String`, как и в соседних
/// модулях `WorkshopNeed` / `OrderMaterialArrivalOverride`):
///   - `DRAFT`     — черновик, можно «провести» (POST `/post`) или
///                   отменить (POST `/cancel`).
///   - `POSTED`    — проведён. Менять/отменить нельзя в MVP.
///   - `CANCELLED` — отменён в DRAFT. На статус `POSTED` cancel
///                   не действует.
///
/// Аудит — события `MATERIAL_ISSUE_CREATED` / `MATERIAL_ISSUE_POSTED`
/// / `MATERIAL_ISSUE_CANCELLED` под `entityType = 'MATERIAL_ISSUE'`.
model MaterialIssue {
  id         String  @id @default(cuid())
  orderId    String
  /// Опциональная привязка к производственной партии (паспорту).
  /// На MVP — справочный slice, никаких side-effects на `Passport`
  /// этот модуль не производит.
  passportId String?
  /// `DRAFT` | `POSTED` | `CANCELLED`. Хранится `String` — список
  /// валидируется на API через Zod (`MaterialIssueStatusSchema`),
  /// расширение не требует миграции.
  status     String  @default("DRAFT")
  /// Σ totalCost строк документа — пересчитывается на сервере при
  /// `create` и `post`. Клиент не может задавать значение напрямую
  /// (см. `CreateMaterialIssueDto`).
  totalCost  Decimal @default(0) @db.Decimal(14, 2)

  /// Источник возникновения документа:
  ///   - `MANUAL`         — менеджер создал вручную через
  ///                        `POST /api/material-issues`;
  ///   - `AUTO_CUT_ISSUE` — документ создан автоматически в той же
  ///                        транзакции, что и `PassportsService.issueToEmployee`
  ///                        (автосписание материалов при выдаче кроя
  ///                        сотруднику; см.
  ///                        `apps/api/src/modules/material-issues/material-issues.service.ts::createAutoCutIssueForPassport`,
  ///                        `docs/current-state.md §«Auto cut issue»`).
  ///
  /// Хранится `String`, чтобы расширять список источников (будущие
  /// корректировочные/сторнирующие автодокументы) без Prisma-
  /// миграции. Из frontend DTO не принимается — источник решает
  /// сервис.
  source    String  @default("MANUAL")
  /// Технический ключ идемпотентности для автоматических документов.
  ///   - `null` для `source = MANUAL`;
  ///   - `AUTO_CUT_ISSUE:<passportId>` для `source = AUTO_CUT_ISSUE`.
  ///
  /// UNIQUE-индекс гарантирует, что повторный `issueToEmployee` по
  /// тому же паспорту не создаст второй авто-документ (идемпотентность
  /// при retry). В UI не отображается — это внутренний ключ.
  sourceKey String? @unique

  createdAt   DateTime  @default(now())
  postedAt    DateTime?
  cancelledAt DateTime?

  /// Кто создал/провёл/отменил документ. Без FK на `Employee` —
  /// учётка может быть деактивирована, документ должен уцелеть в
  /// журнале (тот же подход, что у `OrderCutIssueRule.createdById`,
  /// `OrderMaterialArrivalOverride.createdById`).
  createdById   String?
  postedById    String?
  cancelledById String?
  cancelReason  String?

  order    Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  passport Passport?           @relation(fields: [passportId], references: [id], onDelete: SetNull)
  lines    MaterialIssueLine[]

  stockMovements StockMovement[]
  /// Документы возврата / сторно по этому проведённому
  /// `MaterialIssue` (см. `model MaterialIssueReturn` ниже).
  /// Один проведённый расход может иметь несколько возвратов
  /// (на MVP-итерации — только полное сторно остатка, частичные
  /// возвраты подготовлены архитектурно). Cascade — без исходного
  /// расхода возврат теряет смысл.
  returns        MaterialIssueReturn[]

  @@index([orderId])
  @@index([passportId])
  @@index([status])
  @@index([source])
  @@index([createdAt])
}

/// Строка документа фактического расхода материалов
/// (см. `model MaterialIssue` выше).
///
/// Один документ = много строк. Каждая строка фиксирует:
///   - что списано (`description`, опциональный `materialRole`,
///     опциональная привязка к плановой `WorkshopNeed`);
///   - сколько (`issuedQty` × `unit`);
///   - по какой цене (`unitCost` × `totalCost`, считается на сервере);
///   - откуда (`cellId`, опционально — справочный slice, не
///     движение остатков);
///   - произвольный текст (`comment`).
///
/// `description` обязателен:
///   - если `workshopNeedId` передан, сервис подставляет
///     `description` из `WorkshopNeed.description` /
///     `WorkshopNeed.sourceName` (или fallback по ролу);
///   - если `workshopNeedId` не передан, `description` обязан
///     прийти от клиента (вместе с `unit`).
model MaterialIssueLine {
  id              String  @id @default(cuid())
  materialIssueId String
  /// Опциональная ссылка на плановую строку `WorkshopNeed`. Если
  /// заполнена — `description` / `unit` / `materialRole` могут быть
  /// унаследованы из неё в момент создания строки.
  /// `onDelete: SetNull` со стороны связи: удаление `WorkshopNeed`
  /// (через cascade от `Order`) не сносит исторический документ.
  workshopNeedId  String?

  /// Готовое человекочитаемое описание материала на момент списания.
  /// Хранится TEXT — это снимок «как было названо в крой», не FK.
  description  String
  /// Опциональная роль материала (`MAIN_FABRIC`, `RIB`, `LINING`, …).
  /// Свободная строка по тем же соображениям, что
  /// `WorkshopNeed.materialRole`.
  materialRole String?
  /// Единица измерения (`кг`, `м`, `шт`, …). Хранится TEXT.
  unit         String
  /// Сколько фактически списано. Точность 4 знака после запятой —
  /// согласована с `WorkshopNeed.calculatedQty` / `purchaseQty` /
  /// `PurchaseReceiptLine.receivedQty`.
  issuedQty    Decimal @db.Decimal(14, 4)
  /// Цена за единицу. Точность 2 знака — согласована с
  /// `WorkshopNeed.quotedPrice` / `OrderCostEstimateLine.unitPriceRub`.
  /// Валюта на MVP не хранится (расход считаем в рублях по аналогии
  /// с `OrderCostEstimate`).
  unitCost     Decimal @db.Decimal(14, 2)
  /// Производное `issuedQty × unitCost`. Считается на сервере при
  /// `create` и `post` — клиент не может задать значение напрямую.
  totalCost    Decimal @db.Decimal(14, 2)

  /// Опциональная ячейка, откуда выдан материал. Аналитический
  /// slice — НЕ движение остатков. Сохраняется как FK с
  /// `onDelete: SetNull`, чтобы удаление ячейки не сносило документ.
  cellId  String?
  comment String?

  materialIssue MaterialIssue @relation(fields: [materialIssueId], references: [id], onDelete: Cascade)
  workshopNeed  WorkshopNeed? @relation(fields: [workshopNeedId], references: [id], onDelete: SetNull)
  cell          Cell?         @relation(fields: [cellId], references: [id], onDelete: SetNull)

  stockMovements StockMovement[]
  /// Строки возвратов, ссылающиеся на эту `MaterialIssueLine`
  /// (см. `model MaterialIssueReturnLine` ниже). Cascade — если
  /// исходная строка удаляется (через cascade от `MaterialIssue`),
  /// её возвраты тоже теряют смысл.
  returnLines    MaterialIssueReturnLine[]

  @@index([materialIssueId])
  @@index([workshopNeedId])
  @@index([cellId])
}

/// Документ возврата / сторно проведённого `MaterialIssue`
/// (см. `apps/api/src/modules/material-issues/material-issues.service.ts::returnPostedIssue`,
/// `docs/api.md §«Material issues»`, `docs/current-state.md
/// §«Material issue return»`).
///
/// Назначение MVP-итерации:
///   - менеджер цеха возвращает оставшееся количество материала по
///     уже проведённому документу расхода;
///   - исходный `MaterialIssue` НЕ удаляется и НЕ переводится обратно
///     в `DRAFT`. Возврат живёт как отдельный документ, чтобы
///     исторический расход остался в журнале;
///   - на UI MVP — только полное сторно (одна кнопка «Сторнировать»
///     возвращает всё, что ещё не было возвращено). Частичный
///     возврат подготовлен архитектурно: `MaterialIssueReturnLine`
///     умеет хранить произвольный `returnedQty`, но клиентский DTO
///     этого не даёт ввести (одна итерация — одна точка ввода).
///
/// Сознательные границы:
///   - `status = POSTED` всегда (поле оставлено на будущие
///     `DRAFT`/`CANCELLED` итерации и для симметрии с `MaterialIssue`);
///   - удаление возврата не реализовано (`MaterialIssueReturn` без
///     soft/hard delete);
///   - отмена возврата не реализована;
///   - `MaterialStockLot` / FIFO / master `Material` остаются вне
///     scope (как и в исходном `MaterialIssue`);
///   - складское движение — `StockMovement` направления `IN` с
///     `type = REVERSAL` (см. `StockService.recordMaterialIssueReturnInTx`);
///   - финансовая сводка заказа учитывает возвраты как «нетто»:
///     `MaterialIssue.totalCost − Σ MaterialIssueReturn.totalCost`
///     (см. `apps/web/components/orders/summary/build-order-summary-rows.ts`).
model MaterialIssueReturn {
  id String @id @default(cuid())

  /// Исходный проведённый документ расхода. Cascade — без расхода
  /// возврат теряет смысл (если кто-то форсированно удалит
  /// `MaterialIssue`, возвраты тоже сносятся вместе с ним).
  materialIssueId String
  /// Дублируем `orderId` исходного `MaterialIssue` для удобных
  /// фильтров `WHERE orderId = ?` без `JOIN`. Заполняется сервисом
  /// одновременно с `materialIssueId` (`MaterialIssuesService.returnPostedIssue`).
  orderId         String
  /// Дублируем `passportId` исходного `MaterialIssue` (`null`, если
  /// расход order-level). Используется в production-cost agregации
  /// `CostsService` — позволяет вычесть возврат из периода без
  /// JOIN-а на исходный `MaterialIssue`.
  passportId      String?

  /// Жизненный цикл документа возврата. На MVP всегда `POSTED`
  /// (создаётся сразу проведённым). Поле зарезервировано на
  /// будущее: `DRAFT` (черновик возврата с предварительным
  /// расчётом) / `CANCELLED` (откат возврата). Хранится `String`
  /// — расширение списка не требует миграции.
  status    String  @default("POSTED")
  /// Идемпотентный ключ возврата. Защищает от двойного submit
  /// и retry клиентом:
  ///   - `MATERIAL_ISSUE_RETURN_FULL:<materialIssueId>` — для полного
  ///     сторно без `clientRequestId` (одна попытка полного возврата
  ///     на один проведённый расход);
  ///   - `MATERIAL_ISSUE_RETURN:<materialIssueId>:<clientRequestId>` —
  ///     если клиент передал `clientRequestId` в теле запроса
  ///     (рекомендуется для UI-формы — повторный submit формы с тем
  ///     же id вернёт уже созданный возврат вместо дубля).
  ///
  /// `null` — теоретически возможен (для будущих server-to-server
  /// сценариев), но на MVP сервис всегда выставляет ключ. UNIQUE-
  /// индекс — единственная точка защиты от гонок.
  sourceKey String? @unique

  /// Причина возврата. Обязательное поле — UI требует комментарий
  /// (`min 2`, `max 500`), чтобы возвраты в журнале можно было
  /// отличать от автоматических корректировок.
  reason    String
  /// Σ `totalCost` строк возврата. Считается на сервере при создании
  /// (`MaterialIssueReturnLine.returnedQty × MaterialIssueLine.unitCost`).
  /// Финансовый smartcast: `MaterialIssue.totalCost − Σ
  /// MaterialIssueReturn.totalCost` = «нетто факт» по документу
  /// (используется в order summary, plan/fact, production-cost).
  totalCost Decimal @default(0) @db.Decimal(14, 2)

  createdAt   DateTime @default(now())
  /// Кто инициировал возврат. Без FK на `Employee` (тот же подход,
  /// что у `MaterialIssue.createdById` — учётка может быть
  /// деактивирована, документ уцелеет).
  createdById String?

  materialIssue MaterialIssue             @relation(fields: [materialIssueId], references: [id], onDelete: Cascade)
  order         Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  passport      Passport?                 @relation(fields: [passportId], references: [id], onDelete: SetNull)
  lines         MaterialIssueReturnLine[]

  @@index([materialIssueId])
  @@index([orderId])
  @@index([passportId])
  @@index([status])
  @@index([createdAt])
}

/// Строка документа возврата `MaterialIssueReturn`. Отражает,
/// какое количество какой исходной `MaterialIssueLine` возвращено,
/// по какой документной цене и опционально на какую ячейку склада
/// должен быть зачислен возврат.
///
/// На MVP-итерации полного сторно `returnedQty` всегда равен
/// `MaterialIssueLine.issuedQty − Σ ранее возвращённое` (т.е.
/// «остаток»), но поле допускает произвольный положительный
/// Decimal — фундамент под будущий частичный возврат.
///
/// Финансовая стоимость возврата (`unitCost × returnedQty =
/// totalCost`) сознательно использует `MaterialIssueLine.unitCost`,
/// а НЕ текущий складской `StockBalance.unitCost`. Возврат отдаёт
/// в деньги ровно столько, сколько списали по документу — иначе
/// «фактический расход материалов» по заказу будет дрейфовать.
/// Складская стоимость IN-движения берётся отдельно из исходного
/// `StockMovement` OUT (`recordMaterialIssueReturnInTx`).
model MaterialIssueReturnLine {
  id String @id @default(cuid())

  materialIssueReturnId String
  /// Какую исходную строку расхода возвращаем. Cascade — снос
  /// исходной строки (только при cascade от `MaterialIssue`)
  /// сносит её строки возврата вместе.
  materialIssueLineId   String
  /// Snapshot `workshopNeedId` исходной строки (может быть `null`,
  /// если в исходном расходе её не было, например ручной order-level
  /// расход без потребности). `onDelete: SetNull` — удаление
  /// потребности (через cascade от заказа) не сносит документ возврата.
  workshopNeedId        String?

  /// Снапшоты исходной строки на момент возврата. Дублируем, чтобы
  /// возврат мог печататься/отображаться независимо от того, изменили
  /// ли исходную строку расхода (description / unit), и чтобы UI не
  /// делал лишний JOIN. Аналогично `MaterialIssueLine` хранит
  /// snapshot `description` от `WorkshopNeed`.
  description  String
  materialRole String?
  unit         String

  /// Сколько возвращено в этой строке. Точность 4 знака — согласовано
  /// с `MaterialIssueLine.issuedQty`.
  returnedQty Decimal @db.Decimal(14, 4)
  /// Цена единицы возврата = `MaterialIssueLine.unitCost` (snapshot
  /// финансовой оценки исходной строки). Не пересчитывается из
  /// складской цены.
  unitCost    Decimal @db.Decimal(14, 2)
  /// Производное `returnedQty × unitCost`. Считается на сервере при
  /// создании возврата.
  totalCost   Decimal @db.Decimal(14, 2)

  /// Опциональная ячейка зачисления возврата на склад. На MVP сервис
  /// её НЕ заполняет (использует ячейку исходного OUT-движения через
  /// `StockMovement.cellId`), но поле зарезервировано на случай
  /// «возврат на склад в другую ячейку».
  cellId  String?
  /// Опциональный комментарий по строке (на MVP не используется UI —
  /// общий `reason` живёт на уровне документа).
  comment String?

  materialIssueReturn MaterialIssueReturn @relation(fields: [materialIssueReturnId], references: [id], onDelete: Cascade)
  materialIssueLine   MaterialIssueLine   @relation(fields: [materialIssueLineId], references: [id], onDelete: Cascade)
  workshopNeed        WorkshopNeed?       @relation(fields: [workshopNeedId], references: [id], onDelete: SetNull)
  cell                Cell?               @relation(fields: [cellId], references: [id], onDelete: SetNull)

  @@index([materialIssueReturnId])
  @@index([materialIssueLineId])
  @@index([workshopNeedId])
  @@index([cellId])
}

// ---------------------------------------------------------------------------
// Stock foundation (MVP material identity = WorkshopNeed)
//
// Текущий остаток и журнал движений для будущего складского учёта.
// На foundation-итерации бизнес-потоки приёмки / MaterialIssue /
// auto-cut НЕ вызывают эти таблицы. Нет master `Material`, нет партий
// FIFO/LIFO. `balanceKey` устраняет дубли строк при NULL в
// warehouseId/cellId (см. `StockService`, `docs/current-state.md`).
// ---------------------------------------------------------------------------

model StockBalance {
  id         String @id @default(cuid())
  /// Детерминированный ключ `${workshopNeedId}:NO_WAREHOUSE|id:NO_CELL|id`.
  balanceKey String @unique

  workshopNeedId String
  warehouseId    String?
  cellId         String?

  description  String
  materialRole String?
  unit         String

  qty       Decimal @default(0) @db.Decimal(14, 4)
  unitCost  Decimal @default(0) @db.Decimal(14, 2)
  totalCost Decimal @default(0) @db.Decimal(14, 2)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastMovementAt DateTime?

  workshopNeed WorkshopNeed @relation(fields: [workshopNeedId], references: [id], onDelete: Cascade)
  warehouse    Warehouse?   @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  cell         Cell?        @relation(fields: [cellId], references: [id], onDelete: SetNull)

  movements StockMovement[]

  @@index([workshopNeedId])
  @@index([warehouseId])
  @@index([cellId])
  @@index([updatedAt])
}

model StockMovement {
  id String @id @default(cuid())

  stockBalanceId String?
  workshopNeedId String

  type      String
  direction String

  warehouseId String?
  cellId      String?

  qty       Decimal @db.Decimal(14, 4)
  unit      String
  unitCost  Decimal @default(0) @db.Decimal(14, 2)
  totalCost Decimal @default(0) @db.Decimal(14, 2)

  balanceBeforeQty Decimal? @db.Decimal(14, 4)
  balanceAfterQty  Decimal? @db.Decimal(14, 4)

  sourceType String?
  sourceId   String?
  /// Идемпотентный технический ключ движения (см.
  /// `apps/api/src/modules/stock/stock.service.ts`):
  ///   - `PURCHASE_RECEIPT_LINE:<purchaseReceiptLineId>` — приход
  ///     по строке `PurchaseReceiptLine`;
  ///   - `PURCHASE_RECEIPT_LINE_CANCEL:<purchaseReceiptLineId>` —
  ///     обратное движение при отмене этой же строки.
  /// `UNIQUE` гарантирует, что повторная обработка приёмки / её
  /// отмена при retry не создаст дубль `StockMovement` и не
  /// удвоит изменение `StockBalance.qty`.
  sourceKey  String? @unique

  purchaseReceiptId     String?
  purchaseReceiptLineId String?
  materialIssueId       String?
  materialIssueLineId   String?

  comment     String?
  createdById String?
  createdAt   DateTime @default(now())

  stockBalance StockBalance? @relation(fields: [stockBalanceId], references: [id], onDelete: SetNull)
  workshopNeed WorkshopNeed  @relation(fields: [workshopNeedId], references: [id], onDelete: Cascade)
  warehouse    Warehouse?    @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  cell         Cell?         @relation(fields: [cellId], references: [id], onDelete: SetNull)

  purchaseReceipt     PurchaseReceipt?     @relation(fields: [purchaseReceiptId], references: [id], onDelete: SetNull)
  purchaseReceiptLine PurchaseReceiptLine? @relation(fields: [purchaseReceiptLineId], references: [id], onDelete: SetNull)
  materialIssue       MaterialIssue?       @relation(fields: [materialIssueId], references: [id], onDelete: SetNull)
  materialIssueLine   MaterialIssueLine?   @relation(fields: [materialIssueLineId], references: [id], onDelete: SetNull)

  @@index([stockBalanceId])
  @@index([workshopNeedId])
  @@index([type])
  @@index([direction])
  @@index([sourceType, sourceId])
  @@index([purchaseReceiptId])
  @@index([purchaseReceiptLineId])
  @@index([materialIssueId])
  @@index([materialIssueLineId])
  @@index([createdAt])
}

// =========================
// FINISHED GOODS (foundation)
// =========================

/// Foundation остатка готовой продукции (см.
/// `apps/api/src/modules/finished-goods/*`,
/// `docs/current-state.md §«Готовая продукция»`).
///
/// **Отдельный контур от материалов.** `StockBalance` / `StockMovement`
/// под готовую продукцию НЕ используются — материалы и готовые изделия
/// живут в разных таблицах, и выпуск не задевает `MaterialIssue` /
/// `PurchaseReceipt` / `StockAdjustment` / `StockTransfer` /
/// `CostsService` / `ProductionCostV2Service`.
///
/// Идентичность остатка — `(orderId, productId, sizeId, color,
/// warehouseId?, cellId?)`. На MVP `cellId` всегда `null`, склад
/// берётся из `Order.finishedGoodsWarehouseId`. Если склад не выбран,
/// ведём «no-warehouse» баланс (`warehouseId = null`) — упаковку это
/// не блокирует.
///
/// `qty` — целое (штуки): готовые изделия штучные. На MVP единственное
/// движение — `FinishedGoodsMovement` `type = PRODUCTION_RECEIPT`,
/// `direction = IN`, создаётся при первом `Passport.status = PACKED`
/// (idempotent через `sourceKey = PACKED_PASSPORT:<passportId>`).
model FinishedGoodsBalance {
  id String @id @default(cuid())

  /// Детерминированный ключ
  /// `${orderId}:${productId}:${sizeId}:${color}:${warehouseId|NO_WAREHOUSE}:${cellId|NO_CELL}`.
  /// Гарантирует, что у каждой комбинации остаток ровно один.
  balanceKey String @unique

  orderId   String
  productId String
  sizeId    String
  color     String

  warehouseId String?
  cellId      String?

  qty Int @default(0)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastMovementAt DateTime?

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  size      Size       @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  cell      Cell?      @relation(fields: [cellId], references: [id], onDelete: SetNull)

  movements FinishedGoodsMovement[]

  /// Back-relation на строки отгрузки готовой продукции (см.
  /// `model FinishedGoodsShipmentLine`). `onDelete: SetNull` со
  /// стороны строки — если баланс удалили (теоретически только при
  /// удалении заказа cascade-ом), строка отгрузки сохраняет snapshot
  /// product / size / color / warehouse / cell.
  shipmentLines FinishedGoodsShipmentLine[]

  @@index([orderId])
  @@index([productId])
  @@index([sizeId])
  @@index([warehouseId])
  @@index([cellId])
  @@index([updatedAt])
}

/// Foundation журнала движений готовой продукции (см.
/// `apps/api/src/modules/finished-goods/*`).
///
/// На MVP-итерации единственный реализованный type — `PRODUCTION_RECEIPT`
/// (`direction = IN`), создаётся `FinishedGoodsService.recordPackedPassportInTx`
/// в той же транзакции, что и `PassportStatus → PACKED`. Остальные
/// типы (`REVERSAL`, `ADJUSTMENT`, `SHIPMENT`, `TRANSFER`)
/// зарезервированы и появятся в следующих итерациях.
///
/// Идемпотентность — `sourceKey @unique`:
///   - `PACKED_PASSPORT:<passportId>` — выпуск по упаковке паспорта.
/// `sourceKey` сознательно НЕ отдаём в read-only API (внутренний
/// технический ключ).
model FinishedGoodsMovement {
  id String @id @default(cuid())

  finishedGoodsBalanceId String?

  type      String
  direction String

  orderId   String
  productId String
  sizeId    String
  color     String

  warehouseId String?
  cellId      String?

  qty Int

  balanceBeforeQty Int?
  balanceAfterQty  Int?

  sourceType String?
  sourceId   String?
  /// Идемпотентный технический ключ движения. На MVP единственный
  /// формат — `PACKED_PASSPORT:<passportId>`. UNIQUE гарантирует, что
  /// повторная обработка `PACKED` (retry, дубль box-close) не задвоит
  /// движение и не удвоит изменение `FinishedGoodsBalance.qty`.
  sourceKey  String? @unique

  passportId String?
  boxId      String?

  comment     String?
  createdById String?
  createdAt   DateTime @default(now())

  finishedGoodsBalance FinishedGoodsBalance? @relation(fields: [finishedGoodsBalanceId], references: [id], onDelete: SetNull)
  order                Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product              Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  size                 Size                  @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  warehouse            Warehouse?            @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  cell                 Cell?                 @relation(fields: [cellId], references: [id], onDelete: SetNull)
  passport             Passport?             @relation(fields: [passportId], references: [id], onDelete: SetNull)
  box                  Box?                  @relation(fields: [boxId], references: [id], onDelete: SetNull)

  @@index([finishedGoodsBalanceId])
  @@index([orderId])
  @@index([productId])
  @@index([sizeId])
  @@index([type])
  @@index([direction])
  @@index([warehouseId])
  @@index([cellId])
  @@index([passportId])
  @@index([boxId])
  @@index([sourceType, sourceId])
  @@index([createdAt])
}

/// Документ отгрузки готовой продукции (см.
/// `apps/api/src/modules/finished-goods/finished-goods.service.ts::createShipmentForOrder`,
/// `docs/current-state.md §«Отгрузка готовой продукции»`,
/// `docs/api.md §«Finished goods shipments»`).
///
/// Отгрузка — менеджерская акция на карточке заказа: уменьшает
/// `FinishedGoodsBalance.qty` и создаёт `FinishedGoodsMovement`
/// `type = SHIPMENT`, `direction = OUT` по каждой строке (sourceKey
/// `FINISHED_GOODS_SHIPMENT_LINE:<lineId>`). Поддерживает частичную
/// отгрузку: можно отгрузить часть остатка по любому сочетанию
/// product / size / color / warehouse / cell.
///
/// **Отдельный контур от материалов** — `StockBalance` /
/// `StockMovement` / `MaterialIssue` / `PurchaseReceipt` /
/// `StockAdjustment` / `StockTransfer` / `CostsService` /
/// `ProductionCostV2Service` НЕ затрагиваются. Order.status
/// автоматически НЕ меняется.
///
/// Идемпотентность — `sourceKey @unique`
/// (`FINISHED_GOODS_SHIPMENT:<orderId>:<clientRequestId>`):
/// повторный submit формы (двойной клик / network retry) с тем же
/// `clientRequestId` возвращает существующий документ и НЕ создаёт
/// дублирующих движений / списаний.
///
/// На MVP `status` всегда `POSTED` — DRAFT-флоу и cancel/reversal
/// (включая отмену shipment) сознательно не реализованы.
model FinishedGoodsShipment {
  id String @id @default(cuid())

  /// Человеко-читаемый номер документа `S-YYYYMMDD-NNNN` (суточный
  /// счётчик, аналогично `Order.number` / `Box.number`).
  number String @unique

  orderId String
  /// На MVP допустимы два значения: `POSTED` (документ создан, движения
  /// SHIPMENT OUT записаны) и `CANCELLED` (документ отменён целиком,
  /// по каждой строке есть обратное `FinishedGoodsMovement` REVERSAL IN
  /// — sourceKey `FINISHED_GOODS_SHIPMENT_CANCEL_LINE:<lineId>`).
  /// Частичная отмена сознательно не реализована — пользователь
  /// отменяет ошибочный shipment целиком и создаёт новый корректный
  /// частичный shipment (см.
  /// `FinishedGoodsService.cancelShipment`,
  /// `docs/current-state.md §«Отгрузка готовой продукции»`).
  status  String @default("POSTED")

  shippedAt DateTime @default(now())
  comment   String?

  /// Поля отмены отгрузки (см. `cancelShipment` сервиса).
  /// Если `status = CANCELLED`, все три поля заполняются в той же
  /// транзакции, что и `FinishedGoodsMovement` REVERSAL IN. Для
  /// `POSTED`-документа все три остаются `null`.
  cancelledAt   DateTime?
  cancelledById String?
  cancelReason  String?

  /// Идемпотентный технический ключ документа.
  /// `FINISHED_GOODS_SHIPMENT:<orderId>:<clientRequestId>`. UNIQUE +
  /// nullable: если `clientRequestId` не передан, можно создавать без
  /// ключа (но UI-слой всегда генерирует UUID).
  sourceKey String? @unique

  createdAt   DateTime @default(now())
  createdById String?

  order Order                       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lines FinishedGoodsShipmentLine[]

  @@index([orderId])
  @@index([status])
  @@index([shippedAt])
  @@index([createdAt])
  @@index([cancelledAt])
}

/// Строка документа отгрузки готовой продукции (см.
/// `model FinishedGoodsShipment` выше).
///
/// Каждая строка ссылается на конкретный `FinishedGoodsBalance` (или
/// `null`, если баланс впоследствии удалён — `onDelete: SetNull`),
/// фиксирует `productId` / `sizeId` / `color` / `warehouseId` /
/// `cellId` snapshot-ом (на момент отгрузки) и `qty` штук. По каждой
/// строке создаётся ровно один `FinishedGoodsMovement` `type =
/// SHIPMENT`, `direction = OUT` (sourceKey
/// `FINISHED_GOODS_SHIPMENT_LINE:<lineId>`).
model FinishedGoodsShipmentLine {
  id String @id @default(cuid())

  finishedGoodsShipmentId String
  finishedGoodsBalanceId  String?

  orderId   String
  productId String
  sizeId    String
  color     String

  warehouseId String?
  cellId      String?

  qty Int

  comment String?

  shipment             FinishedGoodsShipment @relation(fields: [finishedGoodsShipmentId], references: [id], onDelete: Cascade)
  finishedGoodsBalance FinishedGoodsBalance? @relation(fields: [finishedGoodsBalanceId], references: [id], onDelete: SetNull)
  order                Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product              Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  size                 Size                  @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  warehouse            Warehouse?            @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  cell                 Cell?                 @relation(fields: [cellId], references: [id], onDelete: SetNull)

  @@index([finishedGoodsShipmentId])
  @@index([finishedGoodsBalanceId])
  @@index([orderId])
  @@index([productId])
  @@index([sizeId])
  @@index([warehouseId])
  @@index([cellId])
}

// =========================
// WORK IN PROGRESS (полуфабрикат / крой)
// =========================

/// Foundation учёта полуфабриката — кроя, лежащего в ячейках после
/// раскроя и до момента выдачи в пошив (и обратных движений: возврат
/// в ячейку master-action'ом).
///
/// **Отдельный контур** от материалов (`StockBalance`) и готовой
/// продукции (`FinishedGoodsBalance`). Складская проекция «крой как
/// остаток по ячейке/размеру/заказу/цвету» — для управленческого
/// представления на странице «Склады → Остатки».
///
/// `qty` — целое (штуки): полуфабрикат штучный, единица измерения
/// = единица паспорта (`Passport.qtyCut` при размещении).
///
/// **Единственный источник истины** для «что лежит в ячейках» —
/// после удаления legacy `CellContent` ровно одна запись на каждую
/// уникальную комбинацию `(orderId, productId, sizeId, color,
/// warehouseId, cellId)`. Все consumer'ы (`listCells()` API,
/// `WarehousesService.deleteLine`, `DiagnosticsService`,
/// shelf-placement UI) читают отсюда.
model WorkInProgressBalance {
  id String @id @default(cuid())

  /// Детерминированный ключ
  /// `${orderId}:${productId}:${sizeId}:${color}:${warehouseId|NO_WAREHOUSE}:${cellId|NO_CELL}`.
  /// Гарантирует, что у каждой комбинации остаток ровно один.
  balanceKey String @unique

  orderId   String
  productId String
  sizeId    String
  color     String

  warehouseId String?
  cellId      String?

  qty Int @default(0)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastMovementAt DateTime?

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  size      Size       @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  cell      Cell?      @relation(fields: [cellId], references: [id], onDelete: SetNull)

  movements WorkInProgressMovement[]

  @@index([orderId])
  @@index([productId])
  @@index([sizeId])
  @@index([warehouseId])
  @@index([cellId])
  @@index([updatedAt])
}

/// Foundation журнала движений полуфабриката (см.
/// `apps/api/src/modules/work-in-progress/*`).
///
/// Реализованные types:
///   - `PLACE`            (`IN`)  — `PassportsService.place`
///   - `ISSUE`            (`OUT`) — `PassportsService.issueToEmployee`
///   - `RETURN`           (`IN`)  — `MasterActionsService.returnToCell`
///                                  и `setRouteStep` backward c cell-hint'ом
///   - `DELETE`           (`OUT`) — `PassportsService.delete` если
///                                  паспорт был в ячейке
///   - `PACK_OUT`         (`OUT`) — `PackingService.addPassport` если
///                                  паспорт ушёл в коробку прямо из
///                                  ячейки (defensive, edge-case)
///
/// `ADJUSTMENT` / `TRANSFER` зарезервированы, появятся при необходимости.
///
/// Идемпотентность — `sourceKey @unique`. Формат: `WIP_<TYPE>:<eventId>`,
/// где `eventId` — `PassportEvent.id` для движений с event-trigger'ом
/// или `passportId` для DELETE (паспорт удаляется → ключ уникален).
model WorkInProgressMovement {
  id String @id @default(cuid())

  workInProgressBalanceId String?

  type      String
  direction String

  orderId   String
  productId String
  sizeId    String
  color     String

  warehouseId String?
  cellId      String?

  qty Int

  balanceBeforeQty Int?
  balanceAfterQty  Int?

  sourceType String?
  sourceId   String?
  /// Идемпотентный технический ключ движения. UNIQUE гарантирует, что
  /// повторная обработка того же события (retry, replay) не задвоит
  /// движение и не удвоит `WorkInProgressBalance.qty`.
  sourceKey  String? @unique

  passportId String?

  comment     String?
  createdById String?
  createdAt   DateTime @default(now())

  workInProgressBalance WorkInProgressBalance? @relation(fields: [workInProgressBalanceId], references: [id], onDelete: SetNull)
  order                 Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product               Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  size                  Size                   @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  warehouse             Warehouse?             @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  cell                  Cell?                  @relation(fields: [cellId], references: [id], onDelete: SetNull)
  passport              Passport?              @relation(fields: [passportId], references: [id], onDelete: SetNull)

  @@index([workInProgressBalanceId])
  @@index([orderId])
  @@index([productId])
  @@index([sizeId])
  @@index([type])
  @@index([direction])
  @@index([warehouseId])
  @@index([cellId])
  @@index([passportId])
  @@index([sourceType, sourceId])
  @@index([createdAt])
}
