# -----------------------------------------------------------------------------
# 25-demo2-dev-teeon.conf(.disabled) — точный vhost для https://demo2.dev.teeon.ru
# (тенант demo2 в dev-namespace) с ДОВЕРЕННЫМ cert Let's Encrypt (HTTP-01 :80).
#
# СОСТОЯНИЕ: файл лежит с суффиксом `.disabled`, поэтому nginx его НЕ грузит
# (include /etc/nginx/conf.d/*.conf матчит только .conf). Он активируется
# автоматически скриптом `sewing-enable-demo2-dev.sh`, КОГДА в публичном DNS
# Яндекса появится A-запись для demo2.dev.teeon.ru (или wildcard *.dev.teeon.ru).
# До этого момента поддомен всё равно недоступен снаружи (NXDOMAIN), а vhost
# нельзя включать, т.к. cert ещё не выпущен.
#
# Почему вообще нужен отдельный файл: namespace `*.dev.teeon.ru` НЕ имеет
# публичного wildcard-DNS и НЕ имеет доверенного wildcard-cert (в 22-tenants —
# self-signed). Точный server_name demo2.dev.teeon.ru приоритетнее wildcard →
# именно он отдаст доверенный cert, остальные *.dev.teeon.ru останутся на
# self-signed 22-tenants (без регресса).
#
# Продление: общий cron sewing-cert-renew.sh (certbot renew подхватит и этот
# cert по renewal-conf, webroot :80).
# -----------------------------------------------------------------------------

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name demo2.dev.teeon.ru;

    ssl_certificate     /etc/letsencrypt/live/demo2.dev.teeon.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/demo2.dev.teeon.ru/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        try_files $uri =404;
    }

    location /api/ {
        set $d2d_api sewing-api-1:3001;
        proxy_pass http://$d2d_api;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Request-ID      $rid;
        # Тенант — по Host=$host; клиентский x-tenant-host не доверяем.
        proxy_set_header X-Tenant-Host     "";
        proxy_set_header Connection        "";
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_buffering off;
    }

    location ^~ /uploads/ {
        set $d2d_api_uploads sewing-api-1:3001;
        proxy_pass http://$d2d_api_uploads;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Tenant-Host     "";
        proxy_set_header Connection        "";
        proxy_read_timeout 60s;
        access_log off;
    }

    location / {
        set $d2d_web sewing-web-1:3000;
        proxy_pass http://$d2d_web;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Request-ID      $rid;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_read_timeout 300s;
    }
}
