{
  "name": "sewing",
  "private": true,
  "version": "0.0.0",
  "description": "Система управления швейным производством (MVP)",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "build": "npm run build --workspaces --if-present",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:seed": "prisma db seed --schema=prisma/schema.prisma",
    "db:seed": "prisma db seed --schema=prisma/schema.prisma",
    "db:reset": "prisma migrate reset --schema=prisma/schema.prisma --force",
    "test": "npm run test --workspace=tests",
    "test:smoke": "npm run test:smoke --workspace=tests",
    "test:integration": "npm run test:integration --workspace=tests",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "docs:check": "node scripts/docs/check-docs.mjs",
    "deploy:stage": "bash scripts/deploy-stage.sh",
    "backup:db": "bash scripts/backup-db.sh",
    "cleanup:legacy": "bash scripts/cleanup-legacy-processes.sh"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "prisma": "^5.20.0",
    "ts-loader": "^9.5.7",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
