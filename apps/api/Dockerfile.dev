# Node 20+ — см. apps/api/Dockerfile.prod (engines.node ≥ 20).
FROM node:20-bookworm-slim

WORKDIR /app
RUN apt-get update -y && apt-get install -y openssl ca-certificates && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
COPY apps/api/package*.json ./apps/api/
COPY packages ./packages
COPY prisma ./prisma
COPY apps/api ./apps/api
COPY tsconfig.json ./tsconfig.json

RUN npm ci

# Generate Prisma Client заранее — start:dev не вызывает build,
# а без сгенерированного клиента nest упадёт.
RUN npx prisma generate --schema=prisma/schema.prisma

EXPOSE 3001

# Раньше dev-стек запускал готовый `dist/main.js`. Bind-mount `.:/app`
# подкладывал хостовый `dist`, который мог быть от старого билда — и
# api тихо работал со старым кодом, игнорируя любые правки в src/.
# Теперь стартуем через swc-node watch (`npm run start:dev` →
# `node --watch ... src/main.ts`): любой `Ctrl+S` в `apps/api/src/**`
# или `packages/shared/**` подхватывается без `docker compose build`.
ENTRYPOINT ["sh", "/app/apps/api/scripts/docker-entrypoint.sh"]
CMD ["sh", "-lc", "cd apps/api && npm run start:dev"]
