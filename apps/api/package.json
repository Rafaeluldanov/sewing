{
  "name": "@sewing/api",
  "private": true,
  "version": "0.0.0",
  "description": "NestJS backend — MVP швейного производства.",
  "scripts": {
    "build": "nest build --webpack",
    "start": "node -r tsconfig-paths/register dist/apps/api/src/main.js",
    "start:dev": "node --watch -r ./scripts/dev-preload.cjs -r @swc-node/register -r tsconfig-paths/register src/main.ts",
    "start:prod": "node -r tsconfig-paths/register dist/apps/api/src/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@prisma/client": "^5.20.0",
    "@sewing/shared": "*",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.26",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.5",
    "@types/web-push": "^3.6.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  }
}
